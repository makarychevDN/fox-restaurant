%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogues_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 76c0caf3be1b6134fac28638aa766eea, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 96960955703296
    m_Localized: '*sigh*<pause:1> Another day, another dollar.'
    m_Metadata:
      m_Items: []
  - m_Id: 102732733243392
    m_Localized: Damn,<pause:0.5> this kiddo seems tough,<pause:0.5> he needs at
      least two icecreams.
    m_Metadata:
      m_Items: []
  - m_Id: 102851926974464
    m_Localized: Big boy, huh?<pause:0.75> The bigger they are, the harder they fall.
    m_Metadata:
      m_Items: []
  - m_Id: 102931308371968
    m_Localized: Stupid old junk.
    m_Metadata:
      m_Items: []
  - m_Id: 103157167448064
    m_Localized: Have to clean up the mess.
    m_Metadata:
      m_Items: []
  - m_Id: 103200687546368
    m_Localized: Where is the garbage can?
    m_Metadata:
      m_Items: []
  - m_Id: 103255913947136
    m_Localized: Oh,<pause:0.5> there you are.
    m_Metadata:
      m_Items: []
  - m_Id: 103266819137536
    m_Localized: Shoo,<pause:0.5> small stinkers.
    m_Metadata:
      m_Items: []
  - m_Id: 103795813146624
    m_Localized: Oh,<pause:0.5> wow.<pause:0.5> The first complex order for today.
    m_Metadata:
      m_Items: []
  - m_Id: 103882635239424
    m_Localized: Still too easy though.
    m_Metadata:
      m_Items: []
  - m_Id: 103985789952000
    m_Localized: Need to mix the ingredients.
    m_Metadata:
      m_Items: []
  - m_Id: 104019986112512
    m_Localized: '*sigh*<pause:1> I wonder what it''s like to cook real dishes?'
    m_Metadata:
      m_Items: []
  - m_Id: 104142648532992
    m_Localized: Oh,<pause:0.5> the real game begins.
    m_Metadata:
      m_Items: []
  - m_Id: 104186449649664
    m_Localized: It's easy.<pause:0.5> This thing spawns items,<pause:0.5> I use
      them.
    m_Metadata:
      m_Items: []
  - m_Id: 104222092845056
    m_Localized: The main thing is to keep it from clogging up.
    m_Metadata:
      m_Items: []
  - m_Id: 104300811542528
    m_Localized: '*sigh*<pause:1> Everyday in the same time.'
    m_Metadata:
      m_Items: []
  - m_Id: 104452712456192
    m_Localized: 'Oh,<pause: 0.5> it''s you again, Red <pause:0.5>NOT<pause:0.5>
      a Cook.'
    m_Metadata:
      m_Items: []
  - m_Id: 104546270601216
    m_Localized: 'Yarrr,<pause: 0.5> welcome aboard, young sailor.'
    m_Metadata:
      m_Items: []
  - m_Id: 104596988125184
    m_Localized: I don't need your greetings, Red <pause:0.5>NOT<pause:0.5> a Cook.
    m_Metadata:
      m_Items: []
  - m_Id: 104702047051776
    m_Localized: I need you to work faster, not louder.
    m_Metadata:
      m_Items: []
  - m_Id: 104734192197632
    m_Localized: Do you know that this is a restaurant for kids?
    m_Metadata:
      m_Items: []
  - m_Id: 104799568814080
    m_Localized: Pfft.<pause:0.5> This place is full of pirates.
    m_Metadata:
      m_Items: []
  - m_Id: 104851519463424
    m_Localized: Pirates are too scary for them,<pause:0.5> so <pause:0.5>YEAH,<pause:0.5>
      it's clearly for adults.
    m_Metadata:
      m_Items: []
  - m_Id: 104919387496448
    m_Localized: At least you are not too old for this.
    m_Metadata:
      m_Items: []
  - m_Id: 105019983683584
    m_Localized: I'm at the perfect age for this place, so, <pause:0.5>YEAH.
    m_Metadata:
      m_Items: []
  - m_Id: 105266793308160
    m_Localized: And I need some calories to be in the perfect shape.<pause:0.5>
      So, hurry up, Red <pause:0.5>NOT<pause:0.5> a Cook.
    m_Metadata:
      m_Items: []
  - m_Id: 105471504703488
    m_Localized: 'Pfft.<pause: 0.5> If you''ve done it doesn''t meen you''ve done
      it well,<pause: 0.5> Red <pause:0.5>NOT<pause:0.5> a cook.'
    m_Metadata:
      m_Items: []
  - m_Id: 105543625760768
    m_Localized: 'Yarrr,<pause: 0.5> we hope to see you again soon, young sailor.'
    m_Metadata:
      m_Items: []
  - m_Id: 105608289345536
    m_Localized: 'Oh, <pause:0.5>YEAH, <pause:0.5>do<pause: 0.5> NOT<pause: 0.5>
      hesitate.<pause:1> You will see me soon.'
    m_Metadata:
      m_Items: []
  - m_Id: 105693555351552
    m_Localized: And I won't be so easy on you next time.
    m_Metadata:
      m_Items: []
  - m_Id: 105789357449216
    m_Localized: See you later, Red <pause:0.5>NOT<pause:0.5> a cook.
    m_Metadata:
      m_Items: []
  - m_Id: 107592824283136
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Finally.
    m_Metadata:
      m_Items: []
  - m_Id: 107662542004224
    m_Localized: Whoa,<pause:0.5> break time already.
    m_Metadata:
      m_Items: []
  - m_Id: 131328193486848
    m_Localized: Damn...<pause:1> Ok, let's try again.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674043346944
    m_Localized: Finally, a moment of peace.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124160
    m_Localized: Yarr! <pause:0.75> Well then, swabbie, did you think your first
      day would be smooth sailing?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124161
    m_Localized: I've been working here for over a year.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124162
    m_Localized: Yarr! <pause:0.75> I couldn't make head nor tail of that!<pause:0.75>
      You sound like a landlubber!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124163
    m_Localized: I don't want to talk like that when I'm not at the register.<pause:0.75>
      It's<pause:0.5> ridiculous.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124164
    m_Localized: We're not pirates in real life.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124165
    m_Localized: <volume:0>...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124166
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> *sigh*
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124167
    m_Localized: Yarr!<pause:0.75> Captain,<pause:0.75> I've been on this voyage
      for over a year!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124168
    m_Localized: <volume:1>Yarr!<pause:0.75> That's more like it!<pause:0.75> Keep
      that up and the treasure won't be long in coming!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124169
    m_Localized: Speaking of treasure.<pause:0.75> I actually wanted to discuss my
      promotion and ...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124170
    m_Localized: And cheer up, sailor!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124171
    m_Localized: I don't know what happened to you on shore.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124172
    m_Localized: But if you keep walking around looking that grumpy, you'll scare
      off all my customers!<pause:0.75> Yarr!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124173
    m_Localized: It's just...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124174
    m_Localized: ...my face.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124175
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Deaf mutt.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124176
    m_Localized: Already?!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124177
    m_Localized: I swear, the breaks get shorter every day!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124178
    m_Localized: I'll show him.<pause:1> I'll show all of them.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124179
    m_Localized: I'll open my own restaurant,<pause:0.5> hire every last one of them,<pause:0.5>
      and then give them the shortest breaks imaginable.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124180
    m_Localized: And I'll give myself an outrageously long break!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124181
    m_Localized: But I won't even want to use it, that's how amazing my place will
      be!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124182
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> On second
      thought, maybe I should make it slightly less amazing.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124183
    m_Localized: Otherwise they won't want to take their breaks at all.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124184
    m_Localized: Oh,<pause:0.75> it's her again.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124185
    m_Localized: She needs a special approach.<pause:0.75> She looks at what others
      are eating and orders the same thing.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124186
    m_Localized: The poor thing tends to doubt.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124187
    m_Localized: There we go.<pause:0.75> Ice cream for everyone!<pause:0.75> And
      I didn't even break a sweat!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124188
    m_Localized: <volume:0>...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124189
    m_Localized: Yarr,<pause:0.75> is everything alright, young sailor?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124190
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> I just
      wanted to say thank you!<pause:0.5> You were very patient.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124191
    m_Localized: Usually adults swear when I doubt a lot.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124192
    m_Localized: Yarr,<pause:0.5> don't you worry, young sailor,<pause:0.5> and come
      back anytime!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124193
    m_Localized: You're awesome!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124194
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Hm,<pause:0.75>
      maybe this day<pause:0.75> isn't so bad after all.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124195
    m_Localized: Hey,<pause:0.5> Red,<pause:0.5> come on,<pause:0.5> we need to talk.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124196
    m_Localized: Hi, Red.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124197
    m_Localized: Hi, Stan.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124198
    m_Localized: My eyes are lower.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124199
    m_Localized: Oh.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124200
    m_Localized: Yeah,<pause:0.75> that's better.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124201
    m_Localized: So what did you want?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124202
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> I have
      to go out into the dining area in a minute.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124203
    m_Localized: What?!<pause:0.75> No!<pause:0.75> I object!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124204
    m_Localized: The Captain said he'd have me fed to the fish<pause:0.5> if I don't
      do it.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124205
    m_Localized: I'm not entirely sure what that means in plain English,<pause:0.5>
      but I'm certain it's nothing good.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124206
    m_Localized: But the kids go crazy for Peg-Leg Joe!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124207
    m_Localized: They'll tear this place apart if they see you in the costume!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124208
    m_Localized: I won't be able to handle that many customers!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124209
    m_Localized: We need at least three people on the register to keep up!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124210
    m_Localized: And I'm on my own today!<pause:0.75> Remember what happened last
      time!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124211
    m_Localized: I know.<pause:0.75> That's why I came to talk it through.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124212
    m_Localized: So,<pause:0.5> do you actually have a plan?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124213
    m_Localized: Yes,<pause:0.5> movie night.<pause:0.5> You draw the curtains,<pause:0.5>
      turn on the projector,<pause:0.5> and I'll make sure everyone keeps it down.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124214
    m_Localized: Movie night, huh.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124215
    m_Localized: That means I'll have to take on the evening menu with the cocktails.<pause:0.75>
      That won't be easy.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124216
    m_Localized: Still easier than if all the kids from all over the neighborhood
      come running here at once.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124217
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Yeah,<pause:0.5>
      you're right.<pause:0.75> You're a genius, Stan.<pause:0.75> Let's do it.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124218
    m_Localized: Deal.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124219
    m_Localized: Alright,<pause:0.75> let's try this.<pause:1> 3,<pause:1> 2<pause:1>
      1.<pause:1> Go!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124220
    m_Localized: Oh my gosh,<pause:0.4> it's Peg-Leg Joe!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124221
    m_Localized: Yay,<pause:0.4> Peg-Leg Joe!<pause:0.4> Give me a ride!!!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124222
    m_Localized: Me too!!!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124223
    m_Localized: Yarr!<pause:0.75> Peg-Leg Joe isn't feeling his best today,<pause:0.4>
      so we're going to keep it quiet.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318464
    m_Localized: Aww,<pause:0.75> that's not fair!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318465
    m_Localized: I thought we were going to have fun.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318466
    m_Localized: Don't worry, young sailor,<pause:0.75> we don't have to be loud
      to have fun!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318467
    m_Localized: For example,<pause:0.75> we could watch a cartoon!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318468
    m_Localized: Cartoons are good.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318469
    m_Localized: Only if it's interesting!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318470
    m_Localized: I hope<pause:0.5> there's a starfish in it...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318471
    m_Localized: Yarr,<pause:0.75> of course it's interesting!<pause:0.75> But we'll
      be watching it quietly.<pause:0.5> Deal, young sailors?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318472
    m_Localized: Deal!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318473
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> It worked!<pause:0.75>
      No crowd showed up!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318474
    m_Localized: Told you!<pause:0.75> A foolproof plan!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318475
    m_Localized: Now there's only one thing left.<pause:0.75> Back to work!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318476
    m_Localized: Phew,<pause:0.5> young sailors,<pause:0.5> who else wants some ice
      cream?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318477
    m_Localized: <volume:0>...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318478
    m_Localized: Looks like<pause:0.5> you already handled everything.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318479
    m_Localized: Could you please keep it down?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318480
    m_Localized: <volume:1>We're trying to watch.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318481
    m_Localized: Oh,<pause:0.5> sorry.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318482
    m_Localized: Oh, come on!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318483
    m_Localized: Hey,<pause:0.5> we weren't done watching!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318484
    m_Localized: <volume:0.5>Yarr!<pause:0.5> What do you think you're doing here,
      swabbies?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318485
    m_Localized: I told you to send out Peg-Leg Joe, not for you to hang around here!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318486
    m_Localized: <emote:shake><volume:1>Hey,<pause:0.5><emote:shake> young sailors,<pause:0.5><emote:shake>
      Peg-Leg Joe has been hiding here this whole time!<pause:0.5><emote:shake> Get
      in here,<pause:0.5><emote:shake> show him how much you love him!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318487
    m_Localized: <volume:0.5>Forward, swabbies,<pause:0.75> bring me all the treasures
      in the world!<pause:0.75> Hahahahaha!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318488
    m_Localized: It's Peg-Leg Joe!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318489
    m_Localized: Run to him!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318490
    m_Localized: Oh no.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318491
    m_Localized: '*sigh* <pause:1> Home.'
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318492
    m_Localized: Huh?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318493
    m_Localized: What the...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318494
    m_Localized: Silver
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318495
    m_Localized: If you go out without a hat, I'm telling Mom
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318496
    m_Localized: DON'T
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318497
    m_Localized: new message
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318498
    m_Localized: Come to the kitchen
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318499
    m_Localized: Hey there!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318500
    m_Localized: You do realize you can't just break into my place like that?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318501
    m_Localized: It was unlocked.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318502
    m_Localized: And why are you sitting here in the dark?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318503
    m_Localized: I'm feeling playful.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318504
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318505
    m_Localized: Oh,<pause:0.5> don't act like you're not happy to see me.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318506
    m_Localized: I am.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318507
    m_Localized: So.<pause:0.75> Why are you here?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318508
    m_Localized: Can't I just drop by to check on my little brother?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318509
    m_Localized: You can,<pause:0.75> but you don't.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318510
    m_Localized: Wow. Is that really how little you think of me?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318511
    m_Localized: Alright,<pause:0.75> you got me.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318512
    m_Localized: I'm not here for no reason.<pause:0.75> I have a proposition for
      you.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318513
    m_Localized: NO!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318514
    m_Localized: You didn't even hear me out.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318515
    m_Localized: NO!<pause:0.75> I'm out of the game!<pause:0.75> I'm just a regular
      cook now, remember?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318516
    m_Localized: You're serving ice cream at a children's restaurant.<pause:0.75>
      You're not a cook.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318517
    m_Localized: I practice a lot at home!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318518
    m_Localized: And I know you're good.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318519
    m_Localized: But being a cook isn't a hobby,<pause:0.75> it's a profession.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318520
    m_Localized: Did you come here just to insult me?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512768
    m_Localized: I actually came to help you with that.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512769
    m_Localized: First of all, I don't like the sound of that.<pause:0.75> And second,
      you don't understand anything about cooking.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512770
    m_Localized: Maybe not.<pause:0.75> But I do understand that you're going about
      your goal the wrong way.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512771
    m_Localized: Red,<pause:0.75> you're not keeping up.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512772
    m_Localized: Worse,<pause:0.75> what you're going through isn't bringing you
      closer to your goal.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512773
    m_Localized: It's pushing you further away.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512774
    m_Localized: No, it's not!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512775
    m_Localized: Take a look at this!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512776
    m_Localized: Behold!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512777
    m_Localized: my goal
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512778
    m_Localized: See?<pause:0.5> I'm already halfway there!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512779
    m_Localized: I don't drag myself to that damn job day after day for nothing!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512780
    m_Localized: Every month, there's more and more money in the jar!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512781
    m_Localized: And when I fill this up, I'll open a restaurant where I serve the
      best dishes around!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512782
    m_Localized: And the staff will get outrageously long breaks!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512783
    m_Localized: But working there will be so amazing no one will even want to take
      them!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512784
    m_Localized: And no one will ever say Red isn't a real cook!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512785
    m_Localized: No one!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512786
    m_Localized: Oh, you grumpy little cupcake
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512787
    m_Localized: I'm not arguing that you work hard.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512788
    m_Localized: It's opposite.<pause:0.5> You've buried yourself in cooking so deep
      you forgot to keep your eyes open.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512789
    m_Localized: Red,<pause:0.5> how long ago did you set this goal?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512790
    m_Localized: A year and a half ago.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512791
    m_Localized: Have you seen how much prices have gone up since then?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512792
    m_Localized: Well, prices always go up a little.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512793
    m_Localized: Just look at how much that equipment you liked back then costs now.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512794
    m_Localized: Oh come on,<pause:0.5> it can't be that bad.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512795
    m_Localized: I'm sure you could move mountains with that stubbornness of yours.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512796
    m_Localized: But if you keep going like this, you'll drift even further from
      your goal.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512797
    m_Localized: Things are getting more expensive faster than you're earning.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512798
    m_Localized: So what am I supposed to do?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512799
    m_Localized: Take action.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512800
    m_Localized: This still isn't enough to cover your whole vision.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512801
    m_Localized: But it's decent starting capital for something more modest.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512802
    m_Localized: For example,<pause:0.75> a small restaurant in a smaller town.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512803
    m_Localized: I've already scoped out a promising spot.<pause:0.75> Our money
      would cover the down payment.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512804
    m_Localized: Down payment?<pause:0.75> A loan sounds pretty<pause:0.5> risky.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512805
    m_Localized: Of course,<pause:0.75> but you know how it works.<pause:0.75> No
      risk, no reward.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512806
    m_Localized: Actually, you know what?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512807
    m_Localized: You're right!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512808
    m_Localized: Heck the ice cream restaurant!<pause:0.75> Heck all of them!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512809
    m_Localized: If I have to talk like a pirate for one more day, I'll lose my mind!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512810
    m_Localized: Now that's the spirit!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512811
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> And what's
      in it for you?<pause:0.75> Why help me?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512812
    m_Localized: Well,<pause:0.75> first of all,<pause:0.75> because I worry about
      my little brother.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512813
    m_Localized: Who would absolutely get himself into trouble without me.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512814
    m_Localized: And second, I want a share.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707072
    m_Localized: I don't believe you!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707073
    m_Localized: You can practically make money out of thin air!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707074
    m_Localized: Why would you want a stake in some random restaurant?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707075
    m_Localized: Oh, did you really think I'd never grow up?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707076
    m_Localized: That I wouldn't want to settle down?<pause:0.75> Have a legitimate
      source of income?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707077
    m_Localized: You're hurting my feelings.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707078
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707079
    m_Localized: What?<pause:0.75> Do you really think I'm trying to trick you?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707080
    m_Localized: How many times have I ever tried to hurt you?<pause:0.75> Rob you?<pause:0.75>
      Set you up?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707081
    m_Localized: Not once.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707082
    m_Localized: Then what are you waiting for?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707083
    m_Localized: Partners?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707084
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Alright,<pause:0.75>
      partners!
    m_Metadata:
      m_Items: []
  - m_Id: 39890501168685056
    m_Localized: And their incredible adventure has begun!
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377408
    m_Localized: It's enough to take care of most of them.
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377409
    m_Localized: This gizmo shows how many more customers I need to satisfy.
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377410
    m_Localized: Oh boy.<pause:0.5> So many kids showed up that they couldn't all
      fit inside.
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377411
    m_Localized: Some of them are waiting for a spot to open up before they can place
      an order.
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377412
    m_Localized: This thing shows who's next in line.
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377413
    m_Localized: Sometimes it helps to stall for time,<pause:0.5> but don't push
      it too far.
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377414
    m_Localized: The customers in line have patience too.
    m_Metadata:
      m_Items: []
  - m_Id: 76866541631725568
    m_Localized: Usually, I don't have to serve every single customer.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020216782848
    m_Localized: Wow, what a trip.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948672
    m_Localized: So, where are we now?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948673
    m_Localized: Somewhere not too far from Clifford.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948674
    m_Localized: The signal's really bad out here.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948675
    m_Localized: So we'll have to improvise from here.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948676
    m_Localized: Catch another bus<pause:0.5> or ask the locals for directions.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948677
    m_Localized: <volume:0>...
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948678
    m_Localized: <volume:1>Though<pause:1> that might be a bit of a problem.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948679
    m_Localized: Are we lost?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948680
    m_Localized: Oh, don't be so dramatic.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948681
    m_Localized: Worst case, we wait here for the next bus and head back.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948682
    m_Localized: No way!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948685
    m_Localized: To find that stupid little town.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948686
    m_Localized: And when I get there, I'm gonna cook an outrageous amount of spaghetti!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948687
    m_Localized: And the locals are gonna have to eat every last bit of it!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948688
    m_Localized: And they will love it!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948689
    m_Localized: '!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948691
    m_Localized: Oh.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948692
    m_Localized: It says Clifford's just down this trail.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948693
    m_Localized: So what are we waiting for?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948694
    m_Localized: Tremble, people of Clifford!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948695
    m_Localized: Red is coming!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948696
    m_Localized: And the great and terrible Red isn't scared of a creepy forest like
      this?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948697
    m_Localized: A little.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948698
    m_Localized: But it's not as scary as turning back!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948699
    m_Localized: I'm sure<pause:0.75> it's not as bad as it looks.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948700
    m_Localized: One last push, and we'll be relaxing in Clifford after the trip.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948701
    m_Localized: And sipping cocktails with little umbrellas?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948702
    m_Localized: And sipping cocktails with little umbrellas.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948703
    m_Localized: Sweet.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948704
    m_Localized: When did you change your hat?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948705
    m_Localized: When our road trip turned into a hike, dummy.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948706
    m_Localized: Look.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948707
    m_Localized: I think we made it.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948709
    m_Localized: Damn.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948710
    m_Localized: Hey,<pause:0.75> look on the bright side. At least we're not lost
      anymore!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948711
    m_Localized: And would you look at that!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948712
    m_Localized: A local!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948713
    m_Localized: Hi there.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948714
    m_Localized: AAAH!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948716
    m_Localized: We're doomed!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948718
    m_Localized: Don't move, forest monster!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948719
    m_Localized: Yeah,<pause:0.5> definitely you.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948720
    m_Localized: Silence, you filthy Clifforder!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948721
    m_Localized: First you brought disease upon us!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948723
    m_Localized: We won't let that happen!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948724
    m_Localized: I think there's been a huge misunderstanding.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948725
    m_Localized: We're not from Clifford.<pause:0.5> We were actually just about
      to leave.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948726
    m_Localized: You're not getting away that easily after everything you've done!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142976
    m_Localized: Uh-oh.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142977
    m_Localized: Alright,<pause:0.5> break it up.<pause:0.5> Nothing to see here.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142978
    m_Localized: These two are coming with me.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142979
    m_Localized: But they're from Clifford!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142980
    m_Localized: Where they're from is none of your concern.<pause:0.75> You've still
      got plenty of work to do today!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142981
    m_Localized: All of you!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142982
    m_Localized: But!..
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142983
    m_Localized: No buts!<pause:0.75> Hasn't anyone put a curse on you in a while?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142984
    m_Localized: Tch!<pause:0.5> Witch!<pause:0.5> Come on,<pause:0.5> the hag's
      found herself a new pair of toys.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142985
    m_Localized: WHO ARE YOU CALLING A HAG, YOU PEST?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142986
    m_Localized: Yikes!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142987
    m_Localized: <volume:1>*sigh*<pause:0.75> Follow me,<pause:0.5> before they change
      their minds.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142988
    m_Localized: Your place is so cozy!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142989
    m_Localized: What's all this stuff on the shelves?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142990
    m_Localized: Don't touch the antiques.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142991
    m_Localized: Wasn't planning to.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142992
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142993
    m_Localized: Thank you for standing up for us.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142994
    m_Localized: Yeah,<pause:0.5> if it weren't for you, they would've eaten us alive.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142995
    m_Localized: '*sigh*<pause:0.5> They wouldn''t have eaten anyone,<pause:0.5>
      they''re not monsters.'
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142996
    m_Localized: They're just on edge.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142997
    m_Localized: Most likely, they would've just chased you out of Riverside.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142998
    m_Localized: Worst case, they would've shouted a few nasty things after you.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142999
    m_Localized: Actually, it suits us.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143000
    m_Localized: We were just passing through anyway. We weren't planning to stick
      around this godforsaken...
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143001
    m_Localized: What a shame.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143002
    m_Localized: We'd hate to leave such a lovely place in such a hurry.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143004
    m_Localized: You'd better listen to your elders, orange one.<pause:0.75> People
      value that around here.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143005
    m_Localized: And you shouldn't be in such a rush anyway.<pause:0.5> The road
      ahead is even tougher than the one that brought you here.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143006
    m_Localized: Am I right in assuming you're headed for Clifford?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143007
    m_Localized: Yes, ma'am!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143008
    m_Localized: Strange choice, but that's your business.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143009
    m_Localized: Our cart horse already left for Clifford to pick up medicine. He
      won't be back until late tonight.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143010
    m_Localized: The next trip to town is tomorrow morning.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143011
    m_Localized: So until then, we'd better stay put and keep a low profile?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143013
    m_Localized: Perfect!<pause:0.75> Then we'll sit here quietly and stay out of
      everyone's way.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143014
    m_Localized: Smart little fox.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143015
    m_Localized: They are waiting for medicines from the city.<pause:0.5> Are they
      sick?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143016
    m_Localized: Yep.<pause:0.75> Those scatterbrains managed to catch some kind
      of illness, and now half the village's come down with it.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143017
    m_Localized: That's why they're so afraid.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143018
    m_Localized: They think it's some evil spirit, or the people of Clifford are
      behind it.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143019
    m_Localized: Or both.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143020
    m_Localized: Actually,<pause:0.5> we could help.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143021
    m_Localized: Red,<pause:0.5> you've got a lot of talents,<pause:0.5> but you're
      not a doctor.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143022
    m_Localized: And besides, we're not exactly welcome here.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143023
    m_Localized: No, no, gray one.<pause:0.5> Let him finish.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143024
    m_Localized: So, what exactly are you proposing, orange one?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143025
    m_Localized: You've got all sorts of herbs here,<pause:0.5> and I've got a whole
      bunch of cooking gear with me!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143026
    m_Localized: And I know the recipe for good health!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143027
    m_Localized: We can make the tastiest, most healing chicken soup this village's
      ever had!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143028
    m_Localized: That's...<pause:1> actually a pretty good idea.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143029
    m_Localized: A good bowl of soup really should help them feel better.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143030
    m_Localized: I'll see if I can convince the locals to put up with you a little
      longer.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143031
    m_Localized: Well,<pause:0.5> since we're already involved, I can help with the
      herbs.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143032
    m_Localized: Do you know anything about herbs?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143033
    m_Localized: Our mom's really into floristry, so she taught me a thing or two.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143034
    m_Localized: I don't know what they're used for medicinally, but I do know how
      to gather them.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143035
    m_Localized: And I can follow instructions without getting in the way.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143036
    m_Localized: That'll do.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143037
    m_Localized: And since we're working together now, and I won't be able to ignore
      you anymore, we should introduce ourselves.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143038
    m_Localized: Adele.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143039
    m_Localized: Silver.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143040
    m_Localized: Red.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143041
    m_Localized: How original.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143042
    m_Localized: Oh,<pause:0.5> trust me,<pause:0.5> it could've been much worse.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143043
    m_Localized: What was that?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143044
    m_Localized: Don't worry about it.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143045
    m_Localized: Come on, Red and Silver,<pause:0.5> we've still got plenty of work
      to do.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143046
    m_Localized: Alright,<pause:0.5> all our ingredients and herbs are at your disposal.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143047
    m_Localized: Don't make me regret this, orange one.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143048
    m_Localized: I've got this.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143049
    m_Localized: Making medicinal soup can't be that much harder than cooking regular
      food.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143050
    m_Localized: I certainly hope you're right.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143051
    m_Localized: I'm about to give those germs such a beating,<pause:0.5> they won't
      know what hit 'em.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143052
    m_Localized: Hey, this isn't so hard.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143053
    m_Localized: Don't celebrate too soon, orange one.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143054
    m_Localized: Everyone who's come to you so far isn't really sick yet.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143055
    m_Localized: They're just feeling a little under the weather.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143056
    m_Localized: I've brought you your first real patient.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143057
    m_Localized: Send them in.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143058
    m_Localized: I'm<pause:0.75> not eating Leshy's poison!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143059
    m_Localized: I'm not Leshy.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143060
    m_Localized: And I'm not listening to him either!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143061
    m_Localized: '*sigh*<pause:0.75> You will if you want to get better.'
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143062
    m_Localized: Then I choose to stay sick!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143063
    m_Localized: No,<pause:0.5> you choose to get better, you<pause:0.5> ungrateful
      jackass.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143064
    m_Localized: And that's not a request.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143065
    m_Localized: Good. Then keep your mouth shut.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143066
    m_Localized: Don't pay any attention to the nonsense this idiot says.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143067
    m_Localized: He's been burning up with a fever since yesterday.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143068
    m_Localized: And with his illness, he spoils the lives of everyone around him.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143069
    m_Localized: Anyone sitting next to him will be harder to cure.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143070
    m_Localized: Show me what you've got, orange one.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143071
    m_Localized: Whoa!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143072
    m_Localized: Sick customers really are a pain to deal with.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143073
    m_Localized: Damn,<pause:0.5> that wasn't easy.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143074
    m_Localized: Told you so.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143075
    m_Localized: But fever's one of the easier illnesses to treat.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143076
    m_Localized: The mushroom mix contains rowan berries. They should help him feel
      better.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143077
    m_Localized: Give it a try.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143078
    m_Localized: Alright,<pause:0.5> I think<pause:0.5> I'm starting to get it.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143079
    m_Localized: Good,<pause:0.5> because I don't intend to babysit you all day.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143080
    m_Localized: Call me if something goes wrong.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143081
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> No, this
      is just ridiculous!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143082
    m_Localized: I can't work under these conditions.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143083
    m_Localized: This patient of yours is the most stubborn mule in the world!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143084
    m_Localized: It's just impossible!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143085
    m_Localized: Sometimes I think he asks for anything except what he actually needs
      just to be difficult.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143086
    m_Localized: Adele,<pause:0.5> I need you to yell at him.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143087
    m_Localized: Now that's a brilliant idea.<pause:0.5> Anything else?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143088
    m_Localized: I want you to hit him.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143089
    m_Localized: Listen here, orange one.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143090
    m_Localized: Vasya is a tough nut to crack,<pause:0.5> he's not easy.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143091
    m_Localized: But your brother and I already have our hands full.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143092
    m_Localized: We won't get very far if I have to help you with every difficult
      patient.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143093
    m_Localized: I have my own work,<pause:0.5> and you have yours.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143094
    m_Localized: So go and handle it.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143095
    m_Localized: Hey,<pause:0.5> I'm the one saving your village from an epidemic
      here!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143096
    m_Localized: I could've done exactly what you told me!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143097
    m_Localized: Sit quietly in a corner,<pause:0.5> while the locals wait for medicine
      from the city and keep getting sicker!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143098
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Alright,
      alright,<pause:0.5> you're right,<pause:0.5> I'm sorry.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143099
    m_Localized: But I really can't drop my work and keep running back and forth.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143100
    m_Localized: Then tell me how else I'm supposed to get through to him.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337280
    m_Localized: What is this old wreck?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337281
    m_Localized: This is an oven.<pause:0.5> You know how to use one of these, right?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337282
    m_Localized: Yeah, I do,<pause:0.5> but how is this supposed to help?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337283
    m_Localized: It has the gift of persuasion.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337284
    m_Localized: If someone tastes its baked goods, they'll immediately change their
      mind, no matter what the argument was about.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337285
    m_Localized: What?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337286
    m_Localized: If you just wanted to get rid of me, you could've said so.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337287
    m_Localized: I promise it'll work.<pause:0.5> Now go,<pause:0.5> your patients
      are waiting.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337288
    m_Localized: Hopefully this isn't some kind of cruel joke.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337289
    m_Localized: He's doing it again.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337290
    m_Localized: Alright,<pause:0.5> this time I'll give him a pretzel.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337291
    m_Localized: And he'll magically change his mind.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337292
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> That sounded
      so silly.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337293
    m_Localized: Well, I'll be damned.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337294
    m_Localized: It actually works!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337295
    m_Localized: Whoa.<pause:0.5> This piggy is really impatient.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337296
    m_Localized: To serve him in time, I'll have to fire up the oven.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337297
    m_Localized: Yeah,<pause:0.5> this should work.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337298
    m_Localized: With this oven, I'm not afraid of anyone!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337299
    m_Localized: I'm unstoppable!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337300
    m_Localized: What the heck is that?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337301
    m_Localized: Well,<pause:0.5> whatever all that noise is about, it's not my problem.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337302
    m_Localized: Especially when I'm on a break.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337303
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Now.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337304
    m_Localized: Do you think this counts as a remedy?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337305
    m_Localized: Probably not.<pause:0.5> It's just soup with herbs.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337306
    m_Localized: Yeah,<pause:0.5> but then what even counts as a remedy if not soup
      with herbs?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337307
    m_Localized: Hmm,<pause:0.5> that's<pause:0.75> a very interesting observation.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337308
    m_Localized: The apprentice potion maker has surpassed his master!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337309
    m_Localized: Focus!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337310
    m_Localized: Oh, come on,<pause:0.5> it was funny!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337311
    m_Localized: The kitchen is no place for fooling around!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337312
    m_Localized: This is our workshop, and we're creating great things here!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337313
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> It was
      still funny though.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337314
    m_Localized: Fine,<pause:0.5> it was a little funny.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337315
    m_Localized: A small victory!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337316
    m_Localized: You're a scallywag!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337317
    m_Localized: Did you hear that?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337318
    m_Localized: This isn't some kind of medicine for illnesses,<pause:0.5> it's
      just ordinary soup!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337319
    m_Localized: Well, I don't know, Vasya.<pause:0.5> I actually feel better after
      eating his brew.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337320
    m_Localized: And it's the tastiest soup I've ever had!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337321
    m_Localized: Enjoy it while you can.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337322
    m_Localized: It's obvious he's fattening us up so we'll taste better ourselves.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337323
    m_Localized: Have you completely lost your mind?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337324
    m_Localized: You're seriously going to accuse Leshy of something now?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337325
    m_Localized: We would've kicked that Leshy out ourselves if it weren't for that
      damn witch!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337326
    m_Localized: I'm not Le...
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337327
    m_Localized: Wait, did I just hear someone disrespect the great Leshy?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337328
    m_Localized: It wasn't me!<pause:0.5> It was all him!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337329
    m_Localized: Me?!<pause:0.5> I didn't do anything!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337330
    m_Localized: Heheh.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337331
    m_Localized: '*sigh*'
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337332
    m_Localized: He broke free!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337333
    m_Localized: Everyone save yourselves!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337334
    m_Localized: Run for your lives!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337335
    m_Localized: Oooh,<pause:0.5> how wonderful!<pause:0.5> We have guests, and you've
      all put together such a lovely little picnic!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337336
    m_Localized: And nobody invited me, you rascals.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337337
    m_Localized: Boris, go back home now!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337338
    m_Localized: We'll bring your food to you.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337339
    m_Localized: Go back inside?<pause:0.5> Oh, no way!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337340
    m_Localized: I'm not missing all the fun with our new fluffy friends!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337341
    m_Localized: Boris,<pause:0.5> I'm begging you,<pause:0.5> you'll tear this whole
      place apart.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337342
    m_Localized: Don't be so dramatic, Adele.<pause:0.5> I don't sneeze that hard.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337343
    m_Localized: I'll just sit here with you guys.<pause:0.5> I won't bother anyone!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337344
    m_Localized: We get visitors so rarely!<pause:0.5> There's no way I'm missing
      this!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337345
    m_Localized: Listen carefully, Red.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337346
    m_Localized: Do whatever it takes,<pause:0.5> but don't let him sneeze.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337347
    m_Localized: If he does too hard, we have to rebuild this place from the ruins!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337348
    m_Localized: I won't let you down.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337349
    m_Localized: The Hippopotamus Oath.
    m_Metadata:
      m_Items: []
  - m_Id: 95027885946068992
    m_Localized: Hey, where are you going?
    m_Metadata:
      m_Items: []
  - m_Id: 95028971859763200
    m_Localized: I mean, where are you going?<pause:0.75> You just walked right past
      a sign.
    m_Metadata:
      m_Items: []
  - m_Id: 95032048352387072
    m_Localized: We didn't come all the way out here just to give up now!
    m_Metadata:
      m_Items: []
  - m_Id: 95060151254540288
    m_Localized: No<pause:0.5>, this isn't Clifford.<pause:0.5> This is Riverside.<pause:0.5>
      See?
    m_Metadata:
      m_Items: []
  - m_Id: 95060151283900416
    m_Localized: That damn Clifforder brought Leshy into our village!
    m_Metadata:
      m_Items: []
  - m_Id: 95060151283900417
    m_Localized: Me? Leshy?
    m_Metadata:
      m_Items: []
  - m_Id: 95060151283900418
    m_Localized: And now you've decided to sic Leshy on us!
    m_Metadata:
      m_Items: []
  - m_Id: 95336547382091776
    m_Localized: Especially after accidentally upsetting the locals.
    m_Metadata:
      m_Items: []
  - m_Id: 95336547411451904
    m_Localized: Exactly.<pause:0.5> Unless the evil Leshy and the filthy Clifforder
      want to push the locals' patience even further.
    m_Metadata:
      m_Items: []
  - m_Id: 95703245004103680
    m_Localized: Ohhh,<pause:0.5> thank you, everyone.
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463808
    m_Localized: I haven't had such a good time in a long time!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463809
    m_Localized: These past few days, everyone has been so busy and worried that
      I almost forgot what it felt like.
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463810
    m_Localized: And now we're all sitting at the same table again!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463811
    m_Localized: Sharing delicious food and stories!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463812
    m_Localized: And look at me!<pause:0.5> I can already feel that I'm doing so
      much better!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463813
    m_Localized: All of us!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463814
    m_Localized: It's all thanks to you guys!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463816
    m_Localized: Hooray for Leshy the doctor!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463817
    m_Localized: Come on, Vasya,<pause:0.5> you know what you're supposed to say!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463819
    m_Localized: And now come here, I'll give you all a hug!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463820
    m_Localized: Boris, what are you doing?!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463821
    m_Localized: No matter how kind Leshy has been today, he's still a forest monster!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463822
    m_Localized: He'll eat you!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463824
    m_Localized: He helped my friends, and I'm going to hug him no matter what!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463825
    m_Localized: Boris,<pause:0.5> be reasonable,<pause:0.5> don't.
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463826
    m_Localized: Feeling better doesn't mean you've fully recovered yet.
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463827
    m_Localized: Oh, stop putting on a show, you scaredy-cat!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463828
    m_Localized: I'm coming!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463829
    m_Localized: Wait a second!<pause:0.5> So he's not Leshy at all!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463830
    m_Localized: He's just a grumpy little fox!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463831
    m_Localized: Oh my gosh!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463832
    m_Localized: Why didn't you tell me you weren't Leshy?
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463834
    m_Localized: I hope you're proud of yourself.
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463835
    m_Localized: Of course.
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463836
    m_Localized: Enough bickering, little foxes.
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463837
    m_Localized: Come on, let's discuss what we're going to do with you next.
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463838
    m_Localized: Oh...
    m_Metadata:
      m_Items: []
  - m_Id: 95707377475674112
    m_Localized: <volume:1>Hooray.
    m_Metadata:
      m_Items: []
  - m_Id: 95708385291427840
    m_Localized: Hooray for Aunty Adele,<pause:0.5> the Clifforder, and Leshy!
    m_Metadata:
      m_Items: []
  - m_Id: 95711446944604160
    m_Localized: I don't care, even if he were the devil himself!
    m_Metadata:
      m_Items: []
  - m_Id: 95711446944604161
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> I'm going
      to burst with indignation.
    m_Metadata:
      m_Items: []
  - m_Id: 95712882495479808
    m_Localized: Clifford
    m_Metadata:
      m_Items: []
  - m_Id: 96172734023884800
    m_Localized: Hiii there, little foxy.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734023884801
    m_Localized: Hi there, horsie.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734023884802
    m_Localized: Heading off to make it big in the big city, huh?
    m_Metadata:
      m_Items: []
  - m_Id: 96172734023884803
    m_Localized: Not really,<pause:0.5> quite the opposite.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734028079104
    m_Localized: We got so tired of making it big in the city that we decided to
      start somewhere smaller.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734028079105
    m_Localized: Clifford?<pause:0.5> Small?!
    m_Metadata:
      m_Items: []
  - m_Id: 96172734028079106
    m_Localized: Yeah,<pause:0.5> always has been.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734028079107
    m_Localized: I always thought it was huge.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734032273408
    m_Localized: Silver said Clifford's about the size of a single district in Metropolis.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734032273409
    m_Localized: Wow.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734032273410
    m_Localized: I've always wanted to get there,<pause:0.5> to see a big city.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734032273411
    m_Localized: I knew it wasn't the biggest one out there.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187968
    m_Localized: But I was sure it had to be at least in the top ten.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187969
    m_Localized: And now you're telling me this.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187970
    m_Localized: That's actually kind of disappointing.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187971
    m_Localized: So why don't you go?
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187972
    m_Localized: I can't,<pause:0.5> I'm still too little.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187973
    m_Localized: Just look at yourself!<pause:0.5> You're big and strong!
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187974
    m_Localized: You're pulling me, my brother, and this whole cart all by yourself!
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187975
    m_Localized: Nooo,<pause:0.5> I mean I'm not old enough yet.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187976
    m_Localized: Have you ever tried asking someone older to take you into town?
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187977
    m_Localized: I can't.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187978
    m_Localized: My dad takes people to Clifford and back every day.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187979
    m_Localized: Some of us live here but work in the city,<pause:0.5> like Auntie
      Adele.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187980
    m_Localized: And I'm supposed to stay in the village just in case.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187981
    m_Localized: While Dad's away, I'm the only one who knows how to handle the cart.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187982
    m_Localized: He's always telling me to forget about my responsibilities for a
      day.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187983
    m_Localized: To come into the city with him.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187984
    m_Localized: But I just can't.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187985
    m_Localized: What if something happens while I'm off having fun?
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187986
    m_Localized: Like today, for example.<pause:0.5> You two showed up out of nowhere.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187987
    m_Localized: Who would've taken you to the city if I wasn't here?
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187988
    m_Localized: I guess we'd have had to wait until morning and go with your dad.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187989
    m_Localized: And waiting is something we really can't afford right now.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187990
    m_Localized: We've got a loan hanging over our heads, and we need to start paying
      it off as soon as possible.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187991
    m_Localized: You've really helped us out.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187992
    m_Localized: Little fox,<pause:0.5> what's your name?
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187993
    m_Localized: Red.<pause:0.5> And yours?
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187994
    m_Localized: I'm Daisy.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187995
    m_Localized: Nice to meet you, Daisy.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187996
    m_Localized: Red,<pause:0.5> what's it like living in a city that's even bigger
      than Clifford?
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187997
    m_Localized: It's... not the safest place.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187998
    m_Localized: 'Daisy,<pause: 0.5> why do the people of Riverside dislike Clifford
      so much, <pause:0.5> but still trying to reach there?'
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187999
    m_Localized: I don't know.<pause:0.5> It's always been a complicated relationship.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188000
    m_Localized: And then there was that whole thing with the new road.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188001
    m_Localized: What happened?
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188002
    m_Localized: Not long ago, we found out they're building a road from Clifford
      to the main highway.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188003
    m_Localized: We were all excited, thinking it would pass through our village
      and finally give us an easy way into the city.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188004
    m_Localized: But it turned out they're building it through the desert instead
      of our forest to save a little money.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188005
    m_Localized: I don't let anyone see it,<pause:0.5> but<pause:0.5> between you
      and me,<pause:0.5> it really hurt.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188006
    m_Localized: If the village had a road and even just one car, I'd worry a lot
      less.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188007
    m_Localized: I'd know the villagers wouldn't be in danger without me around.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188008
    m_Localized: I'm sorry.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188009
    m_Localized: If you ever do make it to the city,<pause:0.5> come visit us.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188010
    m_Localized: We're opening a restaurant.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188011
    m_Localized: We haven't come up with a name yet, but you'll know it when you
      see it.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188012
    m_Localized: It's going to be the coolest place in the world!<pause:0.5> You
      won't be able to miss it.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188013
    m_Localized: Wooow,<pause:0.5> that sounds amazing!
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188014
    m_Localized: I'd love to!
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188015
    m_Localized: And your soup was really delicious!
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188016
    m_Localized: I'll definitely stop by if I get the chance!
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188017
    m_Localized: It's a deal.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188018
    m_Localized: Oh,<pause:0.5> is that the highway with the bus stop?
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188019
    m_Localized: Excactly!
    m_Metadata:
      m_Items: []
  - m_Id: 96177215478325248
    m_Localized: Oh...
    m_Metadata:
      m_Items: []
  - m_Id: 96391525269921792
    m_Localized: I have to admit, you two did an excellent job, little foxes.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087616
    m_Localized: The people of Riverside are feeling much better now.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087617
    m_Localized: And maybe now this witch hunt will finally come to an end.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087618
    m_Localized: So you really are a witch after all!
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087619
    m_Localized: I'm about as much of a witch as you are a Leshy.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087620
    m_Localized: I'm a fortune teller,<pause:0.5> and a terrible one at that.<pause:0.5>
      Then again, so are all fortune tellers.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087621
    m_Localized: But to the locals, it's all the same.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087622
    m_Localized: They'll gladly believe the most unbelievable explanation.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087623
    m_Localized: You distracted me.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087624
    m_Localized: You've both worked hard, and you've earned yourselves a reward.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087625
    m_Localized: I have a bit of influence both here and in Clifford.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087626
    m_Localized: And I also happen to own quite a few interesting little things.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087627
    m_Localized: Each of you gets one wish.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087628
    m_Localized: Choose wisely,<pause:0.5> but don't get greedy.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087629
    m_Localized: I want to keep that oven.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087630
    m_Localized: You don't ask for small favors, do you, Red?
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087631
    m_Localized: But it's a fair price, considering what you've done.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087632
    m_Localized: Besides, it's been gathering dust here anyway.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087633
    m_Localized: I hate cooking.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087634
    m_Localized: It's yours.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087635
    m_Localized: And what about you, Silver?<pause:0.5> What do you want?
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087636
    m_Localized: I want you to get us to Clifford as soon as possible.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087637
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Fine.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087638
    m_Localized: We do have a backup plan for emergencies.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087639
    m_Localized: I suppose<pause:0.5> today qualifies.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087640
    m_Localized: But if she comes back complaining that you two gave her a hard time...
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087641
    m_Localized: We'll be perfect gentlemen!
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087642
    m_Localized: That's the right answer.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087643
    m_Localized: Pack your things,<pause:0.5> the next ride to Clifford leaves in
      ten minutes.
    m_Metadata:
      m_Items: []
  - m_Id: 96395963300732928
    m_Localized: We were just passing through anyway.
    m_Metadata:
      m_Items: []
  - m_Id: 96395963321704448
    m_Localized: We weren't planning to stick around this godforsaken...
    m_Metadata:
      m_Items: []
  - m_Id: 96989101652336640
    m_Localized: Wake up, little foxes!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696768
    m_Localized: We're almost there!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696769
    m_Localized: Huh?<pause:0.5> What?
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696770
    m_Localized: Open your eyes, Red!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696771
    m_Localized: We're here!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696772
    m_Localized: Whoa!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696773
    m_Localized: It really does look huge from up here!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696774
    m_Localized: See? I told you!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696775
    m_Localized: Someday I'll come here on my own!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696776
    m_Localized: And I'll explore every corner of Clifford!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696777
    m_Localized: But I have to head home now.
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696778
    m_Localized: It'll be getting dark soon, and my dad will start worrying.
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696779
    m_Localized: Sorry I can't take you any farther.
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696780
    m_Localized: That's alright, sweetheart.<pause:0.5> You've already helped us
      more than enough.
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696781
    m_Localized: We can find our way to our new place from here.
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696782
    m_Localized: Our new place?!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696783
    m_Localized: Did you already buy us a building?!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696784
    m_Localized: Oh, no.<pause:0.5> Buying property online would be way too reckless.
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696785
    m_Localized: But I did find a very promising place!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696786
    m_Localized: And I've got a really good feeling about it!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696787
    m_Localized: So we can head over there right now!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696788
    m_Localized: Then what are we waiting for?!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696789
    m_Localized: Lead the way!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696790
    m_Localized: Byyye, little foxes!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696791
    m_Localized: Bye, Daisy!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696792
    m_Localized: Safe travels, Daisy!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696793
    m_Localized: Come on, Red.
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696794
    m_Localized: That place isn't going to check itself out.
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696795
    m_Localized: You'd better start trembling, little house!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696796
    m_Localized: You have no idea how hard I'm gonna inspect you!
    m_Metadata:
      m_Items: []
  - m_Id: 101511935816785920
    m_Localized: Riverside
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
