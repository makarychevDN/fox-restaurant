%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogues_es
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 76c0caf3be1b6134fac28638aa766eea, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 96960955703296
    m_Localized: "*suspiro*<pause:1> Otro d\xEDa, otro d\xF3lar."
    m_Metadata:
      m_Items: []
  - m_Id: 102732733243392
    m_Localized: "Maldita sea,<pause:0.5> este ni\xF1o parece duro,<pause:0.5> necesita
      al menos dos helados."
    m_Metadata:
      m_Items: []
  - m_Id: 102851926974464
    m_Localized: "Muchacho grande, \xBFeh?<pause:0.75> Cuanto m\xE1s grandes son,
      m\xE1s fuerte caen."
    m_Metadata:
      m_Items: []
  - m_Id: 102931308371968
    m_Localized: "Vieja basura est\xFApida."
    m_Metadata:
      m_Items: []
  - m_Id: 103157167448064
    m_Localized: Tengo que limpiar el desastre.
    m_Metadata:
      m_Items: []
  - m_Id: 103200687546368
    m_Localized: "\xBFD\xF3nde est\xE1 el bote de basura?"
    m_Metadata:
      m_Items: []
  - m_Id: 103255913947136
    m_Localized: "Oh,<pause:0.5> ah\xED est\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 103266819137536
    m_Localized: "\xA1Fuera, peque\xF1os apestosos!"
    m_Metadata:
      m_Items: []
  - m_Id: 103795813146624
    m_Localized: Oh,<pause:0.5> vaya.<pause:0.5> El primer pedido complejo de hoy.
    m_Metadata:
      m_Items: []
  - m_Id: 103882635239424
    m_Localized: "Aunque todav\xEDa es demasiado f\xE1cil."
    m_Metadata:
      m_Items: []
  - m_Id: 103985789952000
    m_Localized: Es necesario mezclar los ingredientes.
    m_Metadata:
      m_Items: []
  - m_Id: 104019986112512
    m_Localized: "*suspiro*<pause:1> Me pregunto c\xF3mo ser\xE1 cocinar platos reales."
    m_Metadata:
      m_Items: []
  - m_Id: 104142648532992
    m_Localized: Oh,<pause:0.5> comienza el verdadero juego.
    m_Metadata:
      m_Items: []
  - m_Id: 104186449649664
    m_Localized: "Es f\xE1cil.<pause:0.5> Esta cosa genera elementos,<pause:0.5>
      los uso."
    m_Metadata:
      m_Items: []
  - m_Id: 104222092845056
    m_Localized: Lo principal es evitar que se obstruya.
    m_Metadata:
      m_Items: []
  - m_Id: 104300811542528
    m_Localized: "*suspiro*<pause:1> Todos los d\xEDas a la misma hora."
    m_Metadata:
      m_Items: []
  - m_Id: 104452712456192
    m_Localized: "Oh, <pause: 0.5> eres t\xFA otra vez, Red <pause:0.5>NO<pause:0.5>
      un cocinero."
    m_Metadata:
      m_Items: []
  - m_Id: 104546270601216
    m_Localized: 'Yarrr,<pause: 0.5> bienvenido a bordo, joven marinero.'
    m_Metadata:
      m_Items: []
  - m_Id: 104596988125184
    m_Localized: No necesito tus saludos, Red <pause:0.5>NOT<pause:0.5> un cocinero.
    m_Metadata:
      m_Items: []
  - m_Id: 104702047051776
    m_Localized: "Necesito que trabajes m\xE1s r\xE1pido, no m\xE1s fuerte."
    m_Metadata:
      m_Items: []
  - m_Id: 104734192197632
    m_Localized: "\xBFSab\xEDas que este es un restaurante para ni\xF1os?"
    m_Metadata:
      m_Items: []
  - m_Id: 104799568814080
    m_Localized: "Pfft.<pause:0.5> Este lugar est\xE1 lleno de piratas."
    m_Metadata:
      m_Items: []
  - m_Id: 104851519463424
    m_Localized: "Los piratas son demasiado aterradores para ellos,<pause:0.5> as\xED
      que<pause:0.5>S\xCD,<pause:0.5> claramente es para adultos."
    m_Metadata:
      m_Items: []
  - m_Id: 104919387496448
    m_Localized: Al menos no eres demasiado mayor para esto.
    m_Metadata:
      m_Items: []
  - m_Id: 105019983683584
    m_Localized: "Estoy en la edad perfecta para este lugar, as\xED que, <pause:0.5>S\xCD."
    m_Metadata:
      m_Items: []
  - m_Id: 105266793308160
    m_Localized: "Y necesito algunas calor\xEDas para estar en perfecta forma.<pause:0.5>
      As\xED que, date prisa, Red <pause:0.5>NOT<pause:0.5> un cocinero."
    m_Metadata:
      m_Items: []
  - m_Id: 105471504703488
    m_Localized: 'Pfft.<pause: 0.5> Si lo has hecho no significa que lo hayas hecho
      bien,<pause: 0.5> Rojo <pause:0.5>NO<pause:0.5> un cocinero.'
    m_Metadata:
      m_Items: []
  - m_Id: 105543625760768
    m_Localized: 'Yarrr,<pause: 0.5> esperamos verte pronto de nuevo, joven marinero.'
    m_Metadata:
      m_Items: []
  - m_Id: 105608289345536
    m_Localized: "Oh, <pause:0.5>S\xCD, <pause:0.5>no<pause: 0.5> lo dudes.<pause:
      0.5> Me ver\xE1s pronto."
    m_Metadata:
      m_Items: []
  - m_Id: 105693555351552
    m_Localized: "Y la pr\xF3xima vez no ser\xE9 tan amable contigo."
    m_Metadata:
      m_Items: []
  - m_Id: 105789357449216
    m_Localized: Hasta luego, Red <pause:0.5>NOT<pause:0.5> un cocinero.
    m_Metadata:
      m_Items: []
  - m_Id: 107592824283136
    m_Localized: __MARCADOR_0__.__MARCADOR_1__.__MARCADOR_2__.__MARCADOR_3____MARCADOR_4__
      Finalmente.
    m_Metadata:
      m_Items: []
  - m_Id: 107662542004224
    m_Localized: Vaya, ya es hora del descanso.
    m_Metadata:
      m_Items: []
  - m_Id: 131328193486848
    m_Localized: "Maldita sea...<pause:1> Ok, intent\xE9moslo de nuevo."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674043346944
    m_Localized: Por fin, un momento de paz.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124160
    m_Localized: "\xA1S\xED! <pause:0.75> Bueno entonces, marinero, \xBFcre\xEDas
      que tu primer d\xEDa ser\xEDa pan comido?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124161
    m_Localized: "Llevo trabajando aqu\xED m\xE1s de un a\xF1o."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124162
    m_Localized: "\xA1Yarr! <pause:0.75> \xA1No le encontr\xE9 ni pies ni cabeza
      a eso!<pause:0.75> \xA1Suenas como un marinero de tierra!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124163
    m_Localized: "No quiero hablar as\xED cuando no estoy en la caja.<pause:0.75>
      Es<pause:0.5> rid\xEDculo."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124164
    m_Localized: No somos piratas en la vida real.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124165
    m_Localized: __MARCADOR_0__...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124166
    m_Localized: __MARCADOR_0__.__MARCADOR_1__.__MARCADOR_2__.__MARCADOR_3____MARCADOR_4__
      *suspiro*
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124167
    m_Localized: "\xA1S\xED!<pause:0.75> Capit\xE1n,<pause:0.75> \xA1He estado en
      este viaje por m\xE1s de un a\xF1o!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124168
    m_Localized: "<volume:1>\xA1Yarr!<pause:0.75> \xA1Eso est\xE1 mejor!<pause:0.75>
      \xA1Sigue as\xED y el tesoro no tardar\xE1 en llegar!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124169
    m_Localized: "Hablando de tesoros.<pause:0.75> En realidad quer\xEDa hablar sobre
      mi ascenso y..."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124170
    m_Localized: "\xA1Y \xE1nimo, marinero!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124171
    m_Localized: "No s\xE9 qu\xE9 te pas\xF3 en la orilla."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124172
    m_Localized: "\xA1Pero si sigues caminando con ese aspecto de mal humor, asustar\xE1s
      a todos mis clientes!<pause:0.75> \xA1Hurra!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124173
    m_Localized: Es solo que...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124174
    m_Localized: ...mi cara.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124175
    m_Localized: __MARCADOR_0__.__MARCADOR_1__.__MARCADOR_2__.__MARCADOR_3____MARCADOR_4__
      Sordomudo.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124176
    m_Localized: "\xA1\xBFYa?!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124177
    m_Localized: "\xA1Lo juro, los descansos son cada d\xEDa m\xE1s cortos!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124178
    m_Localized: "Se lo mostrar\xE9.<pause:1> Se los mostrar\xE9 a todos."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124179
    m_Localized: "Abrir\xE9 mi propio restaurante, contratar\xE9 a todos y cada uno
      de ellos, y luego les dar\xE9 los descansos m\xE1s cortos imaginables."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124180
    m_Localized: "\xA1Y me dar\xE9 un descanso escandalosamente largo!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124181
    m_Localized: "\xA1Pero ni siquiera querr\xE9 usarlo, as\xED de incre\xEDble ser\xE1
      mi lugar!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124182
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Pens\xE1ndolo
      bien, tal vez deber\xEDa hacerlo un poco menos asombroso."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124183
    m_Localized: "De lo contrario, no querr\xE1n tomar descansos en absoluto."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124184
    m_Localized: Oh,<pause:0.75> es ella otra vez.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124185
    m_Localized: "Ella necesita un enfoque especial.<pause:0.75> Ella mira lo que
      est\xE1n comiendo los dem\xE1s y pide lo mismo."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124186
    m_Localized: La pobre tiende a dudar.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124187
    m_Localized: "All\xE1 vamos.<pause:0.75> \xA1Helado para todos!<pause:0.75> \xA1Y
      ni siquiera sud\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124188
    m_Localized: __MARCADOR_0__...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124189
    m_Localized: "Yarr,<pause:0.75> \xBFest\xE1 todo bien, joven marinero?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124190
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> \xA1Solo
      quer\xEDa darte las gracias!<pause:0.5> Fuiste muy paciente."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124191
    m_Localized: Generalmente los adultos dicen malas palabras cuando tengo muchas
      dudas.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124192
    m_Localized: "\xA1Yarr,<pause:0.5> no te preocupes, joven marinero,<pause:0.5>
      y vuelve cuando quieras!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124193
    m_Localized: "\xA1Eres incre\xEDble!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124194
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Hm,<pause:0.75>
      tal vez este d\xEDa<pause:0.75> no sea tan malo despu\xE9s de todo."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124195
    m_Localized: Oye,<pause:0.5> Rojo,<pause:0.5> vamos,<pause:0.5> necesitamos hablar.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124196
    m_Localized: Contratado.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124197
    m_Localized: Hola, Stan.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124198
    m_Localized: "Mis ojos est\xE1n m\xE1s abajo."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124199
    m_Localized: Oh.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124200
    m_Localized: "S\xED,<pause:0.75> eso est\xE1 mejor."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124201
    m_Localized: "Entonces \xBFqu\xE9 quer\xEDas?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124202
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Tengo que
      salir al comedor en un minuto.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124203
    m_Localized: "\xA1\xBFQu\xE9?!<pause:0.75> \xA1No!<pause:0.75> \xA1Me opongo!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124204
    m_Localized: "El capit\xE1n dijo que me arrojar\xEDa a la basura si no lo hac\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124205
    m_Localized: "No estoy completamente seguro de qu\xE9 significa eso en ingl\xE9s
      sencillo,<pause:0.5> pero estoy seguro de que no es nada bueno."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124206
    m_Localized: "\xA1Pero los ni\xF1os se vuelven locos por Peg-Leg Joe!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124207
    m_Localized: "\xA1Destrozar\xE1n este lugar si te ven con ese disfraz!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124208
    m_Localized: "\xA1No podr\xE9 atender a tantos clientes!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124209
    m_Localized: "\xA1Necesitamos al menos tres personas en el registro para mantener
      el ritmo!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124210
    m_Localized: "\xA1Y hoy estoy solo!<pause:0.75> \xA1Recuerda lo que pas\xF3 la
      \xFAltima vez!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124211
    m_Localized: "Lo s\xE9.<pause:0.75> Por eso vine a hablarlo."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124212
    m_Localized: "Entonces,<pause:0.5> \xBFrealmente tienes un plan?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124213
    m_Localized: "S\xED,<pause:0.5> noche de pel\xEDcula.<pause:0.5> T\xFA corres
      las cortinas,<pause:0.5> enciendes el proyector,<pause:0.5> y yo me asegurar\xE9
      de que todos mantengan el volumen bajo."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124214
    m_Localized: "Noche de pel\xEDcula, \xBFeh?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124215
    m_Localized: "Eso significa que tendr\xE9 que encargarme del men\xFA de la noche
      con los c\xF3cteles.<pause:0.75> Eso no ser\xE1 f\xE1cil."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124216
    m_Localized: "A\xFAn es m\xE1s f\xE1cil que si todos los ni\xF1os de todo el
      vecindario vinieran corriendo aqu\xED a la vez."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124217
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> S\xED,<pause:0.5>
      tienes raz\xF3n.<pause:0.75> Eres un genio, Stan.<pause:0.75> Hag\xE1moslo."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124218
    m_Localized: Trato.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124219
    m_Localized: "Muy bien,<pause:0.75> probemos esto.<pause:1> 3,<pause:1> 2<pause:1>
      1.<pause:1> \xA1Vamos!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124220
    m_Localized: "Oh Dios m\xEDo,<pause:0.4> \xA1es Peg-Leg Joe!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124221
    m_Localized: "Yay,<pause:0.4> \xA1Joe Pata de Palo!<pause:0.4> \xA1\xA1\xA1Dame
      un avent\xF3n!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124222
    m_Localized: "\xA1\xA1\xA1Yo tambi\xE9n!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124223
    m_Localized: "\xA1S\xED!<pause:0.75> Peg-Leg Joe no se siente muy bien hoy,<pause:0.4>
      as\xED que lo mantendremos en secreto."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318464
    m_Localized: "Awww,<pause:0.75> \xA1eso no es justo!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318465
    m_Localized: "Pens\xE9 que nos \xEDbamos a divertir."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318466
    m_Localized: "No te preocupes, joven marinero, \xA1no tenemos que ser ruidosos
      para divertirnos!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318467
    m_Localized: "Por ejemplo,<pause:0.75> \xA1podr\xEDamos ver una caricatura!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318468
    m_Localized: Los dibujos animados son buenos.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318469
    m_Localized: "\xA1S\xF3lo si es interesante!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318470
    m_Localized: Espero<pause:0.5> que haya una estrella de mar dentro...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318471
    m_Localized: "\xA1Yarr,<pause:0.75> por supuesto que es interesante!<pause:0.75>
      Pero lo estaremos viendo en silencio.<pause:0.5> \xBFTrato hecho, j\xF3venes
      marineros?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318472
    m_Localized: "\xA1Trato!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318473
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> \xA1Funcion\xF3!<pause:0.75>
      \xA1No apareci\xF3 gente!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318474
    m_Localized: "\xA1Te lo dije!<pause:0.75> \xA1Un plan infalible!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318475
    m_Localized: "Ahora s\xF3lo queda una cosa.<pause:0.75> \xA1De vuelta al trabajo!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318476
    m_Localized: "Ufff,<pause:0.5> j\xF3venes marineros,<pause:0.5> \xBFqui\xE9n
      m\xE1s quiere un poco de helado?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318477
    m_Localized: __MARCADOR_0__...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318478
    m_Localized: Parece que<pause:0.5> ya te encargaste de todo.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318479
    m_Localized: "\xBFPodr\xEDas mantenerlo en voz baja, por favor?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318480
    m_Localized: <volume:1>Estamos intentando mirar.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318481
    m_Localized: Oh,<pause:0.5> lo siento.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318482
    m_Localized: "\xA1Oh, vamos!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318483
    m_Localized: "Oye,<pause:0.5> \xA1no hab\xEDamos terminado de mirar!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318484
    m_Localized: "<volume:0.5>\xA1Yarr!<pause:0.5> \xBFQu\xE9 creen que est\xE1n
      haciendo aqu\xED, marineros?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318485
    m_Localized: "\xA1Te dije que enviaras a Peg-Leg Joe, no que te quedaras aqu\xED
      deambulando!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318486
    m_Localized: "<emote:shake><volume:1>Hola,<pause:0.5><emote:shake> j\xF3venes
      marineros,<pause:0.5><emote:shake> \xA1Peg-Leg Joe se ha estado escondiendo
      aqu\xED todo este tiempo!<pause:0.5><emote:shake> \xA1Entren,<pause:0.5><emote:shake>
      demu\xE9strenle cu\xE1nto lo aman!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318487
    m_Localized: "<volume:0.5>\xA1Adelante, marineros,<pause:0.75> traedme todos
      los tesoros del mundo!<pause:0.75> \xA1Jajajajaja!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318488
    m_Localized: "\xA1Es Joe Pata de Palo!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318489
    m_Localized: "\xA1Corre hacia \xE9l!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318490
    m_Localized: Oh, no.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318491
    m_Localized: '*suspiro* <pause:1> Inicio.'
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318492
    m_Localized: "\xBFEh?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318493
    m_Localized: "\xBFQu\xE9...?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318494
    m_Localized: Plata
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318495
    m_Localized: "Si sales sin sombrero, se lo dir\xE9 a mam\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318496
    m_Localized: NO
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318497
    m_Localized: nuevo mensaje
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318498
    m_Localized: Ven a la cocina
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318499
    m_Localized: "\xA1Hola!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318500
    m_Localized: "\xBFTe das cuenta de que no puedes entrar en mi casa as\xED como
      as\xED?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318501
    m_Localized: Estaba desbloqueado.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318502
    m_Localized: "\xBFY por qu\xE9 est\xE1s sentado aqu\xED en la oscuridad?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318503
    m_Localized: "Me siento juguet\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318504
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318505
    m_Localized: "Oh,<pause:0.5> no act\xFAes como si no estuvieras feliz de verme."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318506
    m_Localized: Soy.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318507
    m_Localized: "Entonces.<pause:0.75> \xBFPor qu\xE9 est\xE1s aqu\xED?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318508
    m_Localized: "\xBFNo puedo simplemente pasar a ver c\xF3mo est\xE1 mi hermano
      peque\xF1o?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318509
    m_Localized: Puedes,<pause:0.75> pero no lo haces.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318510
    m_Localized: "Vaya. \xBFDe verdad es tan poco lo que piensas de m\xED?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318511
    m_Localized: Muy bien,<pause:0.75> me tienes.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318512
    m_Localized: "No estoy aqu\xED sin motivo.<pause:0.75> Tengo una propuesta para
      ti."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318513
    m_Localized: "\xA1NO!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318514
    m_Localized: Ni siquiera me escuchaste.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318515
    m_Localized: "\xA1NO!<pause:0.75> \xA1Estoy fuera del juego!<pause:0.75> Ahora
      solo soy un cocinero normal, \xBFrecuerdas?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318516
    m_Localized: "Est\xE1s sirviendo helado en un restaurante infantil.<pause:0.75>
      No eres cocinero."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318517
    m_Localized: "\xA1Practico mucho en casa!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318518
    m_Localized: "Y yo s\xE9 que eres bueno."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318519
    m_Localized: "Pero ser cocinero no es un hobby, es una profesi\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318520
    m_Localized: "\xBFViniste aqu\xED s\xF3lo para insultarme?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512768
    m_Localized: En realidad vine a ayudarte con eso.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512769
    m_Localized: "Primero que todo, no me gusta c\xF3mo suena eso.<pause:0.75> Y
      segundo, no entiendes nada de cocina."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512770
    m_Localized: "Tal vez no.<pause:0.75> Pero entiendo que est\xE1s abordando tu
      objetivo de manera incorrecta."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512771
    m_Localized: "Rojo,<pause:0.75> no est\xE1s al d\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512772
    m_Localized: "Peor a\xFAn, lo que est\xE1s atravesando no te acerca a tu objetivo."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512773
    m_Localized: "Te est\xE1 alejando a\xFAn m\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512774
    m_Localized: "\xA1No, no lo es!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512775
    m_Localized: "\xA1\xC9chale un vistazo a esto!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512776
    m_Localized: "\xA1Mirad!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512777
    m_Localized: mi objetivo
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512778
    m_Localized: "\xBFVes?<pause:0.5> \xA1Ya estoy a mitad de camino!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512779
    m_Localized: "\xA1No me arrastro a ese maldito trabajo d\xEDa tras d\xEDa para
      nada!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512780
    m_Localized: "\xA1Cada mes hay m\xE1s y m\xE1s dinero en el frasco!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512781
    m_Localized: "\xA1Y cuando llene esto, abrir\xE9 un restaurante donde servir\xE9
      los mejores platos de la zona!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512782
    m_Localized: "\xA1Y el personal tendr\xE1 descansos escandalosamente largos!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512783
    m_Localized: "\xA1Pero trabajar all\xED ser\xE1 tan maravilloso que nadie querr\xE1
      ni llev\xE1rselos!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512784
    m_Localized: "\xA1Y nadie dir\xE1 jam\xE1s que Red no es un verdadero cocinero!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512785
    m_Localized: "\xA1Nadie!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512786
    m_Localized: "Oh, t\xFA, peque\xF1o pastelito gru\xF1\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512787
    m_Localized: No estoy diciendo que trabajes duro.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512788
    m_Localized: Es lo opuesto.<pause:0.5> Te has sumergido tanto en la cocina que
      olvidaste mantener los ojos abiertos.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512789
    m_Localized: "Rojo,<pause:0.5> \xBFhace cu\xE1nto tiempo estableciste este objetivo?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512790
    m_Localized: "Hace un a\xF1o y medio."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512791
    m_Localized: "\xBFHas visto cu\xE1nto han subido los precios desde entonces?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512792
    m_Localized: Bueno, los precios siempre suben un poco.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512793
    m_Localized: "S\xF3lo mira cu\xE1nto cuesta ahora ese equipo que te gustaba en
      aquel entonces."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512794
    m_Localized: Oh, vamos,<pause:0.5> no puede ser tan malo.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512795
    m_Localized: "Estoy seguro de que podr\xEDas mover monta\xF1as con esa terquedad
      tuya."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512796
    m_Localized: "Pero si sigues as\xED, te alejar\xE1s a\xFAn m\xE1s de tu objetivo."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512797
    m_Localized: "Las cosas se est\xE1n volviendo m\xE1s caras m\xE1s r\xE1pido de
      lo que ganas."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512798
    m_Localized: "Entonces \xBFqu\xE9 se supone que debo hacer?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512799
    m_Localized: Tomar medidas.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512800
    m_Localized: "Esto todav\xEDa no es suficiente para cubrir toda tu visi\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512801
    m_Localized: "Pero es un capital inicial decente para algo m\xE1s modesto."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512802
    m_Localized: "Por ejemplo, <pause:0.75> un peque\xF1o restaurante en una ciudad
      m\xE1s peque\xF1a."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512803
    m_Localized: "Ya he buscado un lugar prometedor.<pause:0.75> Nuestro dinero cubrir\xEDa
      el pago inicial."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512804
    m_Localized: "\xBFPago inicial?<pause:0.75> Un pr\xE9stamo suena bastante<pause:0.5>
      arriesgado."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512805
    m_Localized: "Por supuesto,<pause:0.75> pero ya sabes c\xF3mo funciona.<pause:0.75>
      Sin riesgo, no hay recompensa."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512806
    m_Localized: "En realidad, \xBFsabes qu\xE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512807
    m_Localized: "\xA1Tienes raz\xF3n!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512808
    m_Localized: "\xA1Al diablo con el restaurante de helados!<pause:0.75> \xA1Al
      diablo con todos ellos!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512809
    m_Localized: "\xA1Si tengo que hablar como un pirata un d\xEDa m\xE1s, perder\xE9
      la cabeza!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512810
    m_Localized: "\xA1\xC9se es el esp\xEDritu!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512811
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> \xBFY
      qu\xE9 hay en esto para ti?<pause:0.75> \xBFPor qu\xE9 ayudarme?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512812
    m_Localized: "Bueno,<pause:0.75> primero que todo,<pause:0.75> porque me preocupa
      mi hermano peque\xF1o."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512813
    m_Localized: "\xBFQui\xE9n se meter\xEDa en problemas sin m\xED?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512814
    m_Localized: Y segundo, quiero una parte.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707072
    m_Localized: "\xA1No te creo!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707073
    m_Localized: "\xA1Pr\xE1cticamente puedes hacer dinero de la nada!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707074
    m_Localized: "\xBFPor qu\xE9 querr\xEDas tener una participaci\xF3n en alg\xFAn
      restaurante cualquiera?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707075
    m_Localized: "Oh, \xBFde verdad pensaste que nunca crecer\xEDa?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707076
    m_Localized: "\xBFQue no me gustar\xEDa establecerme?<pause:0.75> \xBFTiene una
      fuente leg\xEDtima de ingresos?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707077
    m_Localized: "Est\xE1s hiriendo mis sentimientos."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707078
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707079
    m_Localized: "\xBFQu\xE9?<pause:0.75> \xBFDe verdad crees que estoy intentando
      enga\xF1arte?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707080
    m_Localized: "\xBFCu\xE1ntas veces he intentado hacerte da\xF1o?<pause:0.75>
      \xBFRobarte?<pause:0.75> \xBFTenerte una trampa?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707081
    m_Localized: Ni una sola vez.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707082
    m_Localized: "Entonces \xBFqu\xE9 est\xE1s esperando?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707083
    m_Localized: "\xBFFogonadura?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707084
    m_Localized: "Muy bien, compa\xF1eros."
    m_Metadata:
      m_Items: []
  - m_Id: 39890501168685056
    m_Localized: "\xA1Y su incre\xEDble aventura ha comenzado!"
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377408
    m_Localized: "Es suficiente para atender a la mayor\xEDa de ellos."
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377409
    m_Localized: "Este dispositivo me muestra cu\xE1ntos clientes m\xE1s necesito
      satisfacer."
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377410
    m_Localized: "Oh, vaya.<pause:0.5> Vinieron tantos ni\xF1os que no cab\xEDan
      todos dentro."
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377411
    m_Localized: "Algunos est\xE1n esperando a que se libere un espacio antes de
      poder realizar un pedido."
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377412
    m_Localized: "Esto muestra qui\xE9n es el siguiente en la fila."
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377413
    m_Localized: A veces ayuda ganar tiempo,<pause:0.5> pero no lo fuerces demasiado.
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377414
    m_Localized: "Los clientes que hacen cola tambi\xE9n tienen paciencia."
    m_Metadata:
      m_Items: []
  - m_Id: 76866541631725568
    m_Localized: Normalmente, no tengo que atender a todos y cada uno de los clientes.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020216782848
    m_Localized: "\xA1Guau, qu\xE9 viaje!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948672
    m_Localized: "\xBFY d\xF3nde estamos ahora?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948673
    m_Localized: "En alg\xFAn lugar no muy lejos de Clifford."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948674
    m_Localized: "La se\xF1al es realmente mala aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948675
    m_Localized: "As\xED que tendremos que improvisar a partir de aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948676
    m_Localized: "Toma otro autob\xFAs<pause:0.5> o pregunta a los lugare\xF1os c\xF3mo
      llegar."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948677
    m_Localized: <volume:0>...
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948678
    m_Localized: "<volume:1>Aunque<pause:1> eso podr\xEDa ser un peque\xF1o problema."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948679
    m_Localized: "\xBFEstamos perdidos?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948680
    m_Localized: "Oh, no seas tan dram\xE1tico."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948681
    m_Localized: "En el peor de los casos, esperamos aqu\xED al pr\xF3ximo autob\xFAs
      y regresamos."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948682
    m_Localized: "\xA1De ninguna manera!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948685
    m_Localized: "Para encontrar ese est\xFApido pueblito."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948686
    m_Localized: "\xA1Y cuando llegue all\xED, voy a cocinar una cantidad descomunal
      de espaguetis!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948687
    m_Localized: "\xA1Y los lugare\xF1os van a tener que comerse hasta el \xFAltimo
      pedacito!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948688
    m_Localized: "\xA1Y les encantar\xE1!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948689
    m_Localized: '!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948691
    m_Localized: Oh.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948692
    m_Localized: "Dice que Clifford est\xE1 justo al final de este sendero."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948693
    m_Localized: "\xBFA qu\xE9 estamos esperando?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948694
    m_Localized: "\xA1Tiemblen, habitantes de Clifford!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948695
    m_Localized: "\xA1El rojo se acerca!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948696
    m_Localized: "\xBFY el gran y terrible Rojo no le tiene miedo a un bosque tan
      tenebroso como este?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948697
    m_Localized: Un poco.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948698
    m_Localized: "\xA1Pero no da tanto miedo como dar marcha atr\xE1s!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948699
    m_Localized: Estoy seguro<pause:0.75> de que no es tan malo como parece.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948700
    m_Localized: "Un \xFAltimo esfuerzo y, despu\xE9s del viaje, estaremos relaj\xE1ndonos
      en Clifford."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948701
    m_Localized: "\xBFY tomar c\xF3cteles con sombrillitas?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948702
    m_Localized: "Y saboreando c\xF3cteles con sombrillitas."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948703
    m_Localized: Dulce.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948704
    m_Localized: "\xBFCu\xE1ndo te cambiaste de sombrero?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948705
    m_Localized: "Cuando nuestro viaje por carretera se convirti\xF3 en una caminata,
      tonto."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948706
    m_Localized: Mirar.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948707
    m_Localized: Creo que lo logramos.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948709
    m_Localized: "Maldici\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948710
    m_Localized: "Oye,<pause:0.75> mira el lado positivo. \xA1Al menos ya no estamos
      perdidos!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948711
    m_Localized: "\xA1Y mira eso!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948712
    m_Localized: "\xA1Un lugare\xF1o!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948713
    m_Localized: Hola.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948714
    m_Localized: "\xA1AAAH!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948716
    m_Localized: "\xA1Estamos perdidos!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948718
    m_Localized: "\xA1No te muevas, monstruo del bosque!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948719
    m_Localized: "S\xED, definitivamente t\xFA."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948720
    m_Localized: "\xA1Silencio, sucio Clifforder!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948721
    m_Localized: "\xA1Primero nos trajisteis la enfermedad!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948723
    m_Localized: "\xA1No lo permitiremos!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948724
    m_Localized: Creo que ha habido un gran malentendido.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948725
    m_Localized: "No somos de Clifford.<pause:0.5> En realidad est\xE1bamos a punto
      de irnos."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948726
    m_Localized: "\xA1No te vas a librar tan f\xE1cilmente despu\xE9s de todo lo
      que has hecho!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142976
    m_Localized: Oh, oh.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142977
    m_Localized: "De acuerdo,<pause:0.5> sep\xE1renlo.<pause:0.5> Aqu\xED no hay
      nada que ver."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142978
    m_Localized: Estos dos vienen conmigo.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142979
    m_Localized: "\xA1Pero son de Clifford!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142980
    m_Localized: "De d\xF3nde vengan no es asunto tuyo.<pause:0.75> \xA1Todav\xEDa
      tienes mucho trabajo que hacer hoy!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142981
    m_Localized: "\xA1Todos ustedes!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142982
    m_Localized: "\xA1Pero!.."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142983
    m_Localized: "\xA1Sin peros!<pause:0.75> \xBFNadie te ha echado una maldici\xF3n
      en mucho tiempo?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142984
    m_Localized: "\xA1Tch!<pause:0.5> \xA1Bruja!<pause:0.5> Vamos,<pause:0.5> la
      bruja se ha encontrado un nuevo par de juguetes."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142985
    m_Localized: "\xBFA QUI\xC9N LLAMAS BRUJA, PEDAZO DE MIERDA?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142986
    m_Localized: "\xA1Ay!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142987
    m_Localized: "<volume:1>*suspiro*<pause:0.75> S\xEDgueme,<pause:0.5> antes de
      que cambien de opini\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142988
    m_Localized: "\xA1Tu casa es tan acogedora!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142989
    m_Localized: "\xBFQu\xE9 son todas estas cosas que hay en los estantes?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142990
    m_Localized: "No toques las antig\xFCedades."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142991
    m_Localized: "No lo ten\xEDa planeado."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142992
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142993
    m_Localized: Gracias por defendernos.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142994
    m_Localized: "S\xED,<pause:0.5> si no fuera por ti, nos habr\xEDan comido vivos."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142995
    m_Localized: "*suspiro* <pause:0.5> No se habr\xEDan comido a nadie,<pause:0.5>
      no son monstruos."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142996
    m_Localized: "Est\xE1n muy nerviosos."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142997
    m_Localized: "Lo m\xE1s probable es que simplemente te hubieran echado de Riverside."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142998
    m_Localized: "En el peor de los casos, te habr\xEDan gritado algunas cosas desagradables."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142999
    m_Localized: En realidad, nos conviene.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143000
    m_Localized: "De todos modos, solo est\xE1bamos de paso. No ten\xEDamos pensado
      quedarnos en este lugar perdido de Dios..."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143001
    m_Localized: "Qu\xE9 verg\xFCenza."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143002
    m_Localized: "Nos dar\xEDa mucha pena abandonar un lugar tan bonito con tanta
      prisa."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143004
    m_Localized: "Ser\xE1 mejor que escuches a tus mayores, naranja.<pause:0.75>
      La gente valora eso por aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143005
    m_Localized: "Y de todos modos no deber\xEDas tener tanta prisa.<pause:0.5> El
      camino que tienes por delante es incluso m\xE1s dif\xEDcil que el que te trajo
      hasta aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143006
    m_Localized: "\xBFEstoy en lo cierto al suponer que te diriges a Clifford?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143007
    m_Localized: "\xA1S\xED, se\xF1ora!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143008
    m_Localized: "Una elecci\xF3n extra\xF1a, pero eso es asunto tuyo."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143009
    m_Localized: "Nuestro caballo de tiro ya sali\xF3 para que Clifford recogiera
      la medicina. No volver\xE1 hasta tarde esta noche."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143010
    m_Localized: "El pr\xF3ximo viaje al pueblo es ma\xF1ana por la ma\xF1ana."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143011
    m_Localized: "Entonces, hasta entonces, \xBFser\xE1 mejor que nos quedemos donde
      estamos y mantengamos un perfil bajo?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143013
    m_Localized: "Perfecto!<pause:0.75> Entonces nos sentaremos aqu\xED tranquilamente
      y no estorbaremos a nadie."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143014
    m_Localized: Zorrito inteligente.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143015
    m_Localized: "Est\xE1n esperando medicinas de la ciudad.<pause:0.5> \xBFEst\xE1n
      enfermos?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143016
    m_Localized: "S\xED.<pause:0.75> Esos despistados lograron contraer alg\xFAn
      tipo de enfermedad, y ahora la mitad del pueblo est\xE1 enferma."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143017
    m_Localized: Por eso tienen tanto miedo.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143018
    m_Localized: "Creen que se trata de alg\xFAn esp\xEDritu maligno, o que la gente
      de Clifford est\xE1 detr\xE1s de todo esto."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143019
    m_Localized: O ambas cosas.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143020
    m_Localized: "En realidad,<pause:0.5> podr\xEDamos ayudar."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143021
    m_Localized: "Rojo,<pause:0.5> tienes muchos talentos,<pause:0.5> pero no eres
      m\xE9dico."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143022
    m_Localized: "Y adem\xE1s, no somos precisamente bienvenidos aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143023
    m_Localized: "No, no, el gris.<pause:0.5> D\xE9jalo terminar."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143024
    m_Localized: "Entonces, \xBFqu\xE9 es exactamente lo que propones, naranja?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143025
    m_Localized: "\xA1Aqu\xED tienes todo tipo de hierbas,<pause:0.5> y yo tengo
      un mont\xF3n de utensilios de cocina conmigo!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143026
    m_Localized: "\xA1Y conozco la receta para gozar de buena salud!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143027
    m_Localized: "\xA1Podemos preparar la sopa de pollo m\xE1s sabrosa y curativa
      que este pueblo haya probado jam\xE1s!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143028
    m_Localized: Esa es...<pause:1> en realidad una muy buena idea.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143029
    m_Localized: "Un buen plato de sopa deber\xEDa ayudarles a sentirse mejor."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143030
    m_Localized: "Ver\xE9 si puedo convencer a los lugare\xF1os de que te aguanten
      un poco m\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143031
    m_Localized: Bueno,<pause:0.5> ya que estamos involucrados, puedo ayudar con
      las hierbas.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143032
    m_Localized: "\xBFSabes algo sobre hierbas?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143033
    m_Localized: "A mi madre le apasiona la florister\xEDa, as\xED que me ense\xF1\xF3
      un par de cosas."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143034
    m_Localized: "No s\xE9 para qu\xE9 se utilizan con fines medicinales, pero s\xED
      s\xE9 c\xF3mo recolectarlas."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143035
    m_Localized: Y puedo seguir instrucciones sin estorbar.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143036
    m_Localized: "Con eso bastar\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143037
    m_Localized: "Y puesto que ahora trabajamos juntos y ya no puedo ignorarte, deber\xEDamos
      presentarnos."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143038
    m_Localized: Adele.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143039
    m_Localized: Plata.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143040
    m_Localized: Rojo.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143041
    m_Localized: "Qu\xE9 original."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143042
    m_Localized: "Oh,<pause:0.5> cr\xE9eme,<pause:0.5> podr\xEDa haber sido mucho
      peor."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143043
    m_Localized: "\xBFQu\xE9 fue eso?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143044
    m_Localized: No te preocupes por eso.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143045
    m_Localized: "Vamos, Rojo y Plata,<pause:0.5> todav\xEDa tenemos mucho trabajo
      por hacer."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143046
    m_Localized: "Muy bien,<pause:0.5> todos nuestros ingredientes y hierbas est\xE1n
      a su disposici\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143047
    m_Localized: No me hagas arrepentirme de esto, naranja.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143048
    m_Localized: Lo tengo controlado.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143049
    m_Localized: "Preparar sopa medicinal no puede ser mucho m\xE1s dif\xEDcil que
      cocinar comida normal."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143050
    m_Localized: "Desde luego, espero que tengas raz\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143051
    m_Localized: "Estoy a punto de darles a esos g\xE9rmenes una paliza tal que no
      sabr\xE1n lo que les golpe\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143052
    m_Localized: "Oye, esto no es tan dif\xEDcil."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143053
    m_Localized: No celebres demasiado pronto, naranja.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143054
    m_Localized: "Todas las personas que han venido a verte hasta ahora no est\xE1n
      realmente enfermas todav\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143055
    m_Localized: Simplemente no se sienten muy bien.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143056
    m_Localized: "Les he tra\xEDdo a su primer paciente real."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143057
    m_Localized: "Env\xEDenlos."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143058
    m_Localized: "\xA1No voy a comer el veneno de Leshy!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143059
    m_Localized: No soy Leshy.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143060
    m_Localized: "\xA1Y yo tampoco le hago caso!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143061
    m_Localized: "*suspiro*<pause:0.75> Lo har\xE1s si quieres mejorar."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143062
    m_Localized: "\xA1Entonces elijo seguir enferma!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143063
    m_Localized: "No,<pause:0.5> t\xFA eliges mejorar, t\xFA<pause:0.5> imb\xE9cil
      desagradecido."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143064
    m_Localized: "Y eso no es una petici\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143065
    m_Localized: "Bien. Entonces, c\xE1llate la boca."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143066
    m_Localized: "No le hagas caso a las tonter\xEDas que dice este idiota."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143067
    m_Localized: Lleva con mucha fiebre desde ayer.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143068
    m_Localized: Y con su enfermedad, arruina la vida de todos los que le rodean.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143069
    m_Localized: "Cualquiera que se siente a su lado ser\xE1 m\xE1s dif\xEDcil de
      curar."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143070
    m_Localized: "Ens\xE9\xF1ame lo que tienes, naranja."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143071
    m_Localized: "\xA1Guau!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143072
    m_Localized: Los clientes enfermos son realmente un fastidio.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143073
    m_Localized: "Maldita sea,<pause:0.5> eso no fue f\xE1cil."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143074
    m_Localized: Te lo dije.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143075
    m_Localized: "Pero la fiebre es una de las enfermedades m\xE1s f\xE1ciles de
      tratar."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143076
    m_Localized: "La mezcla de setas contiene bayas de serbal. Deber\xEDan ayudarle
      a sentirse mejor."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143077
    m_Localized: Probar.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143078
    m_Localized: Bien,<pause:0.5> creo<pause:0.5> que empiezo a entenderlo.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143079
    m_Localized: "Bien,<pause:0.5> porque no tengo intenci\xF3n de cuidarte todo
      el d\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143080
    m_Localized: "Ll\xE1mame si algo sale mal."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143081
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> \xA1No,
      esto es rid\xEDculo!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143082
    m_Localized: No puedo trabajar en estas condiciones.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143083
    m_Localized: "\xA1Este paciente suyo es la mula m\xE1s terca del mundo!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143084
    m_Localized: "\xA1Es simplemente imposible!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143085
    m_Localized: "A veces creo que pide cualquier cosa menos lo que realmente necesita,
      solo por el gusto de ser dif\xEDcil."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143086
    m_Localized: Adele,<pause:0.5> Necesito que le grites.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143087
    m_Localized: "Esa s\xED que es una idea brillante.<pause:0.5> \xBFAlgo m\xE1s?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143088
    m_Localized: Quiero que le pegues.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143089
    m_Localized: Escucha, naranja.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143090
    m_Localized: "Vasya es un hueso duro de roer,<pause:0.5> no es f\xE1cil."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143091
    m_Localized: Pero tu hermano y yo ya tenemos bastante con lo que lidiar.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143092
    m_Localized: "No llegaremos muy lejos si tengo que ayudarte con cada paciente
      dif\xEDcil."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143093
    m_Localized: "Yo tengo mi propio trabajo,<pause:0.5> y t\xFA tienes el tuyo."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143094
    m_Localized: "As\xED que ve y enc\xE1rgate."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143095
    m_Localized: "\xA1Oye,<pause:0.5> soy quien est\xE1 salvando a tu pueblo de una
      epidemia!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143096
    m_Localized: "\xA1Podr\xEDa haber hecho exactamente lo que me dijiste!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143097
    m_Localized: "Si\xE9ntate tranquilamente en un rinc\xF3n,<pause:0.5> mientras
      los lugare\xF1os esperan medicinas de la ciudad \xA1y siguen enfermando cada
      vez m\xE1s!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143098
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> De acuerdo,
      de acuerdo,<pause:0.5> tienes raz\xF3n,<pause:0.5> lo siento."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143099
    m_Localized: Pero realmente no puedo dejar mi trabajo y estar yendo y viniendo
      constantemente.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143100
    m_Localized: "Entonces, dime de qu\xE9 otra manera se supone que debo comunicarme
      con \xE9l."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337280
    m_Localized: "\xBFQu\xE9 es este viejo naufragio?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337281
    m_Localized: "Esto es un horno.<pause:0.5> Sabes c\xF3mo usar uno de estos, \xBFverdad?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337282
    m_Localized: "S\xED, lo hago,<pause:0.5> pero \xBFc\xF3mo se supone que esto
      ayuda?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337283
    m_Localized: "Tiene el don de la persuasi\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337284
    m_Localized: "Si alguien prueba sus productos horneados, cambiar\xE1 de opini\xF3n
      inmediatamente, sin importar cu\xE1l fuera el motivo de la discusi\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337285
    m_Localized: "\xBFQu\xE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337286
    m_Localized: "Si solo quer\xEDas deshacerte de m\xED, podr\xEDas haberlo dicho."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337287
    m_Localized: "Te prometo que funcionar\xE1.<pause:0.5> Ahora ve,<pause:0.5> tus
      pacientes te est\xE1n esperando."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337288
    m_Localized: "Ojal\xE1 esto no sea una broma de mal gusto."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337289
    m_Localized: "Lo est\xE1 haciendo de nuevo."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337290
    m_Localized: "Muy bien,<pause:0.5> esta vez le dar\xE9 un pretzel."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337291
    m_Localized: "Y, como por arte de magia, cambiar\xE1 de opini\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337292
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Eso son\xF3
      tan tonto."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337293
    m_Localized: "\xA1Maldita sea!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337294
    m_Localized: "\xA1Realmente funciona!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337295
    m_Localized: Vaya.<pause:0.5> Este cerdito es realmente impaciente.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337296
    m_Localized: "Para servirle a tiempo, tendr\xE9 que encender el horno."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337297
    m_Localized: "S\xED,<pause:0.5> esto deber\xEDa funcionar."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337298
    m_Localized: "\xA1Con este horno, no le tengo miedo a nadie!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337299
    m_Localized: "\xA1Soy imparable!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337300
    m_Localized: "\xBFQu\xE9 demonios es eso?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337301
    m_Localized: Bueno,<pause:0.5> sea lo que sea todo ese ruido, no es mi problema.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337302
    m_Localized: Sobre todo cuando estoy de vacaciones.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337303
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Ahora.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337304
    m_Localized: "\xBFCrees que esto cuenta como remedio?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337305
    m_Localized: Probablemente no.<pause:0.5> Es solo sopa con hierbas.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337306
    m_Localized: "S\xED,<pause:0.5> pero entonces, \xBFqu\xE9 se puede considerar
      un remedio si no es una sopa con hierbas?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337307
    m_Localized: "Hmm,<pause:0.5> esa es<pause:0.75> una observaci\xF3n muy interesante."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337308
    m_Localized: "\xA1El aprendiz de alquimista ha superado a su maestro!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337309
    m_Localized: "\xA1Enfocar!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337310
    m_Localized: "\xA1Oh, vamos,<pause:0.5> fue divertido!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337311
    m_Localized: "\xA1La cocina no es lugar para bromas!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337312
    m_Localized: "\xA1Este es nuestro taller, y aqu\xED estamos creando cosas maravillosas!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337313
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Aun as\xED,
      fue gracioso."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337314
    m_Localized: Bien,<pause:0.5> fue un poco gracioso.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337315
    m_Localized: "\xA1Una peque\xF1a victoria!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337316
    m_Localized: "\xA1Eres un sinverg\xFCenza!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337317
    m_Localized: "\xBFEscuchaste eso?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337318
    m_Localized: "Esto no es ning\xFAn tipo de medicina para enfermedades,<pause:0.5>
      \xA1es solo una sopa com\xFAn y corriente!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337319
    m_Localized: "Bueno, no lo s\xE9, Vasya.<pause:0.5> En realidad me siento mejor
      despu\xE9s de tomar su brebaje."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337320
    m_Localized: "\xA1Y es la sopa m\xE1s rica que he probado en mi vida!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337321
    m_Localized: "Disfr\xFAtalo mientras puedas."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337322
    m_Localized: "Es obvio que nos est\xE1 engordando para que nosotras mismas tengamos
      mejor sabor."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337323
    m_Localized: "\xBFHas perdido completamente la cabeza?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337324
    m_Localized: "\xBFEn serio vas a acusar a Leshy de algo ahora?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337325
    m_Localized: "\xA1Nosotros mismos habr\xEDamos echado a ese Leshy si no fuera
      por esa maldita bruja!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337326
    m_Localized: No soy Le...
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337327
    m_Localized: "Espera, \xBFacabo de o\xEDr a alguien faltarle el respeto al gran
      Leshy?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337328
    m_Localized: "\xA1No fui yo!<pause:0.5> \xA1Fue todo suyo!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337329
    m_Localized: "\xBFYo?!<pause:0.5> \xA1Yo no hice nada!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337330
    m_Localized: Jeje.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337331
    m_Localized: '*suspiro*'
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337332
    m_Localized: "\xA1Se liber\xF3!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337333
    m_Localized: "\xA1S\xE1lvense todos!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337334
    m_Localized: "\xA1Corran por sus vidas!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337335
    m_Localized: "\xA1Oooh,<pause:0.5> qu\xE9 maravilloso!<pause:0.5> \xA1Tenemos
      invitados y todos ustedes han preparado un picnic peque\xF1o y encantador!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337336
    m_Localized: "Y nadie me invit\xF3. \xA1Sinverg\xFCenzas!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337337
    m_Localized: "\xA1Boris, vuelve a casa ya!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337338
    m_Localized: "Te llevaremos la comida a tu habitaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337339
    m_Localized: "\xBFVolver adentro?<pause:0.5> \xA1Oh, de ninguna manera!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337340
    m_Localized: "\xA1No me voy a perder toda la diversi\xF3n con nuestros nuevos
      y peludos amigos!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337341
    m_Localized: "Boris,<pause:0.5> te lo ruego,<pause:0.5> destrozar\xE1s todo este
      lugar."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337342
    m_Localized: "No seas tan dram\xE1tica, Adele.<pause:0.5> No estornudo tan fuerte."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337343
    m_Localized: "Me sentar\xE9 aqu\xED con ustedes.<pause:0.5> \xA1No molestar\xE9
      a nadie!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337344
    m_Localized: "\xA1Recibimos visitas muy pocas veces!<pause:0.5> \xA1No hay manera
      de que me lo pierda!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337345
    m_Localized: "Escucha con atenci\xF3n, Rojo."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337346
    m_Localized: Haz lo que sea necesario, pero no dejes que estornude.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337347
    m_Localized: Si se esfuerza demasiado, tendremos que reconstruir este lugar desde
      las ruinas.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337348
    m_Localized: "No te defraudar\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337349
    m_Localized: "El juramento del hipop\xF3tamo."
    m_Metadata:
      m_Items: []
  - m_Id: 95027885946068992
    m_Localized: "Oye, \xBFad\xF3nde vas?"
    m_Metadata:
      m_Items: []
  - m_Id: 95028971859763200
    m_Localized: "Quiero decir, \xBFa d\xF3nde vas?<pause:0.75> Acabas de pasar justo
      al lado de un letrero."
    m_Metadata:
      m_Items: []
  - m_Id: 95032048352387072
    m_Localized: "\xA1No hemos venido hasta aqu\xED para rendirnos ahora!"
    m_Metadata:
      m_Items: []
  - m_Id: 95060151254540288
    m_Localized: "No<pause:0.5>, este no es Clifford.<pause:0.5> Este es Riverside.<pause:0.5>
      \xBFVes?"
    m_Metadata:
      m_Items: []
  - m_Id: 95060151283900416
    m_Localized: "\xA1Ese maldito Clifforder trajo a Leshy a nuestro pueblo!"
    m_Metadata:
      m_Items: []
  - m_Id: 95060151283900417
    m_Localized: "\xBFYo? \xBFLeshy?"
    m_Metadata:
      m_Items: []
  - m_Id: 95060151283900418
    m_Localized: "\xA1Y ahora has decidido mandar a Leshy contra nosotros!"
    m_Metadata:
      m_Items: []
  - m_Id: 95336547382091776
    m_Localized: "Sobre todo despu\xE9s de haber molestado accidentalmente a los
      lugare\xF1os."
    m_Metadata:
      m_Items: []
  - m_Id: 95336547411451904
    m_Localized: "Exactamente.<pause:0.5> A menos que el malvado Leshy y el inmundo
      Clifforder quieran poner a prueba a\xFAn m\xE1s la paciencia de los lugare\xF1os."
    m_Metadata:
      m_Items: []
  - m_Id: 95703245004103680
    m_Localized: Ohhh,<pause:0.5> gracias a todos.
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463808
    m_Localized: "\xA1No me lo hab\xEDa pasado tan bien en mucho tiempo!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463809
    m_Localized: "En los \xFAltimos d\xEDas, todo el mundo ha estado tan ocupado
      y preocupado que casi olvid\xE9 lo que se sent\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463810
    m_Localized: "\xA1Y ahora estamos todos sentados en la misma mesa otra vez!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463811
    m_Localized: "\xA1Compartiendo comida deliciosa e historias!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463812
    m_Localized: "\xA1Y m\xEDrame!<pause:0.5> \xA1Ya puedo sentir que estoy mucho
      mejor!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463813
    m_Localized: "\xA1Todos nosotros!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463814
    m_Localized: "\xA1Todo es gracias a ustedes!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463816
    m_Localized: "\xA1Bravo por Leshy, el doctor!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463817
    m_Localized: "Vamos, Vasya,<pause:0.5> \xA1sabes lo que tienes que decir!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463819
    m_Localized: "\xA1Y ahora vengan aqu\xED, les dar\xE9 un abrazo a todos!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463820
    m_Localized: "Boris, \xBFqu\xE9 est\xE1s haciendo?"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463821
    m_Localized: "Por muy amable que haya sido Leshy hoy, \xA1sigue siendo un monstruo
      del bosque!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463822
    m_Localized: "\xA1Te comer\xE1!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463824
    m_Localized: "\xC9l ayud\xF3 a mis amigos, \xA1y lo voy a abrazar pase lo que
      pase!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463825
    m_Localized: "Boris,<pause:0.5> s\xE9 razonable,<pause:0.5> no lo hagas."
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463826
    m_Localized: Sentirse mejor no significa que uno se haya recuperado por completo.
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463827
    m_Localized: "\xA1Oh, deja de hacer el rid\xEDculo, cobarde!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463828
    m_Localized: "\xA1Ya voy!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463829
    m_Localized: "\xA1Espera un segundo!<pause:0.5> \xA1Entonces no es Leshy en absoluto!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463830
    m_Localized: "\xA1Es solo un zorrito gru\xF1\xF3n!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463831
    m_Localized: "\xA1Dios m\xEDo!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463832
    m_Localized: "\xBFPor qu\xE9 no me dijiste que no eras Leshy?"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463834
    m_Localized: "Espero que est\xE9s orgulloso de ti mismo."
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463835
    m_Localized: Por supuesto.
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463836
    m_Localized: Basta de peleas, zorritos.
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463837
    m_Localized: "Venga, hablemos de lo que vamos a hacer contigo a continuaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463838
    m_Localized: Oh...
    m_Metadata:
      m_Items: []
  - m_Id: 95707377475674112
    m_Localized: <volume:1>Hurra.
    m_Metadata:
      m_Items: []
  - m_Id: 95708385291427840
    m_Localized: "\xA1Hurra por la t\xEDa Adele, el Clifforder y el Leshy!"
    m_Metadata:
      m_Items: []
  - m_Id: 95711446944604160
    m_Localized: "\xA1Me da igual, aunque fuera el mism\xEDsimo diablo!"
    m_Metadata:
      m_Items: []
  - m_Id: 95711446944604161
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Voy a
      estallar de indignaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 95712882495479808
    m_Localized: Clifford
    m_Metadata:
      m_Items: []
  - m_Id: 96172734023884800
    m_Localized: "Holaaa, peque\xF1o zorro."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734023884801
    m_Localized: Hola, caballito.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734023884802
    m_Localized: "\xBFTe vas a la gran ciudad a triunfar, eh?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734023884803
    m_Localized: En realidad no,<pause:0.5> todo lo contrario.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734028079104
    m_Localized: "Nos cansamos tanto de intentar triunfar a lo grande en la ciudad
      que decidimos empezar en un lugar m\xE1s peque\xF1o."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734028079105
    m_Localized: "Clifford?<pause:0.5> \xA1\xBFPeque\xF1o?!"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734028079106
    m_Localized: "S\xED,<pause:0.5> siempre lo ha sido."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734028079107
    m_Localized: "Siempre pens\xE9 que era enorme."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734032273408
    m_Localized: "Silver dijo que Clifford tiene aproximadamente el tama\xF1o de
      un solo distrito en Metr\xF3polis."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734032273409
    m_Localized: Guau.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734032273410
    m_Localized: "Siempre he querido llegar all\xED,<pause:0.5> para ver una gran
      ciudad."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734032273411
    m_Localized: "Sab\xEDa que no era el m\xE1s grande que exist\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187968
    m_Localized: "Pero estaba seguro de que ten\xEDa que estar al menos entre los
      diez primeros."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187969
    m_Localized: Y ahora me dices esto.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187970
    m_Localized: Eso es bastante decepcionante.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187971
    m_Localized: "\xBFPor qu\xE9 no vas?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187972
    m_Localized: "No puedo,<pause:0.5> Todav\xEDa soy demasiado peque\xF1o."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187973
    m_Localized: "\xA1M\xEDrate a ti mismo!<pause:0.5> \xA1Eres grande y fuerte!"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187974
    m_Localized: "\xA1Me est\xE1s arrastrando a m\xED, a mi hermano y a todo este
      carro t\xFA solo!"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187975
    m_Localized: "Nooo,<pause:0.5> quiero decir que a\xFAn no tengo la edad suficiente."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187976
    m_Localized: "\xBFAlguna vez has intentado pedirle a alguien mayor que te lleve
      al centro de la ciudad?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187977
    m_Localized: No puedo.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187978
    m_Localized: "Mi padre lleva gente a Clifford y la trae de vuelta todos los d\xEDas."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187979
    m_Localized: "Algunos de nosotros vivimos aqu\xED pero trabajamos en la ciudad,<pause:0.5>
      como la t\xEDa Adele."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187980
    m_Localized: Y se supone que debo quedarme en el pueblo por si acaso.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187981
    m_Localized: "Mientras pap\xE1 no est\xE1, soy la \xFAnica que sabe manejar el
      carrito."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187982
    m_Localized: "Siempre me dice que me olvide de mis responsabilidades por un d\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187983
    m_Localized: "Para venir con \xE9l a la ciudad."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187984
    m_Localized: Pero simplemente no puedo.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187985
    m_Localized: "\xBFY si ocurre algo mientras estoy divirti\xE9ndome?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187986
    m_Localized: Como hoy, por ejemplo.<pause:0.5> Ustedes dos aparecieron de la
      nada.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187987
    m_Localized: "\xBFQui\xE9n te habr\xEDa llevado a la ciudad si yo no hubiera
      estado aqu\xED?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187988
    m_Localized: "Supongo que habr\xEDamos tenido que esperar hasta la ma\xF1ana
      e ir con tu padre."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187989
    m_Localized: Y esperar es algo que realmente no nos podemos permitir ahora mismo.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187990
    m_Localized: "Tenemos un pr\xE9stamo pendiente y necesitamos empezar a pagarlo
      lo antes posible."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187991
    m_Localized: Nos has ayudado mucho.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187992
    m_Localized: "Zorrito,<pause:0.5> \xBFc\xF3mo te llamas?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187993
    m_Localized: "Rojo.<pause:0.5> \xBFY el tuyo?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187994
    m_Localized: Soy Daisy.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187995
    m_Localized: Encantado de conocerte, Daisy.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187996
    m_Localized: "Rojo,<pause:0.5> \xBFC\xF3mo es vivir en una ciudad a\xFAn m\xE1s
      grande que Clifford?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187997
    m_Localized: "No es... el lugar m\xE1s seguro."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187998
    m_Localized: "Daisy,<pause: 0.5> \xBFPor qu\xE9 la gente de Riverside detesta
      tanto a Clifford, <pause:0.5> pero a\xFAn as\xED intenta llegar all\xED?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187999
    m_Localized: "No lo s\xE9.<pause:0.5> Siempre ha sido una relaci\xF3n complicada."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188000
    m_Localized: Y luego estaba todo ese asunto de la carretera nueva.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188001
    m_Localized: "\xBFQu\xE9 pas\xF3?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188002
    m_Localized: "No hace mucho, nos enteramos de que est\xE1n construyendo una carretera
      desde Clifford hasta la autopista principal."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188003
    m_Localized: "Est\xE1bamos todos emocionados, pensando que pasar\xEDa por nuestro
      pueblo y que por fin nos facilitar\xEDa el acceso a la ciudad."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188004
    m_Localized: "Pero resulta que lo est\xE1n construyendo a trav\xE9s del desierto
      en lugar de a trav\xE9s de nuestro bosque para ahorrar un poco de dinero."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188005
    m_Localized: "No dejo que nadie lo vea,<pause:0.5> pero<pause:0.5> entre t\xFA
      y yo,<pause:0.5> realmente doli\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188006
    m_Localized: "Si el pueblo tuviera una carretera y aunque solo fuera un coche,
      me preocupar\xEDa mucho menos."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188007
    m_Localized: "Yo sab\xEDa que los aldeanos no correr\xEDan peligro sin mi presencia."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188008
    m_Localized: Lo lamento.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188009
    m_Localized: Si alguna vez vienes a la ciudad,<pause:0.5> ven a visitarnos.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188010
    m_Localized: Vamos a abrir un restaurante.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188011
    m_Localized: "Todav\xEDa no le hemos puesto nombre, pero lo reconocer\xE1s cuando
      lo veas."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188012
    m_Localized: "\xA1Va a ser el lugar m\xE1s genial del mundo!<pause:0.5> No podr\xE1s
      perd\xE9rtelo."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188013
    m_Localized: "\xA1Wooow,<pause:0.5> eso suena incre\xEDble!"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188014
    m_Localized: "\xA1Me encantar\xEDa!"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188015
    m_Localized: "\xA1Y tu sopa estaba realmente deliciosa!"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188016
    m_Localized: "\xA1Sin duda me pasar\xE9 por all\xED si tengo la oportunidad!"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188017
    m_Localized: Es un trato.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188018
    m_Localized: "Oh,<pause:0.5> \xBFesa es la autopista con la parada de autob\xFAs?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188019
    m_Localized: "\xA1Exactamente!"
    m_Metadata:
      m_Items: []
  - m_Id: 96177215478325248
    m_Localized: Oh...
    m_Metadata:
      m_Items: []
  - m_Id: 96391525269921792
    m_Localized: Tengo que admitir que ustedes dos hicieron un excelente trabajo,
      zorritos.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087616
    m_Localized: Los habitantes de Riverside se sienten mucho mejor ahora.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087617
    m_Localized: Y tal vez ahora esta caza de brujas finalmente llegue a su fin.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087618
    m_Localized: "\xA1As\xED que al final s\xED que eres una bruja!"
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087619
    m_Localized: "Soy tan bruja como t\xFA eres Leshy."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087620
    m_Localized: "Soy adivina,<pause:0.5> y una p\xE9sima, por cierto.<pause:0.5>
      Pero bueno, todos los adivinos lo son."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087621
    m_Localized: "Pero para los lugare\xF1os, es todo lo mismo."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087622
    m_Localized: "Creer\xE1n con gusto la explicaci\xF3n m\xE1s inveros\xEDmil."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087623
    m_Localized: Me distrajiste.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087624
    m_Localized: "Ambos hab\xE9is trabajado duro y os hab\xE9is ganado una recompensa."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087625
    m_Localized: "Tengo cierta influencia tanto aqu\xED como en Clifford."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087626
    m_Localized: "Y resulta que tambi\xE9n tengo bastantes cositas interesantes."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087627
    m_Localized: Cada uno de ustedes tiene derecho a un deseo.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087628
    m_Localized: Elige sabiamente,<pause:0.5> pero no seas codicioso.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087629
    m_Localized: Quiero quedarme con ese horno.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087630
    m_Localized: "No pides favores peque\xF1os, \xBFverdad, Red?"
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087631
    m_Localized: Pero es un precio justo, teniendo en cuenta lo que has hecho.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087632
    m_Localized: "Adem\xE1s, de todas formas, lleva aqu\xED acumulando polvo."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087633
    m_Localized: Odio cocinar.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087634
    m_Localized: Es tuyo.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087635
    m_Localized: "\xBFY t\xFA, Silver?<pause:0.5> \xBFQu\xE9 quieres?"
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087636
    m_Localized: Quiero que nos lleves a Clifford lo antes posible.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087637
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Bien.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087638
    m_Localized: Tenemos un plan de respaldo para emergencias.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087639
    m_Localized: Supongo que hoy cumple con los requisitos.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087640
    m_Localized: "Pero si regresa quej\xE1ndose de que ustedes dos le hicieron pasar
      un mal rato..."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087641
    m_Localized: "\xA1Seremos unos caballeros perfectos!"
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087642
    m_Localized: Esa es la respuesta correcta.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087643
    m_Localized: "Empaca tus cosas,<pause:0.5> el pr\xF3ximo transporte a Clifford
      sale en diez minutos."
    m_Metadata:
      m_Items: []
  - m_Id: 96395963300732928
    m_Localized: "De todas formas, solo est\xE1bamos de paso."
    m_Metadata:
      m_Items: []
  - m_Id: 96395963321704448
    m_Localized: "No ten\xEDamos pensado quedarnos en este lugar perdido de Dios..."
    m_Metadata:
      m_Items: []
  - m_Id: 96784338562211840
    m_Localized: "Ribera del r\xEDo"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101652336640
    m_Localized: "\xA1Despierten, zorritos!"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696768
    m_Localized: "\xA1Ya casi llegamos!"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696769
    m_Localized: "\xBFEh?<pause:0.5> \xBFQu\xE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696770
    m_Localized: "\xA1Abre los ojos, Rojo!"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696771
    m_Localized: "\xA1Ya estamos aqu\xED!"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696772
    m_Localized: "\xA1Guau!"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696773
    m_Localized: "\xA1Desde aqu\xED arriba parece realmente enorme!"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696774
    m_Localized: "\xBFLo ves? \xA1Te lo dije!"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696775
    m_Localized: "\xA1Alg\xFAn d\xEDa vendr\xE9 aqu\xED por mi cuenta!"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696776
    m_Localized: "\xA1Y explorar\xE9 cada rinc\xF3n de Clifford!"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696777
    m_Localized: Pero tengo que volver a casa ahora.
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696778
    m_Localized: "Pronto oscurecer\xE1 y mi padre empezar\xE1 a preocuparse."
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696779
    m_Localized: "Lo siento, no puedo llevarte m\xE1s lejos."
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696780
    m_Localized: "Est\xE1 bien, cari\xF1o.<pause:0.5> Ya nos has ayudado m\xE1s que
      suficiente."
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696781
    m_Localized: "Desde aqu\xED podremos encontrar el camino a nuestro nuevo hogar."
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696782
    m_Localized: "\xBFNuestro nuevo hogar?"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696783
    m_Localized: "\xBFYa nos compraste un edificio?"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696784
    m_Localized: "Oh, no.<pause:0.5> Comprar una propiedad en l\xEDnea ser\xEDa demasiado
      imprudente."
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696785
    m_Localized: "\xA1Pero encontr\xE9 un lugar muy prometedor!"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696786
    m_Localized: "\xA1Y tengo un presentimiento muy bueno al respecto!"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696787
    m_Localized: "\xA1As\xED que podemos ir para all\xE1 ahora mismo!"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696788
    m_Localized: "\xBFEntonces a qu\xE9 estamos esperando?"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696789
    m_Localized: "\xA1Abre el camino!"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696790
    m_Localized: "\xA1Adi\xF3s, zorritos!"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696791
    m_Localized: "\xA1Adi\xF3s, Daisy!"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696792
    m_Localized: "\xA1Buen viaje, Daisy!"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696793
    m_Localized: Vamos, Rojo.
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696794
    m_Localized: Ese lugar no se va a inspeccionar solo.
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696795
    m_Localized: "\xA1Ser\xE1 mejor que empieces a temblar, casita!"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696796
    m_Localized: "\xA1No tienes ni idea de lo minuciosamente que te voy a inspeccionar!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
