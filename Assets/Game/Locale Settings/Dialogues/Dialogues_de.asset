%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogues_de
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 76c0caf3be1b6134fac28638aa766eea, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 96960955703296
    m_Localized: '*seufz*<pause:1> Ein neuer Tag, ein neuer Dollar.'
    m_Metadata:
      m_Items: []
  - m_Id: 102732733243392
    m_Localized: "Verdammt, dieser Junge scheint z\xE4h zu sein, er braucht mindestens
      zwei Eiscremes."
    m_Metadata:
      m_Items: []
  - m_Id: 102851926974464
    m_Localized: "Ein gro\xDFer Junge, was?<pause:0.75> Je gr\xF6\xDFer sie sind,
      desto tiefer fallen sie."
    m_Metadata:
      m_Items: []
  - m_Id: 102931308371968
    m_Localized: "Bl\xF6der alter Schrott."
    m_Metadata:
      m_Items: []
  - m_Id: 103157167448064
    m_Localized: "Ich muss den Dreck wegr\xE4umen."
    m_Metadata:
      m_Items: []
  - m_Id: 103200687546368
    m_Localized: "Wo ist der M\xFClleimer?"
    m_Metadata:
      m_Items: []
  - m_Id: 103255913947136
    m_Localized: Oh, <pause:0.5>, da bist du ja.
    m_Metadata:
      m_Items: []
  - m_Id: 103266819137536
    m_Localized: Verpisst euch, ihr kleinen Stinker!
    m_Metadata:
      m_Items: []
  - m_Id: 103795813146624
    m_Localized: "Oh, wow. Die erste komplexe Bestellung f\xFCr heute."
    m_Metadata:
      m_Items: []
  - m_Id: 103882635239424
    m_Localized: Trotzdem noch zu einfach.
    m_Metadata:
      m_Items: []
  - m_Id: 103985789952000
    m_Localized: "Die Zutaten m\xFCssen vermischt werden."
    m_Metadata:
      m_Items: []
  - m_Id: 104019986112512
    m_Localized: '*seufz*<pause:1> Ich frage mich, wie es wohl ist, richtige Gerichte
      zu kochen?'
    m_Metadata:
      m_Items: []
  - m_Id: 104142648532992
    m_Localized: Oh, jetzt beginnt das eigentliche Spiel.
    m_Metadata:
      m_Items: []
  - m_Id: 104186449649664
    m_Localized: "Es ist einfach.<pause:0.5> Dieses Ding erzeugt Gegenst\xE4nde,<pause:0.5>
      ich benutze sie."
    m_Metadata:
      m_Items: []
  - m_Id: 104222092845056
    m_Localized: Hauptsache ist, dass es nicht verstopft.
    m_Metadata:
      m_Items: []
  - m_Id: 104300811542528
    m_Localized: '*seufz*<pause:1> Jeden Tag zur gleichen Zeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 104452712456192
    m_Localized: Oh, du bist es wieder, Roter Koch.
    m_Metadata:
      m_Items: []
  - m_Id: 104546270601216
    m_Localized: 'Yarrr,<pause: 0.5> willkommen an Bord, junger Seemann.'
    m_Metadata:
      m_Items: []
  - m_Id: 104596988125184
    m_Localized: "Ich brauche deine Gr\xFC\xDFe nicht, Red <pause:0.5>NOT<pause:0.5>
      ein Koch."
    m_Metadata:
      m_Items: []
  - m_Id: 104702047051776
    m_Localized: Ich brauche schnellere, nicht lautere Arbeit.
    m_Metadata:
      m_Items: []
  - m_Id: 104734192197632
    m_Localized: "Wussten Sie, dass dies ein Restaurant f\xFCr Kinder ist?"
    m_Metadata:
      m_Items: []
  - m_Id: 104799568814080
    m_Localized: Pfft.<pause:0.5> Dieser Ort ist voller Piraten.
    m_Metadata:
      m_Items: []
  - m_Id: 104851519463424
    m_Localized: "Piraten sind ihnen zu gruselig, also ist es eindeutig etwas f\xFCr
      Erwachsene."
    m_Metadata:
      m_Items: []
  - m_Id: 104919387496448
    m_Localized: "Zumindest bist du daf\xFCr noch nicht zu alt."
    m_Metadata:
      m_Items: []
  - m_Id: 105019983683584
    m_Localized: "Ich bin im perfekten Alter f\xFCr diesen Ort, also: <pause:0.5>YEAH."
    m_Metadata:
      m_Items: []
  - m_Id: 105266793308160
    m_Localized: Und ich brauche ein paar Kalorien, um in Topform zu sein. Also,
      beeil dich, Red Cook.
    m_Metadata:
      m_Items: []
  - m_Id: 105471504703488
    m_Localized: "Pfft.<pause: 0.5> Nur weil du es getan hast, hei\xDFt das nicht,
      dass du es gut gemacht hast,<pause: 0.5> Rot <pause:0.5>NICHT<pause:0.5> ein
      Koch."
    m_Metadata:
      m_Items: []
  - m_Id: 105543625760768
    m_Localized: 'Yarrr,<pause: 0.5> wir hoffen, dich bald wiederzusehen, junger
      Seemann.'
    m_Metadata:
      m_Items: []
  - m_Id: 105608289345536
    m_Localized: "Oh, ja, z\xF6gern Sie nicht. Sie werden mich bald sehen."
    m_Metadata:
      m_Items: []
  - m_Id: 105693555351552
    m_Localized: "Und n\xE4chstes Mal werde ich es dir nicht so leicht machen."
    m_Metadata:
      m_Items: []
  - m_Id: 105789357449216
    m_Localized: "Wir sehen uns sp\xE4ter, Red <pause:0.5>NOT<pause:0.5> ein Koch."
    m_Metadata:
      m_Items: []
  - m_Id: 107592824283136
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Schlie\xDFlich."
    m_Metadata:
      m_Items: []
  - m_Id: 107662542004224
    m_Localized: Wow, schon wieder Pause!
    m_Metadata:
      m_Items: []
  - m_Id: 131328193486848
    m_Localized: Verdammt...<pause:1> Okay, versuchen wir es noch einmal.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674043346944
    m_Localized: Endlich ein Moment der Ruhe.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124160
    m_Localized: "Ahoi! <pause:0.75> Na, Matrose, hast du etwa gedacht, dein erster
      Tag w\xFCrde reibungslos verlaufen?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124161
    m_Localized: "Ich arbeite hier seit \xFCber einem Jahr."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124162
    m_Localized: "Arrr! <pause:0.75> Ich konnte da \xFCberhaupt nichts verstehen!<pause:0.75>
      Du klingst wie ein Landei!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124163
    m_Localized: "Ich m\xF6chte nicht so reden, wenn ich nicht an der Kasse stehe.
      Das ist l\xE4cherlich."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124164
    m_Localized: Wir sind im wirklichen Leben keine Piraten.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124165
    m_Localized: <volume:0>...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124166
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> *seufz*
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124167
    m_Localized: "Ahoi! Kapit\xE4n, ich bin seit \xFCber einem Jahr auf dieser Reise!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124168
    m_Localized: "<volume:1>Yarr!<pause:0.75> So ist es schon besser!<pause:0.75>
      Mach weiter so, und der Schatz l\xE4sst nicht lange auf sich warten!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124169
    m_Localized: "Wo wir gerade von Sch\xE4tzen sprechen\u2026 Ich wollte eigentlich
      \xFCber meine Bef\xF6rderung sprechen und\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124170
    m_Localized: Kopf hoch, Matrose!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124171
    m_Localized: "Ich wei\xDF nicht, was dir an Land zugesto\xDFen ist."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124172
    m_Localized: "Aber wenn du weiterhin so m\xFCrrisch heruml\xE4ufst, vergraulst
      du mir noch alle meine Kunden!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124173
    m_Localized: Es ist einfach...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124174
    m_Localized: ...mein Gesicht.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124175
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Tauber
      Mischling.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124176
    m_Localized: Bereits?!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124177
    m_Localized: "Ich schw\xF6re, die Pausen werden jeden Tag k\xFCrzer!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124178
    m_Localized: Ich werde es ihm zeigen.<pause:1> Ich werde es ihnen allen zeigen.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124179
    m_Localized: "Ich werde mein eigenes Restaurant er\xF6ffnen, sie alle einstellen
      und ihnen dann die k\xFCrzestm\xF6glichen Pausen geben."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124180
    m_Localized: "Und ich werde mir eine unglaublich lange Auszeit g\xF6nnen!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124181
    m_Localized: Aber ich werde es gar nicht benutzen wollen, so fantastisch wird
      meine Wohnung sein!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124182
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Bei n\xE4herer
      Betrachtung sollte ich es vielleicht etwas weniger beeindruckend gestalten."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124183
    m_Localized: Sonst wollen sie ihre Pausen gar nicht mehr machen.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124184
    m_Localized: Oh, <pause:0.75>, sie ist es wieder.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124185
    m_Localized: Sie braucht eine besondere Herangehensweise. Sie schaut, was die
      anderen essen, und bestellt dasselbe.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124186
    m_Localized: Das arme Ding neigt zum Zweifeln.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124187
    m_Localized: "So, jetzt geht's los.<pause:0.75> Eis f\xFCr alle!<pause:0.75>
      Und ich bin nicht mal ins Schwitzen gekommen!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124188
    m_Localized: <volume:0>...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124189
    m_Localized: Yarr, ist alles in Ordnung, junger Seemann?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124190
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Ich wollte
      mich nur bedanken!<pause:0.5> Sie waren sehr geduldig.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124191
    m_Localized: "Normalerweise fluchen Erwachsene, wenn ich gro\xDFe Zweifel habe."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124192
    m_Localized: Yarr, keine Sorge, junger Seemann, komm jederzeit wieder!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124193
    m_Localized: "Du bist gro\xDFartig!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124194
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Hm,<pause:0.75>
      vielleicht ist dieser Tag<pause:0.75> doch nicht so schlimm.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124195
    m_Localized: "Hey, Red, komm schon, wir m\xFCssen reden."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124196
    m_Localized: Hallo, Red.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124197
    m_Localized: Hallo Stan.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124198
    m_Localized: Meine Augen sitzen tiefer.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124199
    m_Localized: Oh.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124200
    m_Localized: Ja, <pause:0.75> ist besser.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124201
    m_Localized: Was wollten Sie also?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124202
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Ich muss
      gleich in den Essbereich gehen.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124203
    m_Localized: Was?!<pause:0.75> Nein!<pause:0.75> Ich erhebe Einspruch!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124204
    m_Localized: "Der Kapit\xE4n sagte, er w\xFCrde mich den Fischen zum Fra\xDF
      vorwerfen lassen, wenn ich es nicht tue."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124205
    m_Localized: Ich bin mir nicht ganz sicher, was das in einfachen Worten bedeutet,
      aber ich bin mir sicher, dass es nichts Gutes ist.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124206
    m_Localized: "Aber die Kinder sind ganz verr\xFCckt nach Peg-Leg Joe!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124207
    m_Localized: "Die werden diesen Laden verw\xFCsten, wenn sie dich in dem Kost\xFCm
      sehen!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124208
    m_Localized: Ich werde nicht in der Lage sein, so viele Kunden zu bedienen!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124209
    m_Localized: Wir brauchen mindestens drei Personen an der Kasse, um den Betrieb
      aufrechtzuerhalten!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124210
    m_Localized: Und heute bin ich auf mich allein gestellt!<pause:0.75> Erinnert
      euch, was letztes Mal passiert ist!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124211
    m_Localized: "Ich wei\xDF. Deshalb bin ich ja gekommen, um dar\xFCber zu sprechen."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124212
    m_Localized: Also,<pause:0.5>, haben Sie eigentlich einen Plan?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124213
    m_Localized: "Ja, Filmabend. Du ziehst die Vorh\xE4nge zu, du schaltest den Projektor
      ein, und ich sorge daf\xFCr, dass alle leise sind."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124214
    m_Localized: Filmabend, hm.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124215
    m_Localized: "Das bedeutet, ich muss mich um die Abendkarte inklusive Cocktails
      k\xFCmmern. Das wird nicht einfach."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124216
    m_Localized: "Immer noch einfacher, als wenn alle Kinder aus der ganzen Nachbarschaft
      gleichzeitig hierher gerannt k\xE4men."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124217
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Ja,<pause:0.5>
      du hast Recht.<pause:0.75> Du bist ein Genie, Stan.<pause:0.75> Los geht's.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124218
    m_Localized: Handeln.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124219
    m_Localized: Okay, versuchen wir es mal. Los!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124220
    m_Localized: Oh mein Gott, <pause:0.4> es ist Peg-Leg Joe!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124221
    m_Localized: Juhu, Peg-Leg Joe! Nimm mich mit!!!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124222
    m_Localized: Ich auch!!!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124223
    m_Localized: "Arrr!<pause:0.75> Peg-Leg Joe f\xFChlt sich heute nicht so gut,<pause:0.4>
      deshalb werden wir es geheim halten."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318464
    m_Localized: Oh, das ist nicht fair!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318465
    m_Localized: "Ich dachte, wir w\xFCrden Spa\xDF haben."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318466
    m_Localized: "Keine Sorge, junger Matrose, wir m\xFCssen nicht laut sein, um
      Spa\xDF zu haben!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318467
    m_Localized: "Zum Beispiel k\xF6nnten wir uns einen Zeichentrickfilm ansehen!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318468
    m_Localized: Cartoons sind gut.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318469
    m_Localized: Nur wenn es interessant ist!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318470
    m_Localized: Ich hoffe, da ist ein Seestern drin...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318471
    m_Localized: "Arrr, nat\xFCrlich ist das interessant! Aber wir werden es uns
      im Stillen ansehen. Abgemacht, junge Matrosen?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318472
    m_Localized: Handeln!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318473
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Es hat
      funktioniert!<pause:0.75> Es kam keine Zuschauermenge!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318474
    m_Localized: Hab ich's doch gesagt!<pause:0.75> Ein narrensicherer Plan!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318475
    m_Localized: "Jetzt bleibt nur noch eins \xFCbrig.<pause:0.75> Zur\xFCck an die
      Arbeit!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318476
    m_Localized: "Puh, junge Matrosen, wer m\xF6chte noch ein Eis?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318477
    m_Localized: <volume:0>...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318478
    m_Localized: "Sieht so aus, als h\xE4tten Sie bereits alles erledigt."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318479
    m_Localized: "K\xF6nnten Sie bitte leiser sein?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318480
    m_Localized: <volume:1>Wir versuchen zuzusehen.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318481
    m_Localized: Oh,<pause:0.5> Entschuldigung.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318482
    m_Localized: Ach, komm schon!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318483
    m_Localized: Hey,<pause:0.5>, wir waren noch nicht fertig mit dem Zuschauen!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318484
    m_Localized: <volume:0.5>Yarr!<pause:0.5> Was glaubt ihr eigentlich, was ihr
      hier tut, ihr Matrosen?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318485
    m_Localized: "Ich habe dir gesagt, du sollst Peg-Leg Joe losschicken, nicht,
      dass du hier herumh\xE4ngst!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318486
    m_Localized: Hey, junge Matrosen, Peg-Leg Joe hat sich die ganze Zeit hier versteckt!
      Kommt her, zeigt ihm, wie sehr ihr ihn liebt!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318487
    m_Localized: "<volume:0.5>Vorw\xE4rts, ihr Matrosen,<pause:0.75> bringt mir alle
      Sch\xE4tze der Welt!<pause:0.75> Hahahahaha!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318488
    m_Localized: Das ist Holzbein-Joe!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318489
    m_Localized: Lauf zu ihm!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318490
    m_Localized: Oh nein.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318491
    m_Localized: '*seufz* <pause:1> Startseite.'
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318492
    m_Localized: "H\xE4?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318493
    m_Localized: Was zum...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318494
    m_Localized: Silber
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318495
    m_Localized: Wenn du ohne Hut aus dem Haus gehst, sage ich's Mama.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318496
    m_Localized: NICHT
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318497
    m_Localized: neue Nachricht
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318498
    m_Localized: "Komm in die K\xFCche"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318499
    m_Localized: Hallo!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318500
    m_Localized: Dir ist schon klar, dass du nicht einfach so in meine Wohnung einbrechen
      kannst?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318501
    m_Localized: Es war entriegelt.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318502
    m_Localized: Und warum sitzt du hier im Dunkeln?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318503
    m_Localized: Ich bin in verspielter Stimmung.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318504
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318505
    m_Localized: "Oh, <pause:0.5> tu nicht so, als w\xFCrdest du dich nicht freuen,
      mich zu sehen."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318506
    m_Localized: Ich bin.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318507
    m_Localized: So.<pause:0.75> Warum bist du hier?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318508
    m_Localized: Kann ich nicht einfach mal vorbeischauen und nach meinem kleinen
      Bruder sehen?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318509
    m_Localized: Du kannst, aber du tust es nicht.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318510
    m_Localized: "Wow. Ist das wirklich so wenig, wie du von mir h\xE4ltst?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318511
    m_Localized: Okay,<pause:0.75>, du hast mich erwischt.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318512
    m_Localized: "Ich bin nicht ohne Grund hier. Ich habe einen Vorschlag f\xFCr
      Sie."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318513
    m_Localized: NEIN!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318514
    m_Localized: "Du hast mir nicht einmal zugeh\xF6rt."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318515
    m_Localized: NEIN!<pause:0.75> Ich bin raus aus dem Spiel!<pause:0.75> Ich bin
      jetzt nur noch ein ganz normaler Koch, erinnerst du dich?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318516
    m_Localized: Du servierst Eis in einem Kinderrestaurant. Du bist kein Koch.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318517
    m_Localized: "Ich \xFCbe viel zu Hause!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318518
    m_Localized: "Und ich wei\xDF, dass du gut bist."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318519
    m_Localized: Aber Koch zu sein ist kein Hobby, sondern ein Beruf.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318520
    m_Localized: Bist du nur hierher gekommen, um mich zu beleidigen?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512768
    m_Localized: Ich bin eigentlich gekommen, um Ihnen dabei zu helfen.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512769
    m_Localized: "Erstens gef\xE4llt mir das nicht. Und zweitens verstehst du \xFCberhaupt
      nichts vom Kochen."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512770
    m_Localized: Vielleicht nicht. Aber ich verstehe, dass du dein Ziel auf dem falschen
      Weg verfolgst.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512771
    m_Localized: Red,<pause:0.75> du kommst nicht hinterher.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512772
    m_Localized: "Noch schlimmer ist, dass das, was du gerade durchmachst, dich deinem
      Ziel nicht n\xE4her bringt."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512773
    m_Localized: Es treibt dich immer weiter weg.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512774
    m_Localized: Nein, das stimmt nicht!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512775
    m_Localized: Schau dir das an!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512776
    m_Localized: Sehen!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512777
    m_Localized: Mein Ziel
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512778
    m_Localized: Seht ihr?<pause:0.5> Ich bin schon auf halbem Weg!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512779
    m_Localized: "Ich schleppe mich ja nicht umsonst Tag f\xFCr Tag zu diesem verdammten
      Job!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512780
    m_Localized: Jeden Monat landet mehr und mehr Geld im Glas!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512781
    m_Localized: "Und wenn ich das voll habe, er\xF6ffne ich ein Restaurant, in dem
      ich die besten Gerichte der Gegend serviere!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512782
    m_Localized: Und die Angestellten bekommen unglaublich lange Pausen!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512783
    m_Localized: "Aber die Arbeit dort wird so fantastisch sein, dass niemand sie
      \xFCberhaupt einstellen will!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512784
    m_Localized: Und niemand wird jemals behaupten, Red sei kein richtiger Koch!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512785
    m_Localized: Niemand!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512786
    m_Localized: "Oh, du m\xFCrrischer kleiner Cupcake"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512787
    m_Localized: Ich bestreite nicht, dass du hart arbeitest.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512788
    m_Localized: Es ist genau umgekehrt. Du hast dich so tief ins Kochen vertieft,
      dass du vergessen hast, die Augen offen zu halten.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512789
    m_Localized: Red,<pause:0.5> Wie lange ist es her, dass du dir dieses Ziel gesetzt
      hast?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512790
    m_Localized: Vor anderthalb Jahren.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512791
    m_Localized: Haben Sie gesehen, wie stark die Preise seitdem gestiegen sind?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512792
    m_Localized: Nun ja, die Preise steigen immer ein bisschen.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512793
    m_Localized: "Schau dir nur an, wie viel die Ger\xE4te, die du damals mochtest,
      heute kosten."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512794
    m_Localized: Ach komm schon, so schlimm kann es doch nicht sein.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512795
    m_Localized: "Mit deiner Sturheit k\xF6nntest du bestimmt Berge versetzen."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512796
    m_Localized: Wenn du aber so weitermachst, entfernst du dich immer weiter von
      deinem Ziel.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512797
    m_Localized: Die Kosten steigen schneller, als du verdienst.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512798
    m_Localized: Was soll ich denn nun tun?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512799
    m_Localized: Handeln Sie.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512800
    m_Localized: Das reicht noch nicht aus, um Ihre gesamte Vision abzudecken.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512801
    m_Localized: "Aber es ist ein ordentliches Startkapital f\xFCr etwas Bescheideneres."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512802
    m_Localized: 'Zum Beispiel: <pause:0.75> ein kleines Restaurant in einer kleineren
      Stadt.'
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512803
    m_Localized: "Ich habe bereits einen vielversprechenden Platz ausfindig gemacht.
      Unser Geld w\xFCrde die Anzahlung decken."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512804
    m_Localized: Anzahlung?<pause:0.75> Ein Kredit klingt ziemlich<pause:0.5> riskant.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512805
    m_Localized: "Nat\xFCrlich, aber du wei\xDFt ja, wie das l\xE4uft. Ohne Risiko
      kein Gewinn."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512806
    m_Localized: "Wei\xDFt du was?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512807
    m_Localized: Sie haben Recht!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512808
    m_Localized: "Verdammt nochmal, das Eiscaf\xE9!<pause:0.75> Verdammt nochmal,
      alle!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512809
    m_Localized: Wenn ich noch einen Tag lang wie ein Pirat reden muss, drehe ich
      durch!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512810
    m_Localized: Das ist die richtige Einstellung!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512811
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Und was
      springt f\xFCr dich dabei raus?<pause:0.75> Warum solltest du mir helfen?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512812
    m_Localized: Nun ja, zuallererst, weil ich mir Sorgen um meinen kleinen Bruder
      mache.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512813
    m_Localized: "Der w\xFCrde sich ohne mich ganz sicher in Schwierigkeiten bringen."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512814
    m_Localized: "Und zweitens m\xF6chte ich einen Anteil."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707072
    m_Localized: Ich glaube dir nicht!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707073
    m_Localized: "Man kann praktisch aus dem Nichts Geld sch\xF6pfen!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707074
    m_Localized: Warum sollte man Anteile an irgendeinem beliebigen Restaurant erwerben
      wollen?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707075
    m_Localized: "Oh, hast du etwa wirklich geglaubt, ich w\xFCrde nie erwachsen
      werden?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707076
    m_Localized: "Dass ich mich nicht niederlassen m\xF6chte?<pause:0.75> Habe ich
      eine legitime Einkommensquelle?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707077
    m_Localized: "Du verletzst meine Gef\xFChle."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707078
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707079
    m_Localized: Was?<pause:0.75> Glaubst du wirklich, ich versuche, dich hereinzulegen?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707080
    m_Localized: Wie oft habe ich jemals versucht, dich zu verletzen?<pause:0.75>
      Dich auszurauben?<pause:0.75> Dich in eine Falle zu locken?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707081
    m_Localized: Nicht ein einziges Mal.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707082
    m_Localized: Worauf wartest du dann noch?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707083
    m_Localized: Partner?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707084
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Okay,<pause:0.75>
      Partner!
    m_Metadata:
      m_Items: []
  - m_Id: 39890501168685056
    m_Localized: Und ihr unglaubliches Abenteuer hat begonnen!
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377408
    m_Localized: "Das reicht aus, um sich um die meisten von ihnen zu k\xFCmmern."
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377409
    m_Localized: "Dieses Ger\xE4t zeigt mir, wie viele Kunden ich noch zufriedenstellen
      muss."
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377410
    m_Localized: Oh je.<pause:0.5> Es kamen so viele Kinder, dass sie nicht alle
      hineinpassten.
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377411
    m_Localized: "Einige von ihnen warten darauf, dass ein Platz frei wird, bevor
      sie eine Bestellung aufgeben k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377412
    m_Localized: "Dieses Ding zeigt an, wer als N\xE4chster an der Reihe ist."
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377413
    m_Localized: "Manchmal hilft es, Zeit zu gewinnen, aber \xFCbertreibe es nicht."
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377414
    m_Localized: Die Kunden in der Schlange haben auch Geduld.
    m_Metadata:
      m_Items: []
  - m_Id: 76866541631725568
    m_Localized: Normalerweise muss ich nicht jeden einzelnen Kunden bedienen.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020216782848
    m_Localized: "Wow, was f\xFCr eine Reise!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948672
    m_Localized: Und wo stehen wir jetzt?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948673
    m_Localized: Irgendwo nicht allzu weit von Clifford entfernt.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948674
    m_Localized: "Der Empfang ist hier drau\xDFen wirklich schlecht."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948675
    m_Localized: "Wir m\xFCssen also von hier an improvisieren."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948676
    m_Localized: Nehmen Sie einen anderen Bus oder fragen Sie die Einheimischen nach
      dem Weg.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948677
    m_Localized: <volume:0>...
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948678
    m_Localized: "<volume:1>Obwohl<pause:1> das ein kleines Problem sein k\xF6nnte."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948679
    m_Localized: Haben wir uns verirrt?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948680
    m_Localized: Ach, sei doch nicht so dramatisch.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948681
    m_Localized: "Im schlimmsten Fall warten wir hier auf den n\xE4chsten Bus und
      fahren zur\xFCck."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948682
    m_Localized: Auf keinen Fall!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948685
    m_Localized: "Um dieses bl\xF6de St\xE4dtchen zu finden."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948686
    m_Localized: Und wenn ich dort ankomme, werde ich eine wahnsinnige Menge Spaghetti
      kochen!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948687
    m_Localized: "Und die Einheimischen werden jeden einzelnen Bissen davon aufessen
      m\xFCssen!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948688
    m_Localized: Und sie werden es lieben!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948689
    m_Localized: '!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948691
    m_Localized: Oh.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948692
    m_Localized: Da steht, Clifford wohnt gleich am Ende dieses Weges.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948693
    m_Localized: Worauf warten wir also noch?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948694
    m_Localized: Zittert, ihr Bewohner von Clifford!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948695
    m_Localized: Rot kommt!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948696
    m_Localized: "Und der gro\xDFe und schreckliche Rotk\xE4ppchen hat keine Angst
      vor einem so unheimlichen Wald?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948697
    m_Localized: Ein wenig.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948698
    m_Localized: "Aber es ist nicht so be\xE4ngstigend wie die Umkehr!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948699
    m_Localized: Ich bin mir sicher, dass es nicht so schlimm ist, wie es aussieht.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948700
    m_Localized: "Noch ein letzter Kraftakt, und nach der Reise k\xF6nnen wir uns
      in Clifford entspannen."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948701
    m_Localized: "Und Cocktails mit kleinen Schirmchen schl\xFCrfen?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948702
    m_Localized: "Und Cocktails mit kleinen Schirmchen schl\xFCrfen."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948703
    m_Localized: "S\xFC\xDF."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948704
    m_Localized: Wann hast du deinen Hut gewechselt?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948705
    m_Localized: Als aus unserem Roadtrip eine Wanderung wurde, du Dummkopf.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948706
    m_Localized: Sehen.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948707
    m_Localized: Ich glaube, wir haben es geschafft.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948709
    m_Localized: Verdammt.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948710
    m_Localized: Hey, [PLACEHOLDER_0__], sieh es positiv! Wenigstens sind wir nicht
      mehr verloren!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948711
    m_Localized: Und schau dir das an!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948712
    m_Localized: Ein Einheimischer!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948713
    m_Localized: Hallo.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948714
    m_Localized: AAAH!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948716
    m_Localized: Wir sind dem Untergang geweiht!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948718
    m_Localized: Beweg dich nicht, Waldmonster!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948719
    m_Localized: Ja, ganz bestimmt du.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948720
    m_Localized: Ruhe, du dreckiger Clifforder!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948721
    m_Localized: Zuerst hast du uns Krankheiten gebracht!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948723
    m_Localized: Das werden wir nicht zulassen!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948724
    m_Localized: "Ich glaube, hier liegt ein gro\xDFes Missverst\xE4ndnis vor."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948725
    m_Localized: Wir kommen nicht aus Clifford. Wir wollten eigentlich gerade gehen.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948726
    m_Localized: Nach allem, was du getan hast, kommst du nicht so einfach davon!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142976
    m_Localized: Oh je.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142977
    m_Localized: Okay, [PLATZHALTER_0] teilen Sie es auf. [PLATZHALTER_1] Hier gibt
      es nichts zu sehen.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142978
    m_Localized: Diese beiden kommen mit mir.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142979
    m_Localized: Aber sie kommen aus Clifford!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142980
    m_Localized: Woher sie kommen, geht dich nichts an. Du hast heute noch genug
      zu tun!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142981
    m_Localized: Ihr alle!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142982
    m_Localized: Aber!..
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142983
    m_Localized: Keine Widerrede!<pause:0.75> Hat dich denn schon lange niemand mehr
      verflucht?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142984
    m_Localized: Tch!<pause:0.5> Hexe!<pause:0.5> Na los,<pause:0.5> die Alte hat
      sich ein neues Paar Spielzeuge gefunden.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142985
    m_Localized: "WER NENNST DU HIER EINE HEXE, DU SCH\xC4DLING?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142986
    m_Localized: Oh je!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142987
    m_Localized: "*seufzt* Folgt mir, bevor sie es sich anders \xFCberlegen."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142988
    m_Localized: "Deine Wohnung ist so gem\xFCtlich!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142989
    m_Localized: "Was ist das alles f\xFCr Zeug in den Regalen?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142990
    m_Localized: "Die Antiquit\xE4ten d\xFCrfen nicht ber\xFChrt werden."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142991
    m_Localized: Das hatte ich nicht vor.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142992
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142993
    m_Localized: "Vielen Dank, dass Sie sich f\xFCr uns eingesetzt haben."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142994
    m_Localized: "Ja, [PLACEHOLDER_0__], ohne dich h\xE4tten sie uns lebendig aufgefressen."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142995
    m_Localized: "*seufz* <pause:0.5> Sie h\xE4tten niemanden gefressen,<pause:0.5>
      sie sind keine Monster."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142996
    m_Localized: "Sie sind einfach nur nerv\xF6s."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142997
    m_Localized: "H\xF6chstwahrscheinlich h\xE4tten sie dich einfach aus Riverside
      vertrieben."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142998
    m_Localized: "Im schlimmsten Fall h\xE4tten sie dir ein paar \xFCble Dinge hinterhergerufen."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142999
    m_Localized: Eigentlich passt es uns.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143000
    m_Localized: Wir waren sowieso nur auf der Durchreise. Wir hatten nicht vor,
      in diesem gottverlassenen Ort zu verweilen...
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143001
    m_Localized: Schade.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143002
    m_Localized: "Es w\xE4re schade, einen so sch\xF6nen Ort so \xFCberst\xFCrzt
      verlassen zu m\xFCssen."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143004
    m_Localized: "Du solltest besser auf die \xC4lteren h\xF6ren, du Orangener."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143005
    m_Localized: "Und du solltest es sowieso nicht so eilig haben. Der Weg, der vor
      dir liegt, ist noch schwieriger als der, der dich hierher gef\xFChrt hat."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143006
    m_Localized: Habe ich Recht mit der Annahme, dass Sie nach Clifford fahren?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143007
    m_Localized: Jawohl, Ma'am!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143008
    m_Localized: Seltsame Wahl, aber das ist Ihre Sache.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143009
    m_Localized: "Unser Arbeitspferd ist bereits zu Clifford gefahren, um Medizin
      zu holen. Er wird erst sp\xE4t heute Abend zur\xFCck sein."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143010
    m_Localized: "Die n\xE4chste Fahrt in die Stadt findet morgen fr\xFCh statt."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143011
    m_Localized: "Bis dahin sollten wir also besser an Ort und Stelle bleiben und
      uns unauff\xE4llig verhalten?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143013
    m_Localized: Perfekt!<pause:0.75> Dann setzen wir uns hier ruhig hin und halten
      uns von allen fern.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143014
    m_Localized: Schlauer kleiner Fuchs.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143015
    m_Localized: Sie warten auf Medikamente aus der Stadt. Sind sie krank?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143016
    m_Localized: "Ja.<pause:0.75> Diese Zerstreuten haben es geschafft, sich irgendeine
      Krankheit einzufangen, und jetzt ist die H\xE4lfte des Dorfes daran erkrankt."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143017
    m_Localized: "Deshalb haben sie so gro\xDFe Angst."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143018
    m_Localized: "Sie glauben, es handele sich um einen b\xF6sen Geist, oder dass
      die Einwohner von Clifford dahinterstecken."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143019
    m_Localized: Oder beides.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143020
    m_Localized: "Tats\xE4chlich k\xF6nnten wir helfen."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143021
    m_Localized: Red,<pause:0.5> du hast viele Talente,<pause:0.5> aber du bist kein
      Arzt.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143022
    m_Localized: "Und au\xDFerdem sind wir hier nicht gerade willkommen."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143023
    m_Localized: Nein, nein, der Graue.<pause:0.5> Lass ihn ausreden.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143024
    m_Localized: "Also, was genau schl\xE4gst du vor, du Oranger?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143025
    m_Localized: "Du hast hier alle m\xF6glichen Kr\xE4uter, und ich habe eine ganze
      Menge Kochutensilien dabei!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143026
    m_Localized: "Und ich kenne das Rezept f\xFCr gute Gesundheit!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143027
    m_Localized: "Wir k\xF6nnen die leckerste und heilsamste H\xFChnersuppe kochen,
      die dieses Dorf je gegessen hat!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143028
    m_Localized: Das ist...<pause:1> eigentlich eine ziemlich gute Idee.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143029
    m_Localized: "Eine gute Sch\xFCssel Suppe sollte ihnen wirklich helfen, sich
      besser zu f\xFChlen."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143030
    m_Localized: "Ich werde sehen, ob ich die Einheimischen davon \xFCberzeugen kann,
      dich noch eine Weile zu dulden."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143031
    m_Localized: "Nun ja, da wir ja schon dabei sind, kann ich bei den Kr\xE4utern
      helfen."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143032
    m_Localized: "Kennst du dich mit Kr\xE4utern aus?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143033
    m_Localized: Unsere Mutter ist total begeistert von Floristik, deshalb hat sie
      mir auch einiges beigebracht.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143034
    m_Localized: "Ich wei\xDF nicht, wof\xFCr sie medizinisch verwendet werden, aber
      ich wei\xDF, wie man sie sammelt."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143035
    m_Localized: Und ich kann Anweisungen befolgen, ohne dabei im Weg zu stehen.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143036
    m_Localized: Das reicht.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143037
    m_Localized: "Und da wir nun zusammenarbeiten und ich dich nicht l\xE4nger ignorieren
      kann, sollten wir uns vorstellen."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143038
    m_Localized: Adele.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143039
    m_Localized: Silber.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143040
    m_Localized: Rot.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143041
    m_Localized: Wie originell.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143042
    m_Localized: "Oh, glaub mir, es h\xE4tte viel schlimmer kommen k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143043
    m_Localized: Was war das?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143044
    m_Localized: Mach dir keine Sorgen.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143045
    m_Localized: Auf geht's, Rot und Silber, wir haben noch viel zu tun.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143046
    m_Localized: "Okay, alle unsere Zutaten und Kr\xE4uter stehen Ihnen zur Verf\xFCgung."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143047
    m_Localized: Lass mich das nicht bereuen, du Orange.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143048
    m_Localized: Ich kriege das hin.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143049
    m_Localized: Die Zubereitung von Heilsuppe kann nicht viel schwieriger sein als
      die Zubereitung normaler Mahlzeiten.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143050
    m_Localized: Ich hoffe sehr, dass Sie Recht haben.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143051
    m_Localized: "Ich werde diesen Keimen so eine Tracht Pr\xFCgel verpassen, dass
      sie nicht wissen werden, wie ihnen geschieht."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143052
    m_Localized: Hey, das ist gar nicht so schwer.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143053
    m_Localized: "Feier nicht zu fr\xFCh, du Orange."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143054
    m_Localized: Alle, die bisher zu Ihnen gekommen sind, sind noch nicht wirklich
      krank.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143055
    m_Localized: "Sie f\xFChlen sich einfach ein bisschen unwohl."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143056
    m_Localized: Ich habe Ihnen Ihren ersten richtigen Patienten gebracht.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143057
    m_Localized: Schickt sie ein.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143058
    m_Localized: Ich esse Leshys Gift nicht!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143059
    m_Localized: Ich bin nicht Leshy.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143060
    m_Localized: "Und ich h\xF6re ihm auch nicht zu!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143061
    m_Localized: '*seufz*<pause:0.75> Das wirst du, wenn du gesund werden willst.'
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143062
    m_Localized: "Dann beschlie\xDFe ich, krank zu bleiben!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143063
    m_Localized: Nein, wenn du dich entscheidest, gesund zu werden, du undankbarer
      Idiot.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143064
    m_Localized: Und das ist keine Bitte.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143065
    m_Localized: Gut. Dann halt den Mund.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143066
    m_Localized: Ignoriere den Unsinn, den dieser Idiot von sich gibt.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143067
    m_Localized: Er hat seit gestern hohes Fieber.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143068
    m_Localized: Und durch seine Krankheit verdirbt er das Leben aller Menschen um
      ihn herum.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143069
    m_Localized: Jeder, der neben ihm sitzt, wird schwerer zu heilen sein.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143070
    m_Localized: Zeig mir, was du hast, du Orangener.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143071
    m_Localized: Wow!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143072
    m_Localized: "Kranke Kunden sind wirklich l\xE4stig."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143073
    m_Localized: Verdammt, das war nicht einfach.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143074
    m_Localized: Hab ich's doch gesagt!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143075
    m_Localized: "Fieber hingegen geh\xF6rt zu den leichter zu behandelnden Krankheiten."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143076
    m_Localized: "Die Pilzmischung enth\xE4lt Ebereschenbeeren. Diese sollten ihm
      helfen, sich besser zu f\xFChlen."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143077
    m_Localized: Probier es aus.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143078
    m_Localized: Okay, ich glaube, ich fange an, es zu verstehen.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143079
    m_Localized: Gut, <pause:0.5>, denn ich habe nicht vor, dich den ganzen Tag zu
      babysitten.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143080
    m_Localized: Ruf mich an, falls etwas schiefgeht.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143081
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Nein,
      das ist einfach l\xE4cherlich!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143082
    m_Localized: Unter diesen Bedingungen kann ich nicht arbeiten.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143083
    m_Localized: "Dieser Patient von Ihnen ist das st\xF6rrischste Esel der Welt!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143084
    m_Localized: "Das ist einfach unm\xF6glich!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143085
    m_Localized: "Manchmal habe ich das Gef\xFChl, er verlangt alles M\xF6gliche,
      nur um schwierig zu sein, au\xDFer dem, was er eigentlich braucht."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143086
    m_Localized: Adele, ich brauche dich, um ihn anzuschreien.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143087
    m_Localized: Das ist ja eine geniale Idee! Noch etwas?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143088
    m_Localized: "Ich will, dass du ihn schl\xE4gst."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143089
    m_Localized: "H\xF6r mal zu, du Oranger."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143090
    m_Localized: Vasya ist ein harter Brocken, er ist nicht einfach zu knacken.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143091
    m_Localized: "Aber dein Bruder und ich haben schon alle H\xE4nde voll zu tun."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143092
    m_Localized: Wir kommen nicht weit, wenn ich Ihnen bei jedem schwierigen Patienten
      helfen muss.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143093
    m_Localized: Ich habe meine eigene Arbeit,<pause:0.5>, und du hast deine.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143094
    m_Localized: "Also, k\xFCmmere dich darum."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143095
    m_Localized: Hey,<pause:0.5>, ich bin derjenige, der dein Dorf hier vor einer
      Epidemie rettet!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143096
    m_Localized: "Ich h\xE4tte genau das tun k\xF6nnen, was du mir gesagt hast!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143097
    m_Localized: "Setz dich ruhig in eine Ecke, w\xE4hrend die Einheimischen auf
      Medikamente aus der Stadt warten und immer kr\xE4nker werden!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143098
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Okay, okay,<pause:0.5>
      du hast Recht,<pause:0.5> es tut mir leid.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143099
    m_Localized: "Aber ich kann meine Arbeit wirklich nicht unterbrechen und st\xE4ndig
      hin und her rennen."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143100
    m_Localized: Dann sag mir, wie ich ihn sonst erreichen soll.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337280
    m_Localized: "Was ist das f\xFCr ein altes Wrack?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337281
    m_Localized: "Das ist ein Backofen.<pause:0.5> Du wei\xDFt, wie man so etwas
      benutzt, oder?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337282
    m_Localized: Ja, das tue ich, aber wie soll das helfen?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337283
    m_Localized: "Es besitzt die Gabe der \xDCberzeugung."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337284
    m_Localized: "Wer die Backwaren probiert, \xE4ndert sofort seine Meinung, egal
      wor\xFCber der Streit eigentlich gef\xFChrt wurde."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337285
    m_Localized: Was?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337286
    m_Localized: "Wenn du mich einfach nur loswerden wolltest, h\xE4ttest du das
      sagen k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337287
    m_Localized: Ich verspreche, es wird funktionieren. <pause:0.5> Jetzt geh,<pause:0.5>
      deine Patienten warten.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337288
    m_Localized: Hoffentlich ist das kein grausamer Scherz.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337289
    m_Localized: Er tut es schon wieder.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337290
    m_Localized: Okay, dieses Mal gebe ich ihm eine Brezel.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337291
    m_Localized: "Und wie durch Zauberhand wird er seine Meinung \xE4ndern."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337292
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Das klang
      so albern.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337293
    m_Localized: Na sowas!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337294
    m_Localized: "Es funktioniert tats\xE4chlich!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337295
    m_Localized: Wow.<pause:0.5> Dieses Schweinchen ist aber ungeduldig.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337296
    m_Localized: Um ihn rechtzeitig zu bedienen, muss ich den Ofen anheizen.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337297
    m_Localized: Ja, <pause:0.5> sollte funktionieren.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337298
    m_Localized: Mit diesem Ofen habe ich vor niemandem mehr Angst!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337299
    m_Localized: Ich bin unaufhaltsam!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337300
    m_Localized: Was zum Teufel ist das?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337301
    m_Localized: "Nun, was auch immer der Grund f\xFCr diesen ganzen L\xE4rm sein
      mag, es ist nicht mein Problem."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337302
    m_Localized: Vor allem, wenn ich Pause habe.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337303
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Jetzt.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337304
    m_Localized: "Halten Sie das f\xFCr ein Heilmittel?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337305
    m_Localized: "Vermutlich nicht.<pause:0.5> Es ist nur Suppe mit Kr\xE4utern."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337306
    m_Localized: "Ja, aber was z\xE4hlt denn dann als Heilmittel, wenn nicht eine
      Suppe mit Kr\xE4utern?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337307
    m_Localized: Hmm, das ist eine sehr interessante Beobachtung.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337308
    m_Localized: "Der Lehrling im Zaubertrankbrauen hat seinen Meister \xFCbertroffen!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337309
    m_Localized: Fokus!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337310
    m_Localized: Ach komm schon, das war doch lustig!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337311
    m_Localized: "In der K\xFCche ist kein Platz f\xFCr Albernheiten!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337312
    m_Localized: "Dies ist unsere Werkstatt, und hier entstehen gro\xDFartige Dinge!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337313
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Es war
      trotzdem lustig.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337314
    m_Localized: Na gut, es war schon etwas witzig.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337315
    m_Localized: Ein kleiner Sieg!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337316
    m_Localized: Du bist ein Schuft!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337317
    m_Localized: "Hast du das geh\xF6rt?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337318
    m_Localized: Das ist kein Medikament gegen Krankheiten, sondern nur eine ganz
      normale Suppe!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337319
    m_Localized: "Nun, ich wei\xDF nicht, Vasya. \u2013 Mir geht es tats\xE4chlich
      besser, nachdem ich sein Gebr\xE4u getrunken habe."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337320
    m_Localized: Und es ist die leckerste Suppe, die ich je gegessen habe!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337321
    m_Localized: "Genie\xDFe es, solange du kannst."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337322
    m_Localized: "Es ist offensichtlich, dass er uns m\xE4stet, damit wir selbst
      besser schmecken."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337323
    m_Localized: Hast du komplett den Verstand verloren?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337324
    m_Localized: Du willst Leshy jetzt ernsthaft irgendetwas vorwerfen?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337325
    m_Localized: "Wir h\xE4tten Leshy selbst rausgeschmissen, wenn diese verdammte
      Hexe nicht gewesen w\xE4re!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337326
    m_Localized: Ich bin nicht Le...
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337327
    m_Localized: "Moment mal, habe ich da gerade jemanden den gro\xDFen Leshy respektlos
      behandeln h\xF6ren?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337328
    m_Localized: Ich war's nicht!<pause:0.5> Er war's!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337329
    m_Localized: Ich?!<pause:0.5> Ich habe nichts getan!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337330
    m_Localized: Hehe.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337331
    m_Localized: '*seufzen*'
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337332
    m_Localized: Er konnte sich befreien!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337333
    m_Localized: Jeder rettet sich selbst!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337334
    m_Localized: Rennt um euer Leben!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337335
    m_Localized: "Oh, wie wunderbar! Wir haben G\xE4ste, und ihr habt alle so ein
      sch\xF6nes kleines Picknick zusammengestellt!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337336
    m_Localized: Und mich hat niemand eingeladen. Ihr Schlingel.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337337
    m_Localized: Boris, geh jetzt nach Hause!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337338
    m_Localized: Wir bringen Ihnen Ihr Essen.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337339
    m_Localized: Wieder hineingehen?<pause:0.5> Oh, auf keinen Fall!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337340
    m_Localized: "Ich verpasse keinen einzigen Spa\xDF mit unseren neuen flauschigen
      Freunden!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337341
    m_Localized: Boris, ich flehe dich an, du wirst diesen ganzen Laden in Schutt
      und Asche legen.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337342
    m_Localized: "\xDCbertreib nicht, Adele.<pause:0.5> Ich niese nicht so heftig."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337343
    m_Localized: "Ich setze mich einfach hier zu euch. Ich werde niemanden st\xF6ren!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337344
    m_Localized: Wir bekommen so selten Besuch!<pause:0.5> Das darf ich auf keinen
      Fall verpassen!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337345
    m_Localized: "H\xF6r gut zu, Red."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337346
    m_Localized: "Tu alles, was n\xF6tig ist, aber lass ihn nicht niesen."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337347
    m_Localized: "Wenn er zu hart vorgeht, m\xFCssen wir diesen Ort aus den Tr\xFCmmern
      wieder aufbauen."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337348
    m_Localized: "Ich werde dich nicht entt\xE4uschen."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337349
    m_Localized: Der Nilpferdschwur.
    m_Metadata:
      m_Items: []
  - m_Id: 95027885946068992
    m_Localized: Hey, wo gehst du hin?
    m_Metadata:
      m_Items: []
  - m_Id: 95028971859763200
    m_Localized: Ich meine, wo gehst du hin? Du bist gerade an einem Schild vorbeigelaufen.
    m_Metadata:
      m_Items: []
  - m_Id: 95032048352387072
    m_Localized: Wir sind nicht den ganzen Weg hierher gekommen, um jetzt aufzugeben!
    m_Metadata:
      m_Items: []
  - m_Id: 95060151254540288
    m_Localized: Nein, das ist nicht Clifford. Das ist Riverside. Siehst du?
    m_Metadata:
      m_Items: []
  - m_Id: 95060151283900416
    m_Localized: Dieser verdammte Clifforder hat Leshy in unser Dorf gebracht!
    m_Metadata:
      m_Items: []
  - m_Id: 95060151283900417
    m_Localized: Ich? Leshy?
    m_Metadata:
      m_Items: []
  - m_Id: 95060151283900418
    m_Localized: Und jetzt hast du dich entschieden, Leshy auf uns zu hetzen!
    m_Metadata:
      m_Items: []
  - m_Id: 95336547382091776
    m_Localized: "Insbesondere nachdem man die Einheimischen versehentlich ver\xE4rgert
      hatte."
    m_Metadata:
      m_Items: []
  - m_Id: 95336547411451904
    m_Localized: "Genau.<pause:0.5> Es sei denn, der b\xF6se Leshy und der schmutzige
      Clifforder wollen die Geduld der Einheimischen noch weiter strapazieren."
    m_Metadata:
      m_Items: []
  - m_Id: 95703245004103680
    m_Localized: Ohhh,<pause:0.5> vielen Dank an alle.
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463808
    m_Localized: "Ich hatte schon lange nicht mehr so \u200B\u200Bviel Spa\xDF!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463809
    m_Localized: "In den letzten Tagen waren alle so besch\xE4ftigt und besorgt,
      dass ich fast vergessen habe, wie sich das anf\xFChlt."
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463810
    m_Localized: Und nun sitzen wir alle wieder am selben Tisch!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463811
    m_Localized: Leckeres Essen und Geschichten teilen!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463812
    m_Localized: "Und seht mich an!<pause:0.5> Ich sp\xFCre schon jetzt, dass es
      mir viel besser geht!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463813
    m_Localized: Wir alle!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463814
    m_Localized: Das alles verdanken wir euch!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463816
    m_Localized: Ein Hoch auf Dr. Leshy!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463817
    m_Localized: "Na los, Vasya, du wei\xDFt doch, was du sagen sollst!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463819
    m_Localized: Und jetzt kommt her, ich umarme euch alle!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463820
    m_Localized: Boris, was machst du da?!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463821
    m_Localized: Egal wie freundlich Leshy heute auch gewesen sein mag, er ist und
      bleibt ein Waldmonster!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463822
    m_Localized: Er wird dich fressen!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463824
    m_Localized: Er hat meinen Freunden geholfen, und ich werde ihn auf jeden Fall
      umarmen!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463825
    m_Localized: "Boris, sei vern\xFCnftig, sei es nicht."
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463826
    m_Localized: "Sich besser zu f\xFChlen bedeutet nicht, dass man sich bereits
      vollst\xE4ndig erholt hat."
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463827
    m_Localized: "H\xF6r auf, so ein Theater zu veranstalten, du Angsthase!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463828
    m_Localized: Ich komme!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463829
    m_Localized: Moment mal!<pause:0.5> Also ist er gar nicht Leshy!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463830
    m_Localized: "Er ist nur ein griesgr\xE4miger kleiner Fuchs!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463831
    m_Localized: Oh mein Gott!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463832
    m_Localized: Warum hast du mir nicht gesagt, dass du nicht Leshy bist?
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463834
    m_Localized: Ich hoffe, du bist stolz auf dich.
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463835
    m_Localized: "Nat\xFCrlich."
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463836
    m_Localized: "Genug gez\xE4nkisch, ihr kleinen F\xFCchse."
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463837
    m_Localized: "Komm schon, lass uns dar\xFCber sprechen, was wir als N\xE4chstes
      mit dir machen werden."
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463838
    m_Localized: Oh...
    m_Metadata:
      m_Items: []
  - m_Id: 95707377475674112
    m_Localized: <volume:1>Hurra.
    m_Metadata:
      m_Items: []
  - m_Id: 95708385291427840
    m_Localized: Ein Hoch auf Tante Adele, den Clifforder und den Leshy!
    m_Metadata:
      m_Items: []
  - m_Id: 95711446944604160
    m_Localized: "Das ist mir egal, selbst wenn er der Teufel pers\xF6nlich w\xE4re!"
    m_Metadata:
      m_Items: []
  - m_Id: 95711446944604161
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Ich platze
      vor Emp\xF6rung."
    m_Metadata:
      m_Items: []
  - m_Id: 95712882495479808
    m_Localized: Clifford
    m_Metadata:
      m_Items: []
  - m_Id: 96172734023884800
    m_Localized: Hallo, du kleiner Fuchs.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734023884801
    m_Localized: Hallo, Pferdchen.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734023884802
    m_Localized: "Auf nach Gro\xDFstadt, um dort gro\xDF rauszukommen, was?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734023884803
    m_Localized: Nicht wirklich, ganz im Gegenteil.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734028079104
    m_Localized: "Wir hatten es so satt, in der Gro\xDFstadt gro\xDF rauszukommen,
      dass wir beschlossen, woanders kleiner anzufangen."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734028079105
    m_Localized: Clifford?<pause:0.5> Klein?!
    m_Metadata:
      m_Items: []
  - m_Id: 96172734028079106
    m_Localized: Ja, <pause:0.5> war es schon immer.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734028079107
    m_Localized: Ich dachte immer, es sei riesig.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734032273408
    m_Localized: "Silver sagte, Clifford sei etwa so gro\xDF wie ein einzelner Bezirk
      in Metropolis."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734032273409
    m_Localized: Wow.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734032273410
    m_Localized: "Ich wollte schon immer mal dorthin, um eine Gro\xDFstadt zu sehen."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734032273411
    m_Localized: "Ich wusste, dass es nicht das gr\xF6\xDFte Exemplar war."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187968
    m_Localized: Aber ich war mir sicher, dass es zumindest unter den ersten zehn
      sein musste.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187969
    m_Localized: "Und jetzt erz\xE4hlst du mir das."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187970
    m_Localized: "Das ist eigentlich ziemlich entt\xE4uschend."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187971
    m_Localized: Warum gehst du nicht?
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187972
    m_Localized: Ich kann nicht, ich bin noch zu klein.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187973
    m_Localized: "Sieh dich doch mal an! Du bist gro\xDF und stark!"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187974
    m_Localized: Du ziehst mich, meinen Bruder und diesen ganzen Wagen ganz allein!
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187975
    m_Localized: Nein, ich meine, ich bin noch nicht alt genug.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187976
    m_Localized: "Haben Sie schon einmal versucht, jemanden \xC4lteren zu bitten,
      Sie in die Stadt mitzunehmen?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187977
    m_Localized: Ich kann nicht.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187978
    m_Localized: "Mein Vater f\xE4hrt jeden Tag Leute nach Clifford und zur\xFCck."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187979
    m_Localized: Manche von uns wohnen hier, arbeiten aber in der Stadt, wie zum
      Beispiel Tante Adele.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187980
    m_Localized: Und ich soll vorsichtshalber im Dorf bleiben.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187981
    m_Localized: "Wenn Papa nicht da ist, bin ich die Einzige, die wei\xDF, wie man
      den Einkaufswagen bedient."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187982
    m_Localized: "Er sagt mir immer wieder, ich solle meine Pflichten f\xFCr einen
      Tag vergessen."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187983
    m_Localized: Um mit ihm in die Stadt zu kommen.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187984
    m_Localized: Aber ich kann es einfach nicht.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187985
    m_Localized: "Was, wenn etwas passiert, w\xE4hrend ich mich vergn\xFCge?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187986
    m_Localized: Wie zum Beispiel heute.<pause:0.5> Ihr zwei seid wie aus dem Nichts
      aufgetaucht.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187987
    m_Localized: "Wer h\xE4tte dich in die Stadt gebracht, wenn ich nicht da gewesen
      w\xE4re?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187988
    m_Localized: "Ich sch\xE4tze, wir h\xE4tten bis zum Morgen warten und mit deinem
      Vater gehen m\xFCssen."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187989
    m_Localized: "Und Warten k\xF6nnen wir uns im Moment wirklich nicht leisten."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187990
    m_Localized: "Wir haben einen Kredit, der uns wie ein Damoklesschwert \xFCber
      dem Kopf schwebt, und wir m\xFCssen so schnell wie m\xF6glich damit beginnen,
      ihn abzuzahlen."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187991
    m_Localized: Ihr habt uns wirklich sehr geholfen.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187992
    m_Localized: "Kleiner Fuchs, wie hei\xDFt du?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187993
    m_Localized: Red.<pause:0.5> Und deins?
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187994
    m_Localized: Ich bin Daisy.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187995
    m_Localized: "Sch\xF6n, dich kennenzulernen, Daisy."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187996
    m_Localized: "Red,<pause:0.5> Wie ist es, in einer Stadt zu leben, die noch gr\xF6\xDFer
      ist als Clifford?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187997
    m_Localized: Es ist... nicht der sicherste Ort.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187998
    m_Localized: "Daisy, warum m\xF6gen die Leute von Riverside Clifford so wenig,
      aber versuchen trotzdem, ihn zu erreichen?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187999
    m_Localized: "Ich wei\xDF es nicht. Es war schon immer eine komplizierte Beziehung."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188000
    m_Localized: "Und dann war da noch die Sache mit der neuen Stra\xDFe."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188001
    m_Localized: Was ist passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188002
    m_Localized: "Vor nicht allzu langer Zeit erfuhren wir, dass sie eine Stra\xDFe
      von Clifford zur Hauptstra\xDFe bauen."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188003
    m_Localized: "Wir waren alle aufgeregt, weil wir dachten, die Bahn w\xFCrde durch
      unser Dorf f\xFChren und uns endlich einen einfachen Weg in die Stadt erm\xF6glichen."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188004
    m_Localized: "Es stellte sich jedoch heraus, dass sie die Pipeline durch die
      W\xFCste statt durch unseren Wald bauen, um ein wenig Geld zu sparen."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188005
    m_Localized: Ich lasse es niemanden sehen, aber unter uns gesagt, es hat wirklich
      wehgetan.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188006
    m_Localized: "Wenn das Dorf eine Stra\xDFe und auch nur ein Auto h\xE4tte, w\xFCrde
      ich mir viel weniger Sorgen machen."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188007
    m_Localized: "Ich w\xFCsste, dass die Dorfbewohner auch ohne mich nicht in Gefahr
      w\xE4ren."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188008
    m_Localized: Es tut mir Leid.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188009
    m_Localized: Falls Sie es jemals in die Stadt schaffen, besuchen Sie uns doch.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188010
    m_Localized: "Wir er\xF6ffnen ein Restaurant."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188011
    m_Localized: Wir haben uns noch keinen Namen ausgedacht, aber ihr werdet es erkennen,
      wenn ihr es seht.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188012
    m_Localized: "Das wird der coolste Ort der Welt!<pause:0.5> Den k\xF6nnt ihr
      nicht verfehlen."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188013
    m_Localized: Wow, das klingt fantastisch!
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188014
    m_Localized: "Ich w\xFCrde gerne!"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188015
    m_Localized: "Und deine Suppe war wirklich k\xF6stlich!"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188016
    m_Localized: Ich schaue auf jeden Fall vorbei, wenn ich die Gelegenheit dazu
      habe!
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188017
    m_Localized: Abgemacht.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188018
    m_Localized: Oh, ist das die Autobahn mit der Bushaltestelle?
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188019
    m_Localized: Genau!
    m_Metadata:
      m_Items: []
  - m_Id: 96177215478325248
    m_Localized: Oh...
    m_Metadata:
      m_Items: []
  - m_Id: 96391525269921792
    m_Localized: "Ich muss zugeben, ihr zwei habt das hervorragend gemacht, ihr kleinen
      F\xFCchse."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087616
    m_Localized: Den Einwohnern von Riverside geht es jetzt viel besser.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087617
    m_Localized: Und vielleicht findet diese Hexenjagd nun endlich ein Ende.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087618
    m_Localized: Du bist also doch eine Hexe!
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087619
    m_Localized: "Ich bin ungef\xE4hr so \u200B\u200Bsehr eine Hexe, wie du eine
      Leshy bist."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087620
    m_Localized: Ich bin Wahrsagerin, und zwar eine furchtbare. Aber das trifft wohl
      auf alle Wahrsager zu.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087621
    m_Localized: "F\xFCr die Einheimischen ist aber alles dasselbe."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087622
    m_Localized: "Sie werden selbst die unglaublichste Erkl\xE4rung bereitwillig
      glauben."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087623
    m_Localized: Du hast mich abgelenkt.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087624
    m_Localized: Ihr habt beide hart gearbeitet und euch eine Belohnung verdient.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087625
    m_Localized: Ich habe sowohl hier als auch in Clifford einen gewissen Einfluss.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087626
    m_Localized: "Und ich besitze zuf\xE4llig auch einige interessante Kleinigkeiten."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087627
    m_Localized: Jeder von euch hat einen Wunsch frei.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087628
    m_Localized: "W\xE4hle weise, aber werde nicht gierig."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087629
    m_Localized: "Ich m\xF6chte diesen Ofen behalten."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087630
    m_Localized: Man bittet nicht um kleine Gefallen, oder, Red?
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087631
    m_Localized: Aber das ist ein angemessener Preis, wenn man bedenkt, was Sie geleistet
      haben.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087632
    m_Localized: "Au\xDFerdem hat es hier sowieso nur Staub angesetzt."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087633
    m_Localized: Ich hasse Kochen.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087634
    m_Localized: "Es geh\xF6rt dir."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087635
    m_Localized: Und was ist mit dir, Silver?<pause:0.5> Was willst du?
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087636
    m_Localized: "Ich m\xF6chte, dass Sie uns so schnell wie m\xF6glich nach Clifford
      bringen."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087637
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Gut.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087638
    m_Localized: Wir haben einen Notfallplan.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087639
    m_Localized: Ich nehme an, dass <pause:0.5> heute qualifiziert ist.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087640
    m_Localized: "Aber wenn sie zur\xFCckkommt und sich beschwert, dass ihr ihr das
      Leben schwer gemacht habt..."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087641
    m_Localized: Wir werden uns wie perfekte Gentlemen benehmen!
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087642
    m_Localized: Das ist die richtige Antwort.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087643
    m_Localized: "Packen Sie Ihre Sachen, der n\xE4chste Bus nach Clifford f\xE4hrt
      in zehn Minuten."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
