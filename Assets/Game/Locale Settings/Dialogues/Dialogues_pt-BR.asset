%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogues_pt-BR
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: 76c0caf3be1b6134fac28638aa766eea, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 96960955703296
    m_Localized: "*suspiro*<pause:1> Mais um dia, mais um d\xF3lar."
    m_Metadata:
      m_Items: []
  - m_Id: 102732733243392
    m_Localized: "Caramba,<pause:0.5> esse garoto parece dur\xE3o,<pause:0.5> ele
      precisa de pelo menos dois sorvetes."
    m_Metadata:
      m_Items: []
  - m_Id: 102851926974464
    m_Localized: "Garot\xE3o, hein?<pause:0.75> Quanto maior a altura, maior a queda."
    m_Metadata:
      m_Items: []
  - m_Id: 102931308371968
    m_Localized: "Lixo velho e est\xFApido."
    m_Metadata:
      m_Items: []
  - m_Id: 103157167448064
    m_Localized: "Preciso limpar a bagun\xE7a."
    m_Metadata:
      m_Items: []
  - m_Id: 103200687546368
    m_Localized: "Onde est\xE1 a lata de lixo?"
    m_Metadata:
      m_Items: []
  - m_Id: 103255913947136
    m_Localized: "Ah, a\xED est\xE1 voc\xEA."
    m_Metadata:
      m_Items: []
  - m_Id: 103266819137536
    m_Localized: "X\xF4, pequenos fedorentos."
    m_Metadata:
      m_Items: []
  - m_Id: 103795813146624
    m_Localized: Oh,<pause:0.5> uau.<pause:0.5> O primeiro pedido complexo de hoje.
    m_Metadata:
      m_Items: []
  - m_Id: 103882635239424
    m_Localized: "Mesmo assim, continua muito f\xE1cil."
    m_Metadata:
      m_Items: []
  - m_Id: 103985789952000
    m_Localized: "\xC9 preciso misturar os ingredientes."
    m_Metadata:
      m_Items: []
  - m_Id: 104019986112512
    m_Localized: "*suspiro*<pause:1> Ser\xE1 que \xE9 mesmo cozinhar pratos de verdade?"
    m_Metadata:
      m_Items: []
  - m_Id: 104142648532992
    m_Localized: "Ah, <pause:0.5> o jogo de verdade come\xE7a."
    m_Metadata:
      m_Items: []
  - m_Id: 104186449649664
    m_Localized: "\xC9 f\xE1cil.<pause:0.5> Esta coisa gera itens,<pause:0.5> Eu
      os uso."
    m_Metadata:
      m_Items: []
  - m_Id: 104222092845056
    m_Localized: "O principal \xE9 evitar que entupa."
    m_Metadata:
      m_Items: []
  - m_Id: 104300811542528
    m_Localized: "*suspiro*<pause:1> Todos os dias no mesmo hor\xE1rio."
    m_Metadata:
      m_Items: []
  - m_Id: 104452712456192
    m_Localized: "Ah,<pause: 0.5> \xE9 voc\xEA de novo, Red <pause:0.5>NOT<pause:0.5>
      um cozinheiro."
    m_Metadata:
      m_Items: []
  - m_Id: 104546270601216
    m_Localized: 'Yarrr,<pause: 0.5> bem-vindo a bordo, jovem marinheiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 104596988125184
    m_Localized: "N\xE3o preciso das suas sauda\xE7\xF5es, Red <pause:0.5>NOT<pause:0.5>
      um cozinheiro."
    m_Metadata:
      m_Items: []
  - m_Id: 104702047051776
    m_Localized: "Preciso que voc\xEA trabalhe mais r\xE1pido, n\xE3o mais alto."
    m_Metadata:
      m_Items: []
  - m_Id: 104734192197632
    m_Localized: "Voc\xEA sabia que este \xE9 um restaurante para crian\xE7as?"
    m_Metadata:
      m_Items: []
  - m_Id: 104799568814080
    m_Localized: "Pfft.<pause:0.5> Este lugar est\xE1 cheio de piratas."
    m_Metadata:
      m_Items: []
  - m_Id: 104851519463424
    m_Localized: "Piratas s\xE3o muito assustadores para eles, ent\xE3o, sim, \xE9
      claramente para adultos."
    m_Metadata:
      m_Items: []
  - m_Id: 104919387496448
    m_Localized: "Pelo menos voc\xEA n\xE3o est\xE1 velho demais para isso."
    m_Metadata:
      m_Items: []
  - m_Id: 105019983683584
    m_Localized: "Estou na idade perfeita para este lugar, ent\xE3o, <pause:0.5>SIM."
    m_Metadata:
      m_Items: []
  - m_Id: 105266793308160
    m_Localized: "E eu preciso de algumas calorias para estar em \xF3tima forma.
      Ent\xE3o, depressa, Cozinheiro Vermelho."
    m_Metadata:
      m_Items: []
  - m_Id: 105471504703488
    m_Localized: "Pfft.<pause: 0.5> Se voc\xEA fez isso n\xE3o significa que voc\xEA
      fez bem,<pause: 0.5> Vermelho <pause:0.5>N\xC3O<pause:0.5> um cozinheiro."
    m_Metadata:
      m_Items: []
  - m_Id: 105543625760768
    m_Localized: "Yarrr,<pause: 0.5> esperamos v\xEA-lo novamente em breve, jovem
      marinheiro."
    m_Metadata:
      m_Items: []
  - m_Id: 105608289345536
    m_Localized: "Ah, <pause:0.5> SIM, <pause:0.5> N\xC3O<pause: 0.5> hesite.<pause:1>
      Voc\xEA me ver\xE1 em breve."
    m_Metadata:
      m_Items: []
  - m_Id: 105693555351552
    m_Localized: "E da pr\xF3xima vez n\xE3o serei t\xE3o condescendente com voc\xEA."
    m_Metadata:
      m_Items: []
  - m_Id: 105789357449216
    m_Localized: "At\xE9 logo, Red <pause:0.5>NOT<pause:0.5> um cozinheiro."
    m_Metadata:
      m_Items: []
  - m_Id: 107592824283136
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Finalmente.
    m_Metadata:
      m_Items: []
  - m_Id: 107662542004224
    m_Localized: "Uau, j\xE1 \xE9 hora do intervalo?"
    m_Metadata:
      m_Items: []
  - m_Id: 131328193486848
    m_Localized: Droga...<pause:1> Ok, vamos tentar de novo.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674043346944
    m_Localized: Finalmente, um momento de paz.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124160
    m_Localized: "Arrr! <pause:0.75> Ent\xE3o, marinheiro, voc\xEA achou que seu
      primeiro dia seria tranquilo?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124161
    m_Localized: "Trabalho aqui h\xE1 mais de um ano."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124162
    m_Localized: "Arrr! <pause:0.75> N\xE3o consegui entender nada disso!<pause:0.75>
      Voc\xEA parece um marinheiro de \xE1gua doce!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124163
    m_Localized: "N\xE3o quero falar assim quando n\xE3o estou no caixa. \xC9 rid\xEDculo."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124164
    m_Localized: "N\xF3s n\xE3o somos piratas na vida real."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124165
    m_Localized: <volume:0>...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124166
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> *suspiro*
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124167
    m_Localized: "Arrr!<pause:0.75> Capit\xE3o,<pause:0.75> Estou nesta viagem h\xE1
      mais de um ano!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124168
    m_Localized: "<volume:1>Yarr!<pause:0.75> Isso sim!<pause:0.75> Continue assim
      e o tesouro n\xE3o demorar\xE1 a chegar!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124169
    m_Localized: "Falando em tesouro...<pause:0.75> Na verdade, eu queria discutir
      minha promo\xE7\xE3o e..."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124170
    m_Localized: Anime-se, marinheiro!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124171
    m_Localized: "N\xE3o sei o que aconteceu com voc\xEA em terra firme."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124172
    m_Localized: "Mas se voc\xEA continuar andando por a\xED com essa cara de mau
      humor, vai espantar todos os meus clientes!<pause:0.75> Arrr!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124173
    m_Localized: "\xC9 que..."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124174
    m_Localized: ...meu rosto.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124175
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> C\xE3o
      vira-lata surdo."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124176
    m_Localized: "J\xE1?!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124177
    m_Localized: "Juro, os intervalos est\xE3o ficando cada vez mais curtos!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124178
    m_Localized: Vou mostrar a ele.<pause:1> Vou mostrar a todos eles.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124179
    m_Localized: "Vou abrir meu pr\xF3prio restaurante, contratar todos eles, e depois
      dar a eles os intervalos mais curtos imagin\xE1veis."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124180
    m_Localized: E vou me dar um descanso absurdamente longo!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124181
    m_Localized: "Mas eu nem vou querer usar, de t\xE3o incr\xEDvel que ser\xE1 meu
      apartamento!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124182
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Pensando
      bem, talvez eu devesse torn\xE1-lo um pouco menos incr\xEDvel."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124183
    m_Localized: "Caso contr\xE1rio, eles n\xE3o v\xE3o querer fazer pausas de jeito
      nenhum."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124184
    m_Localized: "Ah,<pause:0.75> \xE9 ela de novo."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124185
    m_Localized: "Ela precisa de uma abordagem especial. Ela observa o que os outros
      est\xE3o comendo e pede a mesma coisa."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124186
    m_Localized: Coitadinha, tende a duvidar.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124187
    m_Localized: Pronto!<pause:0.75> Sorvete para todos!<pause:0.75> E eu nem suei!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124188
    m_Localized: <volume:0>...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124189
    m_Localized: "Yarr,<pause:0.75>, est\xE1 tudo bem, jovem marinheiro?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124190
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Eu s\xF3
      queria agradecer!<pause:0.5> Voc\xEA foi muito paciente."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124191
    m_Localized: Normalmente, os adultos xingam quando eu duvido de muita coisa.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124192
    m_Localized: "Yarr,<pause:0.5> n\xE3o se preocupe, jovem marinheiro,<pause:0.5>
      e volte quando quiser!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124193
    m_Localized: "Voc\xEA \xE9 incr\xEDvel!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124194
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Hm,<pause:0.75>
      talvez este dia<pause:0.75> n\xE3o seja t\xE3o ruim afinal."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124195
    m_Localized: "Ei, <pause:0.5> Vermelho, <pause:0.5> vamos l\xE1, <pause:0.5>
      precisamos conversar."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124196
    m_Localized: Contratado.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124197
    m_Localized: "Ol\xE1, Stan."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124198
    m_Localized: "Meus olhos est\xE3o mais baixos."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124199
    m_Localized: Oh.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124200
    m_Localized: "Sim,<pause:0.75> isso \xE9 melhor."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124201
    m_Localized: "Ent\xE3o, o que voc\xEA queria?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124202
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Preciso
      ir at\xE9 a \xE1rea de jantar em um minuto."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124203
    m_Localized: "O qu\xEA?!<pause:0.75> N\xE3o!<pause:0.75> Eu me oponho!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124204
    m_Localized: "O capit\xE3o disse que me daria de comer aos peixes se eu n\xE3o
      o fizesse."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124205
    m_Localized: "N\xE3o tenho certeza do que isso significa em termos simples, mas
      tenho certeza de que n\xE3o \xE9 nada bom."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124206
    m_Localized: "Mas as crian\xE7as ficam loucas pelo Joe Perneta!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124207
    m_Localized: "Eles v\xE3o destruir este lugar se te virem com a fantasia!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124208
    m_Localized: "N\xE3o vou conseguir atender tantos clientes!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124209
    m_Localized: "Precisamos de pelo menos tr\xEAs pessoas no caixa para dar conta
      da demanda!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124210
    m_Localized: "E hoje estou sozinha!<pause:0.75> Lembra o que aconteceu da \xFAltima
      vez!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124211
    m_Localized: "Eu sei.<pause:0.75> \xC9 por isso que vim conversar sobre isso."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124212
    m_Localized: "Ent\xE3o, voc\xEA realmente tem um plano?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124213
    m_Localized: "Sim, noite de cinema. Voc\xEA fecha as cortinas, liga o projetor
      e eu garanto que todos fa\xE7am sil\xEAncio."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124214
    m_Localized: Noite de cinema, hein?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124215
    m_Localized: "Isso significa que terei que assumir o menu noturno com os coquet\xE9is.<pause:0.75>
      Isso n\xE3o ser\xE1 f\xE1cil."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124216
    m_Localized: "Ainda assim, \xE9 mais f\xE1cil do que se todas as crian\xE7as
      da vizinhan\xE7a viessem correndo para c\xE1 ao mesmo tempo."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124217
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> \xC9,<pause:0.5>
      voc\xEA tem raz\xE3o.<pause:0.75> Voc\xEA \xE9 um g\xEAnio, Stan.<pause:0.75>
      Vamos fazer isso."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124218
    m_Localized: "Neg\xF3cio."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124219
    m_Localized: "Muito bem, vamos tentar isto. Vamos l\xE1!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124220
    m_Localized: "Meu Deus,<pause:0.4> \xE9 o Joe Perna-de-Pau!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124221
    m_Localized: "Eba, Joe Perneta! Me d\xE1 uma carona!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124222
    m_Localized: "Eu tamb\xE9m!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124223
    m_Localized: "Arrr!<pause:0.75> O Joe Perneta n\xE3o est\xE1 se sentindo muito
      bem hoje,<pause:0.4> ent\xE3o vamos manter isso em segredo."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318464
    m_Localized: "Ah,<pause:0.75> isso n\xE3o \xE9 justo!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318465
    m_Localized: "Pensei que \xEDamos nos divertir."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318466
    m_Localized: "N\xE3o se preocupe, jovem marinheiro, n\xE3o precisamos fazer barulho
      para nos divertirmos!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318467
    m_Localized: "Por exemplo, poder\xEDamos assistir a um desenho animado!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318468
    m_Localized: "Desenhos animados s\xE3o bons."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318469
    m_Localized: "S\xF3 se for interessante!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318470
    m_Localized: Espero que haja uma estrela-do-mar nisso...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318471
    m_Localized: "Yarr,<pause:0.75> claro que \xE9 interessante!<pause:0.75> Mas
      vamos assistir em sil\xEAncio.<pause:0.5> Combinado, jovens marinheiros?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318472
    m_Localized: "Neg\xF3cio!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318473
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Funcionou!<pause:0.75>
      Ningu\xE9m apareceu!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318474
    m_Localized: "Eu te disse!<pause:0.75> Um plano infal\xEDvel!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318475
    m_Localized: "Agora s\xF3 falta uma coisa.<pause:0.75> De volta ao trabalho!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318476
    m_Localized: Ufa, jovens marinheiros, quem mais quer um sorvete?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318477
    m_Localized: <volume:0>...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318478
    m_Localized: "Parece que voc\xEA j\xE1 cuidou de tudo."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318479
    m_Localized: "Voc\xEA poderia, por favor, falar mais baixo?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318480
    m_Localized: <volume:1>Estamos tentando assistir.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318481
    m_Localized: Ah, desculpe.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318482
    m_Localized: "Ah, qual \xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318483
    m_Localized: "Ei, <pause:0.5> n\xF3s ainda n\xE3o t\xEDnhamos terminado de assistir!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318484
    m_Localized: "<volume:0.5>Yarr!<pause:0.5> O que voc\xEAs pensam que est\xE3o
      fazendo aqui, marinheiros?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318485
    m_Localized: "Eu disse para voc\xEA mandar o Joe Perneta, n\xE3o para voc\xEA
      ficar aqui parado!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318486
    m_Localized: "<emote:shake><volume:1>Ei,<pause:0.5>__jovens marinheiros,<pause:0.5><emote:shake>
      o Joe Perneta esteve escondido aqui o tempo todo!<pause:0.5><emote:shake> Entrem
      aqui,<pause:0.5><emote:shake> mostrem a ele o quanto voc\xEAs o amam!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318487
    m_Localized: <volume:0.5>Avante, marinheiros,<pause:0.75> tragam-me todos os
      tesouros do mundo!<pause:0.75> Hahahahaha!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318488
    m_Localized: "\xC9 o Joe Perneta!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318489
    m_Localized: "Corra at\xE9 ele!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318490
    m_Localized: "Oh n\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318491
    m_Localized: "*suspiro* <pause:1> In\xEDcio."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318492
    m_Localized: Huh?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318493
    m_Localized: Que...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318494
    m_Localized: Prata
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318495
    m_Localized: "Se voc\xEA sair sem chap\xE9u, vou contar para a mam\xE3e."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318496
    m_Localized: "N\xC3O"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318497
    m_Localized: nova mensagem
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318498
    m_Localized: Venha para a cozinha.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318499
    m_Localized: Ei!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318500
    m_Localized: "Voc\xEA tem no\xE7\xE3o de que n\xE3o pode simplesmente invadir
      minha casa assim?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318501
    m_Localized: Estava destrancado.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318502
    m_Localized: "E por que voc\xEA est\xE1 sentado aqui no escuro?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318503
    m_Localized: "Estou me sentindo brincalh\xE3o(a)."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318504
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318505
    m_Localized: "Oh, <pause:0.5> n\xE3o aja como se n\xE3o estivesse feliz em me
      ver."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318506
    m_Localized: Eu sou.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318507
    m_Localized: "Ent\xE3o, por que voc\xEA est\xE1 aqui?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318508
    m_Localized: "N\xE3o posso simplesmente dar uma passadinha para ver como est\xE1
      meu irm\xE3ozinho?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318509
    m_Localized: "Voc\xEA pode,<pause:0.75> mas voc\xEA n\xE3o faz."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318510
    m_Localized: "Nossa. \xC9 assim que voc\xEA me considera?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318511
    m_Localized: "Certo, voc\xEA me pegou."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318512
    m_Localized: "N\xE3o estou aqui sem motivo.<pause:0.75> Tenho uma proposta para
      voc\xEA."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318513
    m_Localized: "N\xC3O!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318514
    m_Localized: "Voc\xEA nem sequer me ouviu."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318515
    m_Localized: "N\xC3O!<pause:0.75> Estou fora do jogo!<pause:0.75> Agora sou apenas
      um cozinheiro comum, lembra?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318516
    m_Localized: "Voc\xEA est\xE1 servindo sorvete em um restaurante infantil.<pause:0.75>
      Voc\xEA n\xE3o \xE9 cozinheiro(a)."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318517
    m_Localized: Eu pratico bastante em casa!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318518
    m_Localized: "E eu sei que voc\xEA \xE9 bom."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318519
    m_Localized: "Mas ser cozinheiro n\xE3o \xE9 um hobby, \xE9 uma profiss\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318520
    m_Localized: "Voc\xEA veio aqui s\xF3 para me insultar?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512768
    m_Localized: Na verdade, vim para te ajudar com isso.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512769
    m_Localized: "Em primeiro lugar, n\xE3o gosto do que isso soa. E em segundo lugar,
      voc\xEA n\xE3o entende nada de culin\xE1ria."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512770
    m_Localized: "Talvez n\xE3o.<pause:0.75> Mas eu entendo que voc\xEA est\xE1 buscando
      seu objetivo da maneira errada."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512771
    m_Localized: "Vermelho,<pause:0.75> voc\xEA n\xE3o est\xE1 acompanhando."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512772
    m_Localized: "Pior ainda, o que voc\xEA est\xE1 passando n\xE3o est\xE1 te aproximando
      do seu objetivo."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512773
    m_Localized: "Isso est\xE1 te afastando ainda mais."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512774
    m_Localized: "N\xE3o, n\xE3o \xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512775
    m_Localized: "D\xEA uma olhada nisso!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512776
    m_Localized: Contemplar!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512777
    m_Localized: meu objetivo
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512778
    m_Localized: "Viu?<pause:0.5> J\xE1 estou na metade do caminho!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512779
    m_Localized: "N\xE3o me arrasto para esse maldito emprego dia ap\xF3s dia \xE0
      toa!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512780
    m_Localized: "Todo m\xEAs, tem mais e mais dinheiro no pote!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512781
    m_Localized: "E quando eu encher isso, vou abrir um restaurante onde servirei
      os melhores pratos da regi\xE3o!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512782
    m_Localized: "E os funcion\xE1rios ter\xE3o intervalos absurdamente longos!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512783
    m_Localized: "Mas trabalhar l\xE1 ser\xE1 t\xE3o incr\xEDvel que ningu\xE9m vai
      querer contrat\xE1-los!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512784
    m_Localized: "E ningu\xE9m jamais dir\xE1 que Red n\xE3o \xE9 um cozinheiro de
      verdade!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512785
    m_Localized: "Ningu\xE9m!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512786
    m_Localized: Oh, seu bolinho rabugento!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512787
    m_Localized: "N\xE3o estou dizendo que voc\xEA trabalha duro."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512788
    m_Localized: "\xC9 o oposto.<pause:0.5> Voc\xEA se envolveu tanto na culin\xE1ria
      que se esqueceu de manter os olhos abertos."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512789
    m_Localized: "Vermelho,<pause:0.5> h\xE1 quanto tempo voc\xEA definiu essa meta?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512790
    m_Localized: "H\xE1 um ano e meio."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512791
    m_Localized: "Voc\xEA viu o quanto os pre\xE7os subiram desde ent\xE3o?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512792
    m_Localized: "Bem, os pre\xE7os sempre sobem um pouco."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512793
    m_Localized: "Veja s\xF3 quanto custa hoje aquele equipamento que voc\xEA gostava
      naquela \xE9poca."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512794
    m_Localized: "Ah, qual \xE9, n\xE3o pode ser t\xE3o ruim assim."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512795
    m_Localized: "Tenho certeza de que voc\xEA seria capaz de mover montanhas com
      essa sua teimosia."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512796
    m_Localized: "Mas se voc\xEA continuar assim, vai se distanciar ainda mais do
      seu objetivo."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512797
    m_Localized: "As coisas est\xE3o ficando mais caras mais r\xE1pido do que voc\xEA
      est\xE1 ganhando."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512798
    m_Localized: "Ent\xE3o, o que eu devo fazer?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512799
    m_Localized: Tome uma atitude.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512800
    m_Localized: "Isso ainda n\xE3o \xE9 suficiente para abranger toda a sua vis\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512801
    m_Localized: "Mas \xE9 um capital inicial razo\xE1vel para algo mais modesto."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512802
    m_Localized: Por exemplo,<pause:0.75> um pequeno restaurante em uma cidade menor.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512803
    m_Localized: "Eu j\xE1 identifiquei um local promissor.<pause:0.75> Nosso dinheiro
      cobriria o pagamento inicial."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512804
    m_Localized: "Entrada?<pause:0.75> Um empr\xE9stimo parece bastante<pause:0.5>
      arriscado."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512805
    m_Localized: "Claro, mas voc\xEA sabe como funciona. Sem risco, sem recompensa."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512806
    m_Localized: Sabe de uma coisa?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512807
    m_Localized: "Voc\xEA tem raz\xE3o!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512808
    m_Localized: Que se dane a sorveteria!<pause:0.75> Que se danem todas elas!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512809
    m_Localized: Se eu tiver que falar como um pirata por mais um dia, vou enlouquecer!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512810
    m_Localized: "Isso sim \xE9 esp\xEDrito de luta!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512811
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> E o que
      voc\xEA ganha com isso?<pause:0.75> Por que me ajudar?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512812
    m_Localized: "Bem, primeiro de tudo, porque me preocupo com meu irm\xE3ozinho."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512813
    m_Localized: Quem com certeza se meteria em encrenca sem mim?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512814
    m_Localized: E em segundo lugar, quero uma parte.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707072
    m_Localized: "N\xE3o acredito em voc\xEA!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707073
    m_Localized: "\xC9 poss\xEDvel praticamente ganhar dinheiro do nada!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707074
    m_Localized: "Por que algu\xE9m iria querer ter participa\xE7\xE3o em um restaurante
      qualquer?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707075
    m_Localized: "Ah, voc\xEA realmente achou que eu nunca ia crescer?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707076
    m_Localized: "Que eu n\xE3o gostaria de me estabelecer?<pause:0.75> Ter uma fonte
      de renda leg\xEDtima?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707077
    m_Localized: "Voc\xEA est\xE1 magoando meus sentimentos."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707078
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707079
    m_Localized: "O qu\xEA?<pause:0.75> Voc\xEA realmente acha que estou tentando
      te enganar?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707080
    m_Localized: Quantas vezes tentei te machucar?<pause:0.75> Te roubar?<pause:0.75>
      Te armar uma cilada?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707081
    m_Localized: Nem uma vez.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707082
    m_Localized: "Ent\xE3o, o que voc\xEA est\xE1 esperando?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707083
    m_Localized: Parceiros?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707084
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Muito bem,<pause:0.75>
      parceiros!
    m_Metadata:
      m_Items: []
  - m_Id: 39890501168685056
    m_Localized: "E a incr\xEDvel aventura deles come\xE7ou!"
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377408
    m_Localized: "\xC9 suficiente para cuidar da maioria deles."
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377409
    m_Localized: Este dispositivo mostra quantos clientes mais preciso satisfazer.
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377410
    m_Localized: "Nossa!<pause:0.5> Apareceram tantas crian\xE7as que n\xE3o couberam
      todas l\xE1 dentro."
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377411
    m_Localized: "Alguns deles est\xE3o esperando que uma vaga se abra antes de poderem
      fazer um pedido."
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377412
    m_Localized: "Isso mostra quem \xE9 o pr\xF3ximo da fila."
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377413
    m_Localized: "\xC0s vezes, ganhar tempo ajuda, mas n\xE3o force demais."
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377414
    m_Localized: "Os clientes na fila tamb\xE9m t\xEAm paci\xEAncia."
    m_Metadata:
      m_Items: []
  - m_Id: 76866541631725568
    m_Localized: "Normalmente, n\xE3o preciso atender a todos os clientes."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020216782848
    m_Localized: Uau, que viagem!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948672
    m_Localized: "Ent\xE3o, onde estamos agora?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948673
    m_Localized: "Em algum lugar n\xE3o muito longe de Clifford."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948674
    m_Localized: "O sinal est\xE1 muito ruim por aqui."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948675
    m_Localized: "Ent\xE3o teremos que improvisar a partir daqui."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948676
    m_Localized: "Pegue outro \xF4nibus<pause:0.5> ou pe\xE7a informa\xE7\xF5es aos
      moradores locais."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948677
    m_Localized: <volume:0>...
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948678
    m_Localized: <volume:1>Embora<pause:1> isso possa ser um pequeno problema.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948679
    m_Localized: Estamos perdidos?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948680
    m_Localized: "Ah, n\xE3o seja t\xE3o dram\xE1tico(a)."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948681
    m_Localized: "Na pior das hip\xF3teses, esperamos aqui o pr\xF3ximo \xF4nibus
      e voltamos."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948682
    m_Localized: Sem chance!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948685
    m_Localized: Para encontrar aquela cidadezinha idiota.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948686
    m_Localized: "E quando eu chegar l\xE1, vou cozinhar uma quantidade absurda de
      espaguete!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948687
    m_Localized: "E os moradores locais ter\xE3o que comer at\xE9 o \xFAltimo pedacinho!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948688
    m_Localized: "E eles v\xE3o adorar!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948689
    m_Localized: '!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948691
    m_Localized: Oh.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948692
    m_Localized: "Diz que Clifford est\xE1 logo ali no final desta trilha."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948693
    m_Localized: "Ent\xE3o, o que estamos esperando?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948694
    m_Localized: Tremam, habitantes de Clifford!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948695
    m_Localized: "O vermelho est\xE1 chegando!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948696
    m_Localized: "E o grande e terr\xEDvel Vermelho n\xE3o tem medo de uma floresta
      assustadora como esta?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948697
    m_Localized: Um pouco.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948698
    m_Localized: "Mas n\xE3o \xE9 t\xE3o assustador quanto voltar atr\xE1s!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948699
    m_Localized: "Tenho certeza<pause:0.75> que n\xE3o \xE9 t\xE3o ruim quanto parece."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948700
    m_Localized: "Mais um esfor\xE7o e estaremos relaxando em Clifford depois da
      viagem."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948701
    m_Localized: E tomar drinques com guarda-chuvinhas?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948702
    m_Localized: E tomando drinques com guarda-chuvinhas.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948703
    m_Localized: Doce.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948704
    m_Localized: "Quando voc\xEA trocou de chap\xE9u?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948705
    m_Localized: Quando nossa viagem de carro se transformou em uma caminhada, seu
      bobo.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948706
    m_Localized: Olhar.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948707
    m_Localized: Acho que conseguimos.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948709
    m_Localized: Droga.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948710
    m_Localized: "Ei, veja pelo lado bom. Pelo menos n\xE3o estamos mais perdidos!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948711
    m_Localized: "E vejam s\xF3!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948712
    m_Localized: Um morador local!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948713
    m_Localized: "Ol\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948714
    m_Localized: AAAH!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948716
    m_Localized: Estamos condenados!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948718
    m_Localized: "N\xE3o se mexa, monstro da floresta!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948719
    m_Localized: "Sim,<pause:0.5> definitivamente voc\xEA."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948720
    m_Localized: "Sil\xEAncio, seu Clifforder imundo!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948721
    m_Localized: "Primeiro voc\xEAs trouxeram a doen\xE7a sobre n\xF3s!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948723
    m_Localized: "N\xE3o vamos deixar isso acontecer!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948724
    m_Localized: Acho que houve um grande mal-entendido.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948725
    m_Localized: "N\xE3o somos de Clifford.<pause:0.5> Na verdade, est\xE1vamos prestes
      a sair."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948726
    m_Localized: "Voc\xEA n\xE3o vai se safar t\xE3o f\xE1cil depois de tudo o que
      fez!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142976
    m_Localized: Ih, rapaz.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142977
    m_Localized: "Muito bem, <pause:0.5> vamos l\xE1. <pause:0.5> Nada para ver aqui."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142978
    m_Localized: "Esses dois v\xEAm comigo."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142979
    m_Localized: "Mas eles s\xE3o de Clifford!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142980
    m_Localized: "De onde eles v\xEAm n\xE3o \xE9 da sua conta.<pause:0.75> Voc\xEA
      ainda tem muito trabalho a fazer hoje!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142981
    m_Localized: "Todos voc\xEAs!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142982
    m_Localized: Mas!..
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142983
    m_Localized: "Sem \"mas\"!<pause:0.75> Ningu\xE9m te amaldi\xE7oou faz tempo?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142984
    m_Localized: "Tch!<pause:0.5> Bruxa!<pause:0.5> Vamos l\xE1,<pause:0.5> a bruxa
      encontrou um novo par de brinquedos."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142985
    m_Localized: "Quem voc\xEA est\xE1 chamando de bruxa, sua praga?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142986
    m_Localized: Nossa!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142987
    m_Localized: <volume:1>*suspiro*<pause:0.75> Siga-me,<pause:0.5> antes que eles
      mudem de ideia.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142988
    m_Localized: "Seu lugar \xE9 t\xE3o aconchegante!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142989
    m_Localized: "O que s\xE3o todas essas coisas nas prateleiras?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142990
    m_Localized: "N\xE3o toque nas antiguidades."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142991
    m_Localized: "N\xE3o estava nos planos."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142992
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142993
    m_Localized: Obrigado por nos defender.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142994
    m_Localized: "\xC9, se n\xE3o fosse por voc\xEA, eles teriam nos devorado vivos."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142995
    m_Localized: "*suspiro*<pause:0.5> Eles n\xE3o teriam comido ningu\xE9m,<pause:0.5>
      eles n\xE3o s\xE3o monstros."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142996
    m_Localized: "Eles est\xE3o simplesmente \xE0 beira de um ataque de nervos."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142997
    m_Localized: Muito provavelmente, eles simplesmente teriam te expulsado de Riverside.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142998
    m_Localized: "Na pior das hip\xF3teses, eles teriam gritado algumas coisas desagrad\xE1veis
      \u200B\u200Bpara voc\xEA."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142999
    m_Localized: "Na verdade, isso nos conv\xE9m."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143000
    m_Localized: "Est\xE1vamos apenas de passagem. N\xE3o t\xEDnhamos planos de ficar
      neste lugar esquecido por Deus..."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143001
    m_Localized: Que pena.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143002
    m_Localized: "Seria uma pena termos que deixar um lugar t\xE3o lindo com tanta
      pressa."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143004
    m_Localized: "\xC9 melhor voc\xEA ouvir os mais velhos, laranja.<pause:0.75>
      As pessoas valorizam isso por aqui."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143005
    m_Localized: "E voc\xEA n\xE3o deveria estar com tanta pressa, de qualquer forma.<pause:0.5>
      O caminho \xE0 frente \xE9 ainda mais dif\xEDcil do que aquele que o trouxe
      at\xE9 aqui."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143006
    m_Localized: "Estou correto em supor que voc\xEA est\xE1 indo para Clifford?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143007
    m_Localized: Sim, senhora!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143008
    m_Localized: "Escolha estranha, mas isso \xE9 problema seu."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143009
    m_Localized: "Nosso cavalo de tra\xE7\xE3o j\xE1 saiu para Clifford buscar rem\xE9dios.
      Ele s\xF3 volta no final da noite."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143010
    m_Localized: "A pr\xF3xima viagem \xE0 cidade ser\xE1 amanh\xE3 de manh\xE3."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143011
    m_Localized: "Ent\xE3o, at\xE9 l\xE1, \xE9 melhor ficarmos onde estamos e mantermos
      um perfil discreto?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143013
    m_Localized: "Perfeito!<pause:0.75> Ent\xE3o ficaremos aqui quietinhos e sem
      atrapalhar ningu\xE9m."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143014
    m_Localized: Raposinha esperta.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143015
    m_Localized: "Eles est\xE3o esperando por medicamentos da cidade.<pause:0.5>
      Eles est\xE3o doentes?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143016
    m_Localized: "Sim.<pause:0.75> Aqueles distra\xEDdos conseguiram pegar algum
      tipo de doen\xE7a, e agora metade da vila est\xE1 infectada."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143017
    m_Localized: "\xC9 por isso que eles t\xEAm tanto medo."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143018
    m_Localized: "Eles acham que \xE9 algum esp\xEDrito maligno, ou que o povo de
      Clifford est\xE1 por tr\xE1s disso."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143019
    m_Localized: Ou ambos.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143020
    m_Localized: "Na verdade, poder\xEDamos ajudar."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143021
    m_Localized: "Vermelho,<pause:0.5> voc\xEA tem muitos talentos,<pause:0.5> mas
      voc\xEA n\xE3o \xE9 m\xE9dico."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143022
    m_Localized: "Al\xE9m disso, n\xE3o somos exatamente bem-vindos aqui."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143023
    m_Localized: "N\xE3o, n\xE3o, cinza.<pause:0.5> Deixe-o terminar."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143024
    m_Localized: "Ent\xE3o, o que exatamente voc\xEA est\xE1 propondo, laranja?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143025
    m_Localized: "Voc\xEA tem todos os tipos de ervas aqui, e eu tenho um monte de
      utens\xEDlios de cozinha comigo!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143026
    m_Localized: "E eu conhe\xE7o a receita para uma boa sa\xFAde!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143027
    m_Localized: "Podemos fazer a sopa de galinha mais saborosa e nutritiva que esta
      aldeia j\xE1 provou!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143028
    m_Localized: "Isso \xE9...<pause:1> na verdade uma ideia muito boa."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143029
    m_Localized: "Uma boa tigela de sopa certamente os ajudar\xE1 a se sentirem melhor."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143030
    m_Localized: Vou ver se consigo convencer os moradores locais a te aturarem por
      mais um tempo.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143031
    m_Localized: "Bem, j\xE1 que estamos envolvidos, posso ajudar com as ervas."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143032
    m_Localized: "Voc\xEA sabe alguma coisa sobre ervas?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143033
    m_Localized: "Nossa m\xE3e adora arranjos florais, ent\xE3o ela me ensinou algumas
      coisas."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143034
    m_Localized: "N\xE3o sei para que servem medicinalmente, mas sei como colet\xE1-las."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143035
    m_Localized: "E consigo seguir instru\xE7\xF5es sem atrapalhar."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143036
    m_Localized: Isso serve.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143037
    m_Localized: "E j\xE1 que estamos trabalhando juntos agora, e eu n\xE3o poderei
      mais te ignorar, devemos nos apresentar."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143038
    m_Localized: Adele.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143039
    m_Localized: Prata.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143040
    m_Localized: Vermelho.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143041
    m_Localized: Que original.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143042
    m_Localized: Ah, acredite em mim, poderia ter sido muito pior.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143043
    m_Localized: "O que \xE9 que foi isso?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143044
    m_Localized: "N\xE3o se preocupe com isso."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143045
    m_Localized: "Vamos l\xE1, Vermelho e Prata, ainda temos muito trabalho a fazer."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143046
    m_Localized: "Muito bem, todos os nossos ingredientes e ervas est\xE3o \xE0 sua
      disposi\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143047
    m_Localized: "N\xE3o me fa\xE7a me arrepender disso, laranja."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143048
    m_Localized: Eu consigo.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143049
    m_Localized: "Preparar uma sopa medicinal n\xE3o deve ser muito mais dif\xEDcil
      do que cozinhar comida normal."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143050
    m_Localized: "Espero sinceramente que voc\xEA esteja certo."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143051
    m_Localized: "Vou dar uma surra t\xE3o grande nesses germes que eles nem v\xE3o
      saber o que os atingiu."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143052
    m_Localized: "Ei, isso n\xE3o \xE9 t\xE3o dif\xEDcil."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143053
    m_Localized: "N\xE3o comemore t\xE3o cedo, laranjinha."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143054
    m_Localized: "Ningu\xE9m que veio at\xE9 voc\xEA at\xE9 agora est\xE1 realmente
      doente ainda."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143055
    m_Localized: "Eles s\xF3 est\xE3o se sentindo um pouco indispostos."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143056
    m_Localized: Trouxe-lhe o seu primeiro paciente de verdade.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143057
    m_Localized: Envie-os.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143058
    m_Localized: "Eu n\xE3o vou comer o veneno do Leshy!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143059
    m_Localized: "Eu n\xE3o sou Leshy."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143060
    m_Localized: "E eu tamb\xE9m n\xE3o estou dando ouvidos a ele!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143061
    m_Localized: "*suspiro*<pause:0.75> Voc\xEA vai conseguir se quiser melhorar."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143062
    m_Localized: "Ent\xE3o eu escolho continuar doente!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143063
    m_Localized: "N\xE3o, voc\xEA escolhe melhorar, seu idiota ingrato."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143064
    m_Localized: "E isso n\xE3o \xE9 um pedido."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143065
    m_Localized: "\xD3timo. Ent\xE3o fique de boca fechada."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143066
    m_Localized: "N\xE3o d\xEA aten\xE7\xE3o \xE0s bobagens que esse idiota diz."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143067
    m_Localized: "Ele est\xE1 com febre alta desde ontem."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143068
    m_Localized: "E com sua doen\xE7a, ele arru\xEDna a vida de todos ao seu redor."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143069
    m_Localized: "Qualquer pessoa sentada ao lado dele ter\xE1 mais dificuldade em
      ser curada."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143070
    m_Localized: "Mostre-me o que voc\xEA tem, laranja."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143071
    m_Localized: Uau!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143072
    m_Localized: "Lidar com clientes doentes \xE9 realmente um transtorno."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143073
    m_Localized: "Caramba,<pause:0.5> isso n\xE3o foi f\xE1cil."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143074
    m_Localized: Eu te avisei.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143075
    m_Localized: "Mas a febre \xE9 uma das doen\xE7as mais f\xE1ceis de tratar."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143076
    m_Localized: "A mistura de cogumelos cont\xE9m bagas de sorveira. Elas devem
      ajud\xE1-lo a se sentir melhor."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143077
    m_Localized: Experimente.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143078
    m_Localized: "Certo, acho que estou come\xE7ando a entender."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143079
    m_Localized: "\xD3timo, porque n\xE3o pretendo ficar cuidando de voc\xEA o dia
      todo."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143080
    m_Localized: Ligue-me se algo der errado.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143081
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> N\xE3o,
      isso \xE9 simplesmente rid\xEDculo!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143082
    m_Localized: "N\xE3o consigo trabalhar nessas condi\xE7\xF5es."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143083
    m_Localized: "Esse seu paciente \xE9 a mula mais teimosa do mundo!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143084
    m_Localized: "\xC9 simplesmente imposs\xEDvel!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143085
    m_Localized: "\xC0s vezes acho que ele pede qualquer coisa, menos o que realmente
      precisa, s\xF3 para dificultar as coisas."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143086
    m_Localized: "Adele,<pause:0.5> Preciso que voc\xEA grite com ele."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143087
    m_Localized: "Essa \xE9 uma ideia brilhante.<pause:0.5> Algo mais?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143088
    m_Localized: "Quero que voc\xEA bata nele."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143089
    m_Localized: Escuta aqui, laranja.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143090
    m_Localized: "Vasya \xE9 um osso duro de roer, ele n\xE3o \xE9 f\xE1cil."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143091
    m_Localized: "Mas seu irm\xE3o e eu j\xE1 estamos muito ocupados."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143092
    m_Localized: "N\xE3o chegaremos muito longe se eu tiver que te ajudar com todos
      os pacientes dif\xEDceis."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143093
    m_Localized: "Eu tenho meu pr\xF3prio trabalho,<pause:0.5> e voc\xEA tem o seu."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143094
    m_Localized: "Ent\xE3o v\xE1 e resolva isso."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143095
    m_Localized: "Ei, <pause:0.5>, eu sou quem est\xE1 salvando sua vila de uma epidemia!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143096
    m_Localized: "Eu poderia ter feito exatamente o que voc\xEA me disse!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143097
    m_Localized: "Fique sentado quietinho num canto, enquanto os moradores locais
      esperam por rem\xE9dios da cidade e continuam a ficar cada vez mais doentes!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143098
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Tudo bem,
      tudo bem,<pause:0.5> voc\xEA tem raz\xE3o,<pause:0.5> Me desculpe."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143099
    m_Localized: "Mas eu realmente n\xE3o posso abandonar meu trabalho e ficar indo
      e vindo sem parar."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143100
    m_Localized: "Ent\xE3o me diga de que outra forma eu deveria conseguir falar
      com ele."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337280
    m_Localized: "Que carro\xE7a velha \xE9 essa?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337281
    m_Localized: "Este \xE9 um forno.<pause:0.5> Voc\xEA sabe como usar um desses,
      certo?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337282
    m_Localized: Sim, eu sei, mas como isso vai ajudar?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337283
    m_Localized: "Possui o dom da persuas\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337284
    m_Localized: "Se algu\xE9m provar os seus produtos de confeitaria, mudar\xE1
      imediatamente de opini\xE3o, independentemente do motivo da discuss\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337285
    m_Localized: O que?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337286
    m_Localized: "Se voc\xEA s\xF3 queria se livrar de mim, poderia ter dito."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337287
    m_Localized: "Prometo que vai funcionar. Agora v\xE1, seus pacientes est\xE3o
      esperando."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337288
    m_Localized: "Espero que isso n\xE3o seja algum tipo de piada cruel."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337289
    m_Localized: "Ele est\xE1 fazendo isso de novo."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337290
    m_Localized: Muito bem, desta vez vou dar-lhe um pretzel.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337291
    m_Localized: "E ele, magicamente, mudar\xE1 de ideia."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337292
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Isso soou
      t\xE3o bobo."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337293
    m_Localized: Ora, que surpresa!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337294
    m_Localized: Funciona mesmo!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337295
    m_Localized: "Uau.<pause:0.5> Este porquinho \xE9 realmente impaciente."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337296
    m_Localized: Para servi-lo a tempo, terei que acender o forno.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337297
    m_Localized: Sim,<pause:0.5> isso deve funcionar.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337298
    m_Localized: "Com este forno, n\xE3o tenho medo de ningu\xE9m!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337299
    m_Localized: "Sou impar\xE1vel!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337300
    m_Localized: "Que diabos \xE9 isso?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337301
    m_Localized: "Bem, seja l\xE1 o que for toda essa confus\xE3o, n\xE3o \xE9 problema
      meu."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337302
    m_Localized: Principalmente quando estou de folga.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337303
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Agora.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337304
    m_Localized: "Voc\xEA acha que isso conta como um rem\xE9dio?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337305
    m_Localized: "Provavelmente n\xE3o.<pause:0.5> \xC9 apenas uma sopa com ervas."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337306
    m_Localized: "Sim, mas ent\xE3o o que conta como rem\xE9dio sen\xE3o sopa com
      ervas?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337307
    m_Localized: "Hum,<pause:0.5> essa \xE9<pause:0.75> uma observa\xE7\xE3o muito
      interessante."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337308
    m_Localized: O aprendiz de alquimista superou seu mestre!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337309
    m_Localized: Foco!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337310
    m_Localized: "Ah, qual \xE9,<pause:0.5> foi engra\xE7ado!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337311
    m_Localized: "A cozinha n\xE3o \xE9 lugar para brincadeiras!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337312
    m_Localized: "Esta \xE9 a nossa oficina, e aqui estamos criando coisas incr\xEDveis!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337313
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Mesmo
      assim, foi engra\xE7ado."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337314
    m_Localized: "Tudo bem, foi um pouco engra\xE7ado."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337315
    m_Localized: "Uma pequena vit\xF3ria!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337316
    m_Localized: "Voc\xEA \xE9 um verdadeiro patife!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337317
    m_Localized: "Voc\xEA ouviu isso?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337318
    m_Localized: "Isso n\xE3o \xE9 nenhum tipo de rem\xE9dio para doen\xE7as, \xE9
      apenas uma sopa comum!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337319
    m_Localized: "Bem, n\xE3o sei, Vasya.<pause:0.5> Na verdade, me sinto melhor
      depois de tomar a bebida dele."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337320
    m_Localized: "E \xE9 a sopa mais saborosa que j\xE1 comi!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337321
    m_Localized: Aproveite enquanto pode.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337322
    m_Localized: "\xC9 \xF3bvio que ele est\xE1 nos engordando para que tenhamos
      um gosto melhor."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337323
    m_Localized: "Voc\xEA perdeu completamente a cabe\xE7a?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337324
    m_Localized: "Voc\xEA vai mesmo acusar Leshy de alguma coisa agora?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337325
    m_Localized: "Ter\xEDamos expulsado aquele Leshy n\xF3s mesmos se n\xE3o fosse
      por aquela bruxa maldita!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337326
    m_Localized: "Eu n\xE3o sou Le..."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337327
    m_Localized: "Espera a\xED, acabei de ouvir algu\xE9m desrespeitando o grande
      Leshy?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337328
    m_Localized: "N\xE3o fui eu!<pause:0.5> Foi tudo culpa dele!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337329
    m_Localized: "Eu?!<pause:0.5> Eu n\xE3o fiz nada!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337330
    m_Localized: Heheh.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337331
    m_Localized: '*sigh*'
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337332
    m_Localized: Ele se libertou!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337333
    m_Localized: Salvem-se todos!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337334
    m_Localized: Corram para salvar suas vidas!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337335
    m_Localized: "Oh, que maravilha! Temos convidados e voc\xEAs prepararam um piquenique
      t\xE3o ador\xE1vel!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337336
    m_Localized: "E ningu\xE9m me convidou. Seus patifes."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337337
    m_Localized: Boris, volte para casa agora!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337338
    m_Localized: "Levaremos a sua comida at\xE9 voc\xEA."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337339
    m_Localized: Voltar para dentro?<pause:0.5> Ah, de jeito nenhum!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337340
    m_Localized: "N\xE3o vou perder nenhuma divers\xE3o com nossos novos amiguinhos
      peludos!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337341
    m_Localized: "Boris, eu imploro a voc\xEA, voc\xEA vai destruir este lugar inteiro."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337342
    m_Localized: "N\xE3o seja t\xE3o dram\xE1tica, Adele.<pause:0.5> Eu n\xE3o espirro
      t\xE3o forte assim."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337343
    m_Localized: "Vou ficar aqui sentada com voc\xEAs. N\xE3o vou incomodar ningu\xE9m!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337344
    m_Localized: "Recebemos visitas t\xE3o raramente!<pause:0.5> De jeito nenhum
      vou perder isso!"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337345
    m_Localized: "Escute com aten\xE7\xE3o, Vermelho."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337346
    m_Localized: "Fa\xE7a o que for preciso, mas n\xE3o o deixe espirrar."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337347
    m_Localized: "Se ele fizer muito estrago, teremos que reconstruir este lugar
      a partir das ru\xEDnas."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337348
    m_Localized: "N\xE3o vou te decepcionar."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337349
    m_Localized: "O Juramento do Hipop\xF3tamo."
    m_Metadata:
      m_Items: []
  - m_Id: 95027885946068992
    m_Localized: "Ei, para onde voc\xEA vai?"
    m_Metadata:
      m_Items: []
  - m_Id: 95028971859763200
    m_Localized: "Quer dizer, para onde voc\xEA est\xE1 indo?<pause:0.75> Voc\xEA
      acabou de passar direto por uma placa."
    m_Metadata:
      m_Items: []
  - m_Id: 95032048352387072
    m_Localized: "N\xE3o viemos at\xE9 aqui para desistir agora!"
    m_Metadata:
      m_Items: []
  - m_Id: 95060151254540288
    m_Localized: "N\xE3o, este n\xE3o \xE9 Clifford. Este \xE9 Riverside. Viu?"
    m_Metadata:
      m_Items: []
  - m_Id: 95060151283900416
    m_Localized: Aquele maldito Clifforder trouxe Leshy para a nossa aldeia!
    m_Metadata:
      m_Items: []
  - m_Id: 95060151283900417
    m_Localized: Eu? Leshy?
    m_Metadata:
      m_Items: []
  - m_Id: 95060151283900418
    m_Localized: "E agora voc\xEA resolveu mandar o Leshy atr\xE1s de n\xF3s!"
    m_Metadata:
      m_Items: []
  - m_Id: 95336547382091776
    m_Localized: Principalmente depois de ter irritado acidentalmente os moradores
      locais.
    m_Metadata:
      m_Items: []
  - m_Id: 95336547411451904
    m_Localized: "Exatamente.<pause:0.5> A menos que o malvado Leshy e o imundo Clifforder
      queiram testar ainda mais a paci\xEAncia dos moradores locais."
    m_Metadata:
      m_Items: []
  - m_Id: 95703245004103680
    m_Localized: Ohhh,<pause:0.5> muito obrigado a todos.
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463808
    m_Localized: "Fazia muito tempo que eu n\xE3o me divertia tanto!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463809
    m_Localized: "Nestes \xFAltimos dias, todos estiveram t\xE3o ocupados e preocupados
      que quase me esqueci de como era essa sensa\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463810
    m_Localized: "E agora estamos todos sentados \xE0 mesma mesa novamente!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463811
    m_Localized: "Compartilhando comidas deliciosas e hist\xF3rias!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463812
    m_Localized: "E olhem para mim!<pause:0.5> J\xE1 consigo sentir que estou muito
      melhor!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463813
    m_Localized: "Todos n\xF3s!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463814
    m_Localized: "Tudo isso gra\xE7as a voc\xEAs!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463816
    m_Localized: "Viva Leshy, o m\xE9dico!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463817
    m_Localized: "Vamos l\xE1, Vasya, voc\xEA sabe o que deve dizer!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463819
    m_Localized: "E agora venham c\xE1, vou dar um abra\xE7o em todos voc\xEAs!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463820
    m_Localized: "Boris, o que voc\xEA est\xE1 fazendo?!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463821
    m_Localized: "Por mais gentil que Leshy tenha sido hoje, ele ainda \xE9 um monstro
      da floresta!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463822
    m_Localized: Ele vai te devorar!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463824
    m_Localized: "Ele ajudou meus amigos, e eu vou abra\xE7\xE1-lo, aconte\xE7a o
      que acontecer!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463825
    m_Localized: "Boris, seja razo\xE1vel, n\xE3o seja."
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463826
    m_Localized: "Sentir-se melhor n\xE3o significa que voc\xEA j\xE1 esteja completamente
      recuperado."
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463827
    m_Localized: Ah, pare de fazer drama, seu medroso!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463828
    m_Localized: Estou chegando!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463829
    m_Localized: "Espere um segundo!<pause:0.5> Ent\xE3o ele n\xE3o \xE9 o Leshy!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463830
    m_Localized: "Ele \xE9 apenas uma raposinha mal-humorada!"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463831
    m_Localized: Nossa!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463832
    m_Localized: "Por que voc\xEA n\xE3o me disse que n\xE3o era Leshy?"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463834
    m_Localized: "Espero que voc\xEA esteja orgulhoso de si mesmo."
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463835
    m_Localized: Claro.
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463836
    m_Localized: Chega de brigas, raposinhas.
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463837
    m_Localized: "Vamos l\xE1, vamos conversar sobre o que faremos com voc\xEA em
      seguida."
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463838
    m_Localized: Oh...
    m_Metadata:
      m_Items: []
  - m_Id: 95707377475674112
    m_Localized: <volume:1>Viva!
    m_Metadata:
      m_Items: []
  - m_Id: 95708385291427840
    m_Localized: Viva a Tia Adele, o Clifforder e o Leshy!
    m_Metadata:
      m_Items: []
  - m_Id: 95711446944604160
    m_Localized: "N\xE3o me importo, mesmo que ele fosse o pr\xF3prio diabo!"
    m_Metadata:
      m_Items: []
  - m_Id: 95711446944604161
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Vou explodir
      de indigna\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 95712882495479808
    m_Localized: Clifford
    m_Metadata:
      m_Items: []
  - m_Id: 96172734023884800
    m_Localized: "Ol\xE1, raposinha."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734023884801
    m_Localized: "Ol\xE1, cavalinho."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734023884802
    m_Localized: Indo para a cidade grande em busca de sucesso, hein?
    m_Metadata:
      m_Items: []
  - m_Id: 96172734023884803
    m_Localized: "Na verdade, n\xE3o, muito pelo contr\xE1rio."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734028079104
    m_Localized: "Est\xE1vamos t\xE3o cansados \u200B\u200Bde tentar fazer sucesso
      na cidade grande que decidimos come\xE7ar em um lugar menor."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734028079105
    m_Localized: Clifford?<pause:0.5> Pequeno?!
    m_Metadata:
      m_Items: []
  - m_Id: 96172734028079106
    m_Localized: Sim, sempre foi assim.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734028079107
    m_Localized: Eu sempre achei que fosse enorme.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734032273408
    m_Localized: "Silver disse que Clifford tem aproximadamente o tamanho de um \xFAnico
      distrito em Metr\xF3polis."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734032273409
    m_Localized: Uau.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734032273410
    m_Localized: "Eu sempre quis chegar l\xE1,<pause:0.5> para ver uma cidade grande."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734032273411
    m_Localized: "Eu sabia que n\xE3o era o maior de todos."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187968
    m_Localized: Mas eu tinha certeza de que deveria estar pelo menos entre os dez
      melhores.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187969
    m_Localized: "E agora voc\xEA est\xE1 me dizendo isso."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187970
    m_Localized: "Isso \xE9 meio decepcionante, na verdade."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187971
    m_Localized: "Ent\xE3o, por que voc\xEA n\xE3o vai?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187972
    m_Localized: "Eu n\xE3o consigo,<pause:0.5> Eu ainda sou muito pequeno."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187973
    m_Localized: "Olhe s\xF3 para voc\xEA!<pause:0.5> Voc\xEA \xE9 grande e forte!"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187974
    m_Localized: "Voc\xEA est\xE1 puxando a mim, meu irm\xE3o e todo esse carrinho
      sozinho!"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187975
    m_Localized: "N\xE3ooo,<pause:0.5> Quer dizer, eu ainda n\xE3o tenho idade suficiente."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187976
    m_Localized: "Voc\xEA j\xE1 tentou pedir para algu\xE9m mais velho te levar at\xE9
      a cidade?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187977
    m_Localized: "N\xE3o posso."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187978
    m_Localized: Meu pai leva pessoas para Clifford e as traz de volta todos os dias.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187979
    m_Localized: "Alguns de n\xF3s moramos aqui, mas trabalhamos na cidade, como
      a tia Adele."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187980
    m_Localized: "E eu devo ficar na vila por precau\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187981
    m_Localized: "Enquanto papai est\xE1 fora, s\xF3 eu sei como usar o carrinho."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187982
    m_Localized: Ele sempre me diz para esquecer minhas responsabilidades por um
      dia.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187983
    m_Localized: Para entrar na cidade com ele.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187984
    m_Localized: "Mas eu simplesmente n\xE3o consigo."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187985
    m_Localized: E se algo acontecer enquanto eu estiver me divertindo?
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187986
    m_Localized: "Como hoje, por exemplo.<pause:0.5> Voc\xEAs dois apareceram do
      nada."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187987
    m_Localized: "Quem teria te levado \xE0 cidade se eu n\xE3o estivesse aqui?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187988
    m_Localized: "Acho que ter\xEDamos que esperar at\xE9 de manh\xE3 e ir com seu
      pai."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187989
    m_Localized: "E esperar \xE9 algo que realmente n\xE3o podemos nos dar ao luxo
      de fazer agora."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187990
    m_Localized: "Temos um empr\xE9stimo pendente e precisamos come\xE7ar a pag\xE1-lo
      o mais r\xE1pido poss\xEDvel."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187991
    m_Localized: "Voc\xEA nos ajudou muito."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187992
    m_Localized: "Raposinha, <pause:0.5> qual \xE9 o seu nome?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187993
    m_Localized: Vermelho.<pause:0.5> E o seu?
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187994
    m_Localized: Eu sou Daisy.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187995
    m_Localized: "Prazer em conhec\xEA-la, Daisy."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187996
    m_Localized: "Vermelho,<pause:0.5> como \xE9 viver em uma cidade ainda maior
      que Clifford?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187997
    m_Localized: "N\xE3o \xE9... o lugar mais seguro."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187998
    m_Localized: "Daisy,<pause: 0.5> por que as pessoas de Riverside n\xE3o gostam
      tanto de Clifford, <pause:0.5> mas ainda assim tentam chegar l\xE1?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095187999
    m_Localized: "N\xE3o sei.<pause:0.5> Sempre foi uma rela\xE7\xE3o complicada."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188000
    m_Localized: "E depois houve toda aquela hist\xF3ria com a estrada nova."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188001
    m_Localized: O que aconteceu?
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188002
    m_Localized: "Descobrimos recentemente que est\xE3o construindo uma estrada de
      Clifford at\xE9 a rodovia principal."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188003
    m_Localized: "Est\xE1vamos todos animados, pensando que o trem passaria pela
      nossa aldeia e finalmente nos daria uma maneira f\xE1cil de chegar \xE0 cidade."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188004
    m_Localized: "Mas acabou que eles est\xE3o construindo atrav\xE9s do deserto
      em vez de nossa floresta para economizar um pouco de dinheiro."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188005
    m_Localized: "Eu n\xE3o deixo ningu\xE9m ver isso, mas entre voc\xEA e eu, isso
      realmente d\xF3i."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188006
    m_Localized: Se a aldeia tivesse uma estrada e ao menos um carro, eu me preocuparia
      muito menos.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188007
    m_Localized: "Eu saberia que os alde\xF5es n\xE3o estariam em perigo sem a minha
      presen\xE7a."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188008
    m_Localized: Desculpe.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188009
    m_Localized: "Se algum dia voc\xEA vier \xE0 cidade, venha nos visitar."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188010
    m_Localized: Vamos abrir um restaurante.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188011
    m_Localized: "Ainda n\xE3o decidimos o nome, mas voc\xEA saber\xE1 quando vir."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188012
    m_Localized: "Vai ser o lugar mais incr\xEDvel do mundo!<pause:0.5> Voc\xEA n\xE3o
      vai conseguir perder."
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188013
    m_Localized: "Uau,<pause:0.5> isso parece incr\xEDvel!"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188014
    m_Localized: Eu adoraria!
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188015
    m_Localized: E a sua sopa estava realmente deliciosa!
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188016
    m_Localized: "Com certeza darei uma passada por l\xE1 se tiver a oportunidade!"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188017
    m_Localized: Fechado.
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188018
    m_Localized: "Ah,<pause:0.5>, \xE9 aquela rodovia com o ponto de \xF4nibus?"
    m_Metadata:
      m_Items: []
  - m_Id: 96172734095188019
    m_Localized: Exatamente!
    m_Metadata:
      m_Items: []
  - m_Id: 96177215478325248
    m_Localized: Oh...
    m_Metadata:
      m_Items: []
  - m_Id: 96391525269921792
    m_Localized: "Tenho que admitir, voc\xEAs dois fizeram um trabalho excelente,
      raposinhas."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087616
    m_Localized: "Os moradores de Riverside est\xE3o se sentindo muito melhor agora."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087617
    m_Localized: "E talvez agora essa ca\xE7a \xE0s bruxas finalmente chegue ao fim."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087618
    m_Localized: "Ent\xE3o voc\xEA \xE9 mesmo uma bruxa, afinal!"
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087619
    m_Localized: "Eu sou t\xE3o bruxa quanto voc\xEA \xE9 Leshy."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087620
    m_Localized: "Sou vidente, e uma p\xE9ssima, diga-se de passagem. Mas, pensando
      bem, todas as videntes s\xE3o assim."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087621
    m_Localized: Mas para os habitantes locais, tanto faz.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087622
    m_Localized: "Eles acreditar\xE3o de bom grado at\xE9 na explica\xE7\xE3o mais
      inacredit\xE1vel."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087623
    m_Localized: "Voc\xEA me distraiu."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087624
    m_Localized: "Voc\xEAs dois trabalharam muito e mereceram uma recompensa."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087625
    m_Localized: "Tenho alguma influ\xEAncia tanto aqui como em Clifford."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087626
    m_Localized: "E por acaso tamb\xE9m possuo algumas coisinhas interessantes."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087627
    m_Localized: "Cada um de voc\xEAs tem direito a um desejo."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087628
    m_Localized: "Escolha com sabedoria, mas n\xE3o seja ganancioso."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087629
    m_Localized: Quero ficar com esse forno.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087630
    m_Localized: "Voc\xEA n\xE3o pede favores pequenos, pede, Vermelho?"
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087631
    m_Localized: "Mas \xE9 um pre\xE7o justo, considerando o que voc\xEA fez."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087632
    m_Localized: "Al\xE9m disso, j\xE1 est\xE1 acumulando poeira aqui mesmo."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087633
    m_Localized: Eu odeio cozinhar.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087634
    m_Localized: "\xC9 seu."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087635
    m_Localized: "E voc\xEA, Silver?<pause:0.5> O que voc\xEA quer?"
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087636
    m_Localized: "Quero que voc\xEA nos leve at\xE9 Clifford o mais r\xE1pido poss\xEDvel."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087637
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> \xD3timo."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087638
    m_Localized: "Temos um plano B para emerg\xEAncias."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087639
    m_Localized: Suponho que <pause:0.5> hoje se qualifica.
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087640
    m_Localized: "Mas se ela voltar reclamando que voc\xEAs dois a trataram mal..."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087641
    m_Localized: Seremos cavalheiros perfeitos!
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087642
    m_Localized: "Essa \xE9 a resposta correta."
    m_Metadata:
      m_Items: []
  - m_Id: 96391525295087643
    m_Localized: "Arrumem suas coisas, o pr\xF3ximo transporte para Clifford sai
      em dez minutos."
    m_Metadata:
      m_Items: []
  - m_Id: 96395963300732928
    m_Localized: "De qualquer forma, est\xE1vamos apenas de passagem."
    m_Metadata:
      m_Items: []
  - m_Id: 96395963321704448
    m_Localized: "N\xE3o t\xEDnhamos planos de ficar por aqui neste lugar maldito..."
    m_Metadata:
      m_Items: []
  - m_Id: 96784338562211840
    m_Localized: Beira-rio
    m_Metadata:
      m_Items: []
  - m_Id: 96989101652336640
    m_Localized: Acordem, raposinhas!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696768
    m_Localized: "Estamos quase l\xE1!"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696769
    m_Localized: "Hein?<pause:0.5> O qu\xEA?"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696770
    m_Localized: Abra os olhos, Vermelho!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696771
    m_Localized: Chegamos!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696772
    m_Localized: Uau!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696773
    m_Localized: Visto daqui de cima, parece realmente enorme!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696774
    m_Localized: Viu? Eu te disse!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696775
    m_Localized: "Um dia eu virei aqui por conta pr\xF3pria!"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696776
    m_Localized: E eu explorarei cada canto de Clifford!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696777
    m_Localized: Mas agora preciso ir para casa.
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696778
    m_Localized: "Vai escurecer em breve, e meu pai come\xE7ar\xE1 a se preocupar."
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696779
    m_Localized: "Sinto muito, n\xE3o posso te levar mais longe."
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696780
    m_Localized: "Tudo bem, querida.<pause:0.5> Voc\xEA j\xE1 nos ajudou mais do
      que o suficiente."
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696781
    m_Localized: Podemos encontrar o caminho para nossa nova casa a partir daqui.
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696782
    m_Localized: Nosso novo lar?!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696783
    m_Localized: "Voc\xEAs j\xE1 compraram um pr\xE9dio para n\xF3s?!"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696784
    m_Localized: "Oh, n\xE3o.<pause:0.5> Comprar um im\xF3vel online seria muito
      imprudente."
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696785
    m_Localized: Mas encontrei um lugar muito promissor!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696786
    m_Localized: E tenho um pressentimento muito bom sobre isso!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696787
    m_Localized: "Ent\xE3o podemos ir para l\xE1 agora mesmo!"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696788
    m_Localized: "Ent\xE3o, o que estamos esperando?!"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696789
    m_Localized: Lidere o caminho!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696790
    m_Localized: Tchau, raposinhas!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696791
    m_Localized: Tchau, Daisy!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696792
    m_Localized: Boa viagem, Daisy!
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696793
    m_Localized: "Vamos l\xE1, Vermelho."
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696794
    m_Localized: "Aquele lugar n\xE3o vai se regularizar sozinho."
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696795
    m_Localized: "\xC9 melhor voc\xEA come\xE7ar a tremer, casinha!"
    m_Metadata:
      m_Items: []
  - m_Id: 96989101681696796
    m_Localized: "Voc\xEA n\xE3o faz ideia de como vou te inspecionar minuciosamente!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
