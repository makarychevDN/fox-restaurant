%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogues_fr-FR
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: fr-FR
  m_SharedData: {fileID: 11400000, guid: 76c0caf3be1b6134fac28638aa766eea, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 96960955703296
    m_Localized: '*soupir*<pause:1> Un jour de plus, un dollar de plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 102732733243392
    m_Localized: Mince alors,<pause:0.5> ce gamin a l'air costaud,<pause:0.5> il
      a besoin d'au moins deux glaces.
    m_Metadata:
      m_Items: []
  - m_Id: 102851926974464
    m_Localized: "Un grand gar\xE7on, hein ?<pause:0.75> Plus ils sont grands, plus
      dure est la chute."
    m_Metadata:
      m_Items: []
  - m_Id: 102931308371968
    m_Localized: Vieille camelote stupide.
    m_Metadata:
      m_Items: []
  - m_Id: 103157167448064
    m_Localized: "Il faut nettoyer le d\xE9sordre."
    m_Metadata:
      m_Items: []
  - m_Id: 103200687546368
    m_Localized: "O\xF9 se trouve la poubelle ?"
    m_Metadata:
      m_Items: []
  - m_Id: 103255913947136
    m_Localized: "Ah,<pause:0.5> te voil\xE0."
    m_Metadata:
      m_Items: []
  - m_Id: 103266819137536
    m_Localized: "D\xE9gagez, petits sales types."
    m_Metadata:
      m_Items: []
  - m_Id: 103795813146624
    m_Localized: "Oh,<pause:0.5> wow.<pause:0.5> La premi\xE8re commande complexe
      du jour."
    m_Metadata:
      m_Items: []
  - m_Id: 103882635239424
    m_Localized: C'est encore trop facile.
    m_Metadata:
      m_Items: []
  - m_Id: 103985789952000
    m_Localized: "Il faut m\xE9langer les ingr\xE9dients."
    m_Metadata:
      m_Items: []
  - m_Id: 104019986112512
    m_Localized: "*soupir*<pause:1> Je me demande ce que \xE7a fait de cuisiner de
      vrais plats ?"
    m_Metadata:
      m_Items: []
  - m_Id: 104142648532992
    m_Localized: Oh,<pause:0.5> le vrai jeu commence.
    m_Metadata:
      m_Items: []
  - m_Id: 104186449649664
    m_Localized: "C'est facile.<pause:0.5> Ce truc fait appara\xEEtre des objets,<pause:0.5>
      Je les utilise."
    m_Metadata:
      m_Items: []
  - m_Id: 104222092845056
    m_Localized: "L'essentiel est d'\xE9viter qu'il ne se bouche."
    m_Metadata:
      m_Items: []
  - m_Id: 104300811542528
    m_Localized: "*soupir*<pause:1> Tous les jours \xE0 la m\xEAme heure."
    m_Metadata:
      m_Items: []
  - m_Id: 104452712456192
    m_Localized: 'Oh,<pause: 0.5> c''est encore toi, Rouge <pause:0.5>PAS<pause:0.5>
      un Cuisinier.'
    m_Metadata:
      m_Items: []
  - m_Id: 104546270601216
    m_Localized: "Yarrr,<pause: 0.5> bienvenue \xE0 bord, jeune marin."
    m_Metadata:
      m_Items: []
  - m_Id: 104596988125184
    m_Localized: Je n'ai pas besoin de vos salutations, Rouge <pause:0.5>NOT<pause:0.5>
      un cuisinier.
    m_Metadata:
      m_Items: []
  - m_Id: 104702047051776
    m_Localized: J'ai besoin que vous travailliez plus vite, pas plus fort.
    m_Metadata:
      m_Items: []
  - m_Id: 104734192197632
    m_Localized: Sais-tu que c'est un restaurant pour enfants ?
    m_Metadata:
      m_Items: []
  - m_Id: 104799568814080
    m_Localized: Pff.<pause:0.5> Cet endroit est plein de pirates.
    m_Metadata:
      m_Items: []
  - m_Id: 104851519463424
    m_Localized: Les pirates sont trop effrayants pour eux,<pause:0.5> donc <pause:0.5>OUI,<pause:0.5>
      c'est clairement pour les adultes.
    m_Metadata:
      m_Items: []
  - m_Id: 104919387496448
    m_Localized: "Au moins, vous n'\xEAtes pas trop vieux pour \xE7a."
    m_Metadata:
      m_Items: []
  - m_Id: 105019983683584
    m_Localized: "J'ai l'\xE2ge id\xE9al pour cet endroit, alors, <pause:0.5>OUI."
    m_Metadata:
      m_Items: []
  - m_Id: 105266793308160
    m_Localized: "Et j'ai besoin de calories pour \xEAtre en pleine forme.<pause:0.5>
      Alors, d\xE9p\xEAche-toi, Rouge <pause:0.5>PAS<pause:0.5> un cuisinier."
    m_Metadata:
      m_Items: []
  - m_Id: 105471504703488
    m_Localized: 'Pfft.<pause: 0.5> Ce n''est pas parce que vous l''avez fait que
      vous l''avez bien fait,<pause: 0.5> Rouge <pause:0.5>PAS<pause:0.5> un cuisinier.'
    m_Metadata:
      m_Items: []
  - m_Id: 105543625760768
    m_Localized: "Yarrr,<pause: 0.5> nous esp\xE9rons vous revoir bient\xF4t, jeune
      marin."
    m_Metadata:
      m_Items: []
  - m_Id: 105608289345536
    m_Localized: "Oh, <pause:0.5>OUI, <pause:0.5>ne<pause: 0.5>PAS<pause: 0.5>h\xE9siter.<pause:1>
      Tu me verras bient\xF4t."
    m_Metadata:
      m_Items: []
  - m_Id: 105693555351552
    m_Localized: Et je ne serai pas aussi indulgent avec toi la prochaine fois.
    m_Metadata:
      m_Items: []
  - m_Id: 105789357449216
    m_Localized: "\xC0 plus tard, Red <pause:0.5>NOT<pause:0.5> un cuisinier."
    m_Metadata:
      m_Items: []
  - m_Id: 107592824283136
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Enfin.
    m_Metadata:
      m_Items: []
  - m_Id: 107662542004224
    m_Localized: "Waouh,<pause:0.5> c'est d\xE9j\xE0 l'heure de la pause."
    m_Metadata:
      m_Items: []
  - m_Id: 131328193486848
    m_Localized: "Mince alors...<pause:1> Bon, on va r\xE9essayer."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674043346944
    m_Localized: Enfin, un moment de paix.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124160
    m_Localized: "Yarr ! <pause:0.75> Alors, matelot, tu pensais vraiment que ta
      premi\xE8re journ\xE9e se d\xE9roulerait sans accroc ?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124161
    m_Localized: Je travaille ici depuis plus d'un an.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124162
    m_Localized: Yarr ! <pause:0.75> Je n'y comprends rien ! <pause:0.75> Tu as l'air
      d'un terrien !
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124163
    m_Localized: "Je ne veux pas parler comme \xE7a quand je ne suis pas \xE0 la
      caisse.<pause:0.75> C'est<pause:0.5> ridicule."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124164
    m_Localized: Nous ne sommes pas des pirates dans la vraie vie.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124165
    m_Localized: <volume:0>...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124166
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> *soupir*
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124167
    m_Localized: Yarr!<pause:0.75> Capitaine,<pause:0.75> Je suis sur ce voyage depuis
      plus d'un an !
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124168
    m_Localized: "<volume:1>Yarr!<pause:0.75> Voil\xE0 qui est mieux!<pause:0.75>
      Continuez comme \xE7a et le tr\xE9sor ne tardera pas \xE0 arriver!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124169
    m_Localized: "En parlant de tr\xE9sor\u2026 Je voulais en fait aborder ma promotion
      et\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124170
    m_Localized: Courage, marin !
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124171
    m_Localized: "Je ne sais pas ce qui vous est arriv\xE9 sur le rivage."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124172
    m_Localized: "Mais si tu continues \xE0 te balader avec cette mine renfrogn\xE9e,
      tu vas faire fuir tous mes clients !<pause:0.75> Yarr !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124173
    m_Localized: C'est juste...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124174
    m_Localized: ...mon visage.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124175
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Chien
      sourd b\xE2tard."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124176
    m_Localized: "D\xE9j\xE0?!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124177
    m_Localized: Je vous jure, les pauses sont de plus en plus courtes chaque jour
      !
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124178
    m_Localized: "Je vais lui montrer.<pause:1> Je vais leur montrer \xE0 tous."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124179
    m_Localized: J'ouvrirai mon propre restaurant,<pause:0.5> j'embaucherai jusqu'au
      dernier d'entre eux,<pause:0.5> et je leur donnerai ensuite les pauses les
      plus courtes imaginables.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124180
    m_Localized: Et je vais m'accorder une pause excessivement longue !
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124181
    m_Localized: "Mais je n'aurai m\xEAme pas envie de l'utiliser, tellement mon
      appartement sera incroyable !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124182
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Apr\xE8s
      r\xE9flexion, je devrais peut-\xEAtre le rendre un peu moins extraordinaire."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124183
    m_Localized: Sinon, ils ne voudront plus du tout faire de pauses.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124184
    m_Localized: Oh,<pause:0.75> c'est encore elle.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124185
    m_Localized: "Elle a besoin d'une approche particuli\xE8re. Elle regarde ce que
      les autres mangent et commande la m\xEAme chose."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124186
    m_Localized: "La pauvre a tendance \xE0 douter."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124187
    m_Localized: "Et voil\xE0 !<pause:0.75> De la glace pour tout le monde !<pause:0.75>
      Et je n'ai m\xEAme pas transpir\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124188
    m_Localized: <volume:0>...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124189
    m_Localized: Yarr,<pause:0.75> tout va bien, jeune marin ?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124190
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Je voulais
      juste vous remercier !<pause:0.5> Vous avez \xE9t\xE9 tr\xE8s patient."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124191
    m_Localized: "En g\xE9n\xE9ral, les adultes jurent quand j'ai beaucoup de doutes."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124192
    m_Localized: "Yarr,<pause:0.5> ne t'inqui\xE8te pas, jeune marin,<pause:0.5>
      et reviens quand tu veux !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124193
    m_Localized: "Tu es g\xE9nial !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124194
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Hm,<pause:0.75>
      peut-\xEAtre que cette journ\xE9e<pause:0.75> n'est pas si mauvaise apr\xE8s
      tout."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124195
    m_Localized: "H\xE9,<pause:0.5> Rouge,<pause:0.5> allez,<pause:0.5> on doit parler."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124196
    m_Localized: "Embauch\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124197
    m_Localized: Salut Stan.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124198
    m_Localized: Mes yeux sont plus bas.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124199
    m_Localized: Oh.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124200
    m_Localized: Ouais,<pause:0.75> c'est mieux.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124201
    m_Localized: Alors, que vouliez-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124202
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Je dois
      aller dans la salle \xE0 manger dans une minute."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124203
    m_Localized: Quoi ?!<pause:0.75> Non !<pause:0.75> Je m'y oppose !
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124204
    m_Localized: "Le capitaine a dit qu'il me donnerait en p\xE2ture aux poissons<pause:0.5>
      si je ne le faisais pas."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124205
    m_Localized: "Je ne suis pas tout \xE0 fait s\xFBr de ce que cela signifie en
      termes simples, mais je suis certain que ce n'est rien de bon."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124206
    m_Localized: "Mais les enfants adorent Joe \xE0 la jambe de bois !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124207
    m_Localized: "Ils vont tout saccager s'ils te voient d\xE9guis\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124208
    m_Localized: "Je ne pourrai pas g\xE9rer autant de clients !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124209
    m_Localized: "Il nous faut au moins trois personnes \xE0 la caisse pour pouvoir
      suivre le rythme !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124210
    m_Localized: "Et je suis tout seul aujourd'hui !<pause:0.75> Souvenez-vous de
      ce qui s'est pass\xE9 la derni\xE8re fois !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124211
    m_Localized: Je sais.<pause:0.75> C'est pourquoi je suis venu en discuter.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124212
    m_Localized: "Alors,<pause:0.5>, avez-vous r\xE9ellement un plan ?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124213
    m_Localized: "Oui,<pause:0.5> soir\xE9e cin\xE9ma.<pause:0.5> Tu tires les rideaux,<pause:0.5>
      tu allumes le projecteur,<pause:0.5> et je veillerai \xE0 ce que tout le monde
      fasse moins de bruit."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124214
    m_Localized: "Soir\xE9e cin\xE9ma, hein ?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124215
    m_Localized: Cela signifie que je vais devoir m'occuper du menu du soir avec
      les cocktails.<pause:0.75> Ce ne sera pas facile.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124216
    m_Localized: "C'est quand m\xEAme plus simple que si tous les enfants du quartier
      accouraient ici en m\xEAme temps."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124217
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Ouais,<pause:0.5>
      tu as raison.<pause:0.75> Tu es un g\xE9nie, Stan.<pause:0.75> Faisons-le."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124218
    m_Localized: Accord.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124219
    m_Localized: "Tr\xE8s bien,<pause:0.75> essayons ceci.<pause:1> 3,<pause:1> 2<pause:1>
      1.<pause:1> Allez !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124220
    m_Localized: "Oh mon Dieu,<pause:0.4> c'est Joe \xE0 la jambe de bois !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124221
    m_Localized: "Hourra, Joe la Jambe de Bois ! Emm\xE8ne-moi faire un tour !!!"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124222
    m_Localized: Moi aussi!!!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674060124223
    m_Localized: "Yarr!<pause:0.75> Joe Jambe de Bois ne se sent pas au mieux de
      sa forme aujourd'hui,<pause:0.4> alors on va garder \xE7a pour nous."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318464
    m_Localized: Oh,<pause:0.75> ce n'est pas juste !
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318465
    m_Localized: Je pensais qu'on allait s'amuser.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318466
    m_Localized: "Ne t'inqui\xE8te pas, jeune marin,<pause:0.75> on n'a pas besoin
      de faire du bruit pour s'amuser !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318467
    m_Localized: "Par exemple,<pause:0.75> nous pourrions regarder un dessin anim\xE9
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318468
    m_Localized: "Les dessins anim\xE9s, c'est bien."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318469
    m_Localized: "Seulement si c'est int\xE9ressant !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318470
    m_Localized: "J'esp\xE8re qu'il y a une \xE9toile de mer dedans..."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318471
    m_Localized: "Yarr,<pause:0.75> bien s\xFBr que c'est int\xE9ressant !<pause:0.75>
      Mais nous allons le regarder discr\xE8tement.<pause:0.5> March\xE9 conclu,
      jeunes marins ?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318472
    m_Localized: Accord!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318473
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> \xC7a
      a march\xE9 !<pause:0.75> Personne n'est venu !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318474
    m_Localized: Je vous l'avais dit !<pause:0.75> Un plan infaillible !
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318475
    m_Localized: "Il ne reste plus qu'une chose \xE0 faire.<pause:0.75> Retour au
      travail !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318476
    m_Localized: Ouf,<pause:0.5> jeunes marins,<pause:0.5> qui d'autre veut de la
      glace ?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318477
    m_Localized: <volume:0>...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318478
    m_Localized: "On dirait que vous avez d\xE9j\xE0 tout g\xE9r\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318479
    m_Localized: "Pourriez-vous baisser le volume, s'il vous pla\xEEt ?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318480
    m_Localized: <volume:1>Nous essayons de regarder.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318481
    m_Localized: "Oh,<pause:0.5> d\xE9sol\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318482
    m_Localized: Oh, allez !
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318483
    m_Localized: "H\xE9,<pause:0.5>, on n'avait pas fini de regarder !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318484
    m_Localized: <volume:0.5>Yarr!<pause:0.5> Qu'est-ce que vous croyez faire ici,
      les matelots ?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318485
    m_Localized: "Je t'avais dit d'envoyer Peg-Leg Joe, pas de rester ici \xE0 tra\xEEner
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318486
    m_Localized: "<emote:shake><volume:1>H\xE9,<pause:0.5><emote:shake> jeunes marins,<pause:0.5><emote:shake>
      Joe Jambe de Bois s'est cach\xE9 ici tout ce temps !<pause:0.5><emote:shake>
      Entrez ici,<pause:0.5><emote:shake> montrez-lui combien vous l'aimez !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318487
    m_Localized: "<volume:0.5>En avant, matelots,<pause:0.75> rapportez-moi tous
      les tr\xE9sors du monde !<pause:0.75> Hahahahaha !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318488
    m_Localized: "C'est Joe \xE0 la jambe de bois !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318489
    m_Localized: Courez vers lui !
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318490
    m_Localized: Oh non.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318491
    m_Localized: '*soupir* <pause:1> Accueil.'
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318492
    m_Localized: Hein?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318493
    m_Localized: Quoi...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318494
    m_Localized: Argent
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318495
    m_Localized: "Si tu sors sans chapeau, je le dis \xE0 maman"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318496
    m_Localized: NE LE FAITES PAS
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318497
    m_Localized: nouveau message
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318498
    m_Localized: Venez dans la cuisine
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318499
    m_Localized: Salut!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318500
    m_Localized: "Vous vous rendez compte que vous ne pouvez pas simplement entrer
      chez moi comme \xE7a ?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318501
    m_Localized: "Il \xE9tait d\xE9verrouill\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318502
    m_Localized: "Et pourquoi \xEAtes-vous assis ici dans le noir ?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318503
    m_Localized: J'ai envie de jouer.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318504
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318505
    m_Localized: "Oh,<pause:0.5>, ne fais pas comme si tu n'\xE9tais pas content
      de me voir."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318506
    m_Localized: Je suis.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318507
    m_Localized: "Alors.<pause:0.75> Pourquoi \xEAtes-vous ici ?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318508
    m_Localized: "Je ne peux pas passer voir mon petit fr\xE8re ?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318509
    m_Localized: Vous pouvez,<pause:0.75> mais vous ne le faites pas.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318510
    m_Localized: "Waouh. Tu me sous-estimes vraiment \xE0 ce point ?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318511
    m_Localized: D'accord,<pause:0.75> tu m'as eu.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318512
    m_Localized: "Je ne suis pas ici sans raison.<pause:0.75> J'ai une proposition
      \xE0 vous faire."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318513
    m_Localized: NON!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318514
    m_Localized: "Tu ne m'as m\xEAme pas \xE9cout\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318515
    m_Localized: NON !<pause:0.75> Je me retire du jeu !<pause:0.75> Je ne suis plus
      qu'un simple cuisinier maintenant, vous vous souvenez ?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318516
    m_Localized: "Vous servez de la glace dans un restaurant pour enfants.<pause:0.75>
      Vous n'\xEAtes pas cuisinier."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318517
    m_Localized: "Je m'entra\xEEne beaucoup \xE0 la maison !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318518
    m_Localized: Et je sais que tu es bon.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318519
    m_Localized: "Mais \xEAtre cuisinier n'est pas un passe-temps, c'est une profession."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674064318520
    m_Localized: Tu es venu ici juste pour m'insulter ?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512768
    m_Localized: "En fait, je suis venu pour vous aider avec \xE7a."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512769
    m_Localized: "Tout d'abord, \xE7a ne me pla\xEEt pas du tout. Et ensuite, tu
      ne connais rien \xE0 la cuisine."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512770
    m_Localized: "Peut-\xEAtre pas.<pause:0.75> Mais je comprends que vous vous y
      prenez mal pour atteindre votre objectif."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512771
    m_Localized: "Rouge,<pause:0.75> tu ne suis pas \xE0 la hauteur."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512772
    m_Localized: Pire encore, ce que vous traversez ne vous rapproche pas de votre
      objectif.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512773
    m_Localized: "Cela vous \xE9loigne encore plus."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512774
    m_Localized: Non, ce n'est pas le cas !
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512775
    m_Localized: "Regardez \xE7a !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512776
    m_Localized: Voir!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512777
    m_Localized: mon objectif
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512778
    m_Localized: "Tu vois ?<pause:0.5> J'y suis d\xE9j\xE0 \xE0 mi-chemin !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512779
    m_Localized: "Je ne me tra\xEEne pas \xE0 ce fichu boulot jour apr\xE8s jour
      pour rien !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512780
    m_Localized: Chaque mois, le pot se remplit de plus en plus !
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512781
    m_Localized: "Et quand j'aurai rempli cette caisse, j'ouvrirai un restaurant
      o\xF9 je servirai les meilleurs plats du coin !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512782
    m_Localized: "Et le personnel b\xE9n\xE9ficiera de pauses excessivement longues
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512783
    m_Localized: "Mais travailler l\xE0-bas sera tellement g\xE9nial que personne
      ne voudra m\xEAme les prendre !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512784
    m_Localized: "Et personne ne dira jamais que Red n'est pas une vraie cuisini\xE8re
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512785
    m_Localized: Personne!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512786
    m_Localized: "Oh, petit g\xE2teau grognon"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512787
    m_Localized: Je ne conteste pas que vous travailliez dur.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512788
    m_Localized: "C'est tout le contraire.<pause:0.5> Vous vous \xEAtes tellement
      plong\xE9 dans la cuisine que vous avez oubli\xE9 de garder les yeux ouverts."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512789
    m_Localized: "Rouge,<pause:0.5>, il y a combien de temps avez-vous fix\xE9 cet
      objectif\_?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512790
    m_Localized: Il y a un an et demi.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512791
    m_Localized: "Avez-vous constat\xE9 \xE0 quel point les prix ont augment\xE9
      depuis ?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512792
    m_Localized: Eh bien, les prix augmentent toujours un peu.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512793
    m_Localized: "Regarde combien co\xFBte maintenant le mat\xE9riel que tu aimais
      bien \xE0 l'\xE9poque."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512794
    m_Localized: "Allez, <pause:0.5>, \xE7a ne peut pas \xEAtre si terrible."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512795
    m_Localized: "Je suis s\xFBre qu'avec votre ent\xEAtement, vous pourriez d\xE9placer
      des montagnes."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512796
    m_Localized: "Mais si vous continuez comme \xE7a, vous vous \xE9loignerez encore
      plus de votre objectif."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512797
    m_Localized: "Les choses co\xFBtent plus cher que vous ne gagnez."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512798
    m_Localized: "Alors, que suis-je cens\xE9 faire ?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512799
    m_Localized: Agissez.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512800
    m_Localized: "Cela ne suffit toujours pas \xE0 couvrir l'ensemble de votre vision."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512801
    m_Localized: "Mais c'est un capital de d\xE9part correct pour quelque chose de
      plus modeste."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512802
    m_Localized: Par exemple,<pause:0.75> un petit restaurant dans une petite ville.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512803
    m_Localized: "J'ai d\xE9j\xE0 rep\xE9r\xE9 un endroit prometteur.<pause:0.75>
      Notre argent couvrirait l'acompte."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512804
    m_Localized: "Acompte\_?<pause:0.75> Un pr\xEAt semble assez<pause:0.5> risqu\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512805
    m_Localized: "Bien s\xFBr,<pause:0.75> mais vous savez comment \xE7a marche.<pause:0.75>
      Pas de risque, pas de r\xE9compense."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512806
    m_Localized: En fait, vous savez quoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512807
    m_Localized: Tu as raison!
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512808
    m_Localized: Au diable le restaurant de glaces !<pause:0.75> Au diable tous !
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512809
    m_Localized: Si je dois parler comme un pirate un seul jour de plus, je vais
      devenir fou !
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512810
    m_Localized: "Voil\xE0 l'esprit !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512811
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Et qu'est-ce
      que vous y gagnez\_?<pause:0.75> Pourquoi m'aider\_?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512812
    m_Localized: "Eh bien, tout d'abord, parce que je m'inqui\xE8te pour mon petit
      fr\xE8re."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512813
    m_Localized: "Qui se mettrait forc\xE9ment dans le p\xE9trin sans moi."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674068512814
    m_Localized: "Et deuxi\xE8mement, je veux une part."
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707072
    m_Localized: Je ne te crois pas !
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707073
    m_Localized: "On peut pratiquement gagner de l'argent \xE0 partir de rien !"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707074
    m_Localized: Pourquoi voudriez-vous avoir des parts dans un restaurant quelconque
      ?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707075
    m_Localized: Ah bon, tu croyais vraiment que je ne grandirais jamais ?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707076
    m_Localized: "Que je ne voudrais pas me poser ?<pause:0.75> Avoir une source
      de revenus l\xE9gitime ?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707077
    m_Localized: Tu me blesses.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707078
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707079
    m_Localized: "Quoi\_?<pause:0.75> Vous pensez vraiment que j'essaie de vous pi\xE9ger\_?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707080
    m_Localized: "Combien de fois ai-je essay\xE9 de te faire du mal ?<pause:0.75>
      T'ai vol\xE9 ?<pause:0.75> T'ai pi\xE9g\xE9 ?"
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707081
    m_Localized: Pas une seule fois.
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707082
    m_Localized: Alors qu'attendez-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707083
    m_Localized: Partenaires?
    m_Metadata:
      m_Items: []
  - m_Id: 39858674072707084
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Tr\xE8s
      bien,<pause:0.75> partenaires !"
    m_Metadata:
      m_Items: []
  - m_Id: 39890501168685056
    m_Localized: "Et leur incroyable aventure a commenc\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377408
    m_Localized: Cela suffit pour s'occuper de la plupart d'entre eux.
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377409
    m_Localized: "Ce gadget me montre combien de clients il me reste \xE0 satisfaire."
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377410
    m_Localized: "Oh l\xE0 l\xE0 ! Il y avait tellement d'enfants qu'ils ne pouvaient
      pas tous entrer."
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377411
    m_Localized: "Certains attendent qu'une place se lib\xE8re avant de pouvoir passer
      commande."
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377412
    m_Localized: Cet appareil indique qui est le prochain sur la liste.
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377413
    m_Localized: Parfois, gagner du temps est utile,<pause:0.5> mais n'allez pas
      trop loin.
    m_Metadata:
      m_Items: []
  - m_Id: 76863787903377414
    m_Localized: Les clients qui font la queue font aussi preuve de patience.
    m_Metadata:
      m_Items: []
  - m_Id: 76866541631725568
    m_Localized: "En g\xE9n\xE9ral, je n'ai pas \xE0 servir chaque client."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020216782848
    m_Localized: Waouh, quel voyage !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948672
    m_Localized: "Alors, o\xF9 en sommes-nous maintenant ?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948673
    m_Localized: Quelque part pas trop loin de Clifford.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948674
    m_Localized: Le signal est vraiment mauvais ici.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948675
    m_Localized: "Nous allons donc devoir improviser \xE0 partir de maintenant."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948676
    m_Localized: Prenez un autre bus<pause:0.5> ou demandez votre chemin aux habitants.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948677
    m_Localized: <volume:0>...
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948678
    m_Localized: "<volume:1>Bien que<pause:1> cela pourrait poser un petit probl\xE8me."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948679
    m_Localized: Sommes-nous perdus ?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948680
    m_Localized: Oh, ne sois pas si dramatique.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948681
    m_Localized: Au pire, on attendra ici le prochain bus et on rentrera.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948682
    m_Localized: Certainement pas!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948685
    m_Localized: Pour retrouver cette stupide petite ville.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948686
    m_Localized: "Et quand j'arriverai l\xE0-bas, je vais cuisiner une quantit\xE9
      incroyable de spaghettis !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948687
    m_Localized: "Et les habitants vont devoir tout manger jusqu'\xE0 la derni\xE8re
      miette !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948688
    m_Localized: Et ils vont adorer !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948689
    m_Localized: '!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948691
    m_Localized: Oh.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948692
    m_Localized: "Il est indiqu\xE9 que Clifford se trouve juste au bout de ce sentier."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948693
    m_Localized: Alors, qu'attendons-nous ?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948694
    m_Localized: Tremblez, habitants de Clifford !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948695
    m_Localized: Le rouge arrive !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948696
    m_Localized: "Et le grand et terrible Rouge n'a pas peur d'une for\xEAt aussi
      sinistre ?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948697
    m_Localized: Un peu.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948698
    m_Localized: Mais ce n'est pas aussi effrayant que de faire demi-tour !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948699
    m_Localized: "Je suis s\xFBr que ce n'est pas aussi grave que \xE7a en a l'air."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948700
    m_Localized: "Un dernier effort, et nous pourrons nous d\xE9tendre \xE0 Clifford
      apr\xE8s le voyage."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948701
    m_Localized: Et siroter des cocktails avec des petits parasols ?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948702
    m_Localized: Et siroter des cocktails avec des petits parasols.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948703
    m_Localized: Doux.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948704
    m_Localized: "Quand as-tu chang\xE9 de chapeau ?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948705
    m_Localized: "Quand notre road trip s'est transform\xE9 en randonn\xE9e, abruti."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948706
    m_Localized: Regarder.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948707
    m_Localized: "Je crois qu'on a r\xE9ussi."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948709
    m_Localized: Condamner.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948710
    m_Localized: "H\xE9, <pause:0.75>, vois le bon c\xF4t\xE9 des choses. Au moins,
      on n'est plus perdus !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948711
    m_Localized: "Et regardez \xE7a !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948712
    m_Localized: Un habitant du coin !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948713
    m_Localized: Salut.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948714
    m_Localized: AAAH !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948716
    m_Localized: "Nous sommes condamn\xE9s !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948718
    m_Localized: "Ne bouge pas, monstre de la for\xEAt !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948719
    m_Localized: Oui,<pause:0.5> certainement toi.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948720
    m_Localized: Silence, sale Clifforder !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948721
    m_Localized: "Vous nous avez d'abord apport\xE9 la maladie !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948723
    m_Localized: Nous ne laisserons pas cela se produire !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948724
    m_Localized: "Je pense qu'il y a eu un \xE9norme malentendu."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948725
    m_Localized: "Nous ne sommes pas de Clifford.<pause:0.5> Nous \xE9tions justement
      sur le point de partir."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020241948726
    m_Localized: "Tu ne t'en tireras pas aussi facilement apr\xE8s tout ce que tu
      as fait !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142976
    m_Localized: Oups !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142977
    m_Localized: "Tr\xE8s bien, <pause:0.5>, on y va. <pause:0.5> Rien \xE0 voir
      ici."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142978
    m_Localized: "Ces deux-l\xE0 viennent avec moi."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142979
    m_Localized: Mais ils viennent de Clifford !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142980
    m_Localized: "Leur origine ne vous regarde pas. Vous avez encore beaucoup de
      travail \xE0 faire aujourd'hui !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142981
    m_Localized: Vous tous!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142982
    m_Localized: Mais!..
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142983
    m_Localized: "Pas de mais !<pause:0.75> Personne ne t'a jet\xE9 un sort depuis
      longtemps ?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142984
    m_Localized: "Tch !<pause:0.5> Sorci\xE8re !<pause:0.5> Allez,<pause:0.5> la
      vieille sorci\xE8re s'est trouv\xE9 une nouvelle paire de jouets."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142985
    m_Localized: "QUI TRAITES-TU DE SORCI\xC8RE, ESP\xC8CE DE MALADE ?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142986
    m_Localized: "A\xEFe !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142987
    m_Localized: <volume:1>*soupir*<pause:0.75> Suivez-moi,<pause:0.5> avant qu'ils
      ne changent d'avis.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142988
    m_Localized: Ton appartement est tellement chaleureux !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142989
    m_Localized: "Qu'est-ce que c'est que tout \xE7a sur les \xE9tag\xE8res ?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142990
    m_Localized: "Ne touchez pas aux antiquit\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142991
    m_Localized: "Je n'avais pas pr\xE9vu de le faire."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142992
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142993
    m_Localized: "Merci de nous avoir d\xE9fendus."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142994
    m_Localized: "Ouais, <pause:0.5>, sans toi, ils nous auraient d\xE9vor\xE9s vivants."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142995
    m_Localized: "*soupir*<pause:0.5> Ils n'auraient mang\xE9 personne,<pause:0.5>
      ce ne sont pas des monstres."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142996
    m_Localized: "Ils sont \xE0 cran."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142997
    m_Localized: "Le plus probable, c'est qu'ils vous auraient simplement chass\xE9
      de Riverside."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142998
    m_Localized: "Au pire, ils vous auraient cri\xE9 quelques insultes."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246142999
    m_Localized: En fait, cela nous convient.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143000
    m_Localized: "De toute fa\xE7on, nous n'\xE9tions que de passage. Nous n'avions
      pas l'intention de nous attarder dans ce trou perdu..."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143001
    m_Localized: Quelle honte.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143002
    m_Localized: "Nous serions vraiment d\xE9sol\xE9s de quitter un si bel endroit
      aussi pr\xE9cipitamment."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143004
    m_Localized: "Tu ferais mieux d'\xE9couter tes a\xEEn\xE9s, toi, l'orange. Les
      gens y attachent de l'importance par ici."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143005
    m_Localized: "Et vous ne devriez pas \xEAtre aussi press\xE9 de toute fa\xE7on.
      Le chemin \xE0 parcourir est encore plus difficile que celui qui vous a amen\xE9
      ici."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143006
    m_Localized: Ai-je bien compris que vous vous dirigez vers Clifford ?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143007
    m_Localized: Oui, madame !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143008
    m_Localized: "Choix \xE9trange, mais \xE7a vous regarde."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143009
    m_Localized: "Notre cheval de trait est d\xE9j\xE0 parti chercher des m\xE9dicaments
      pour Clifford. Il ne sera de retour que tard ce soir."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143010
    m_Localized: "Le prochain d\xE9placement en ville est pr\xE9vu demain matin."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143011
    m_Localized: "Alors, en attendant, il vaut mieux rester o\xF9 on est et se faire
      discret ?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143013
    m_Localized: "Parfait !<pause:0.75> Alors nous resterons tranquilles ici et nous
      ne g\xEAnerons personne."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143014
    m_Localized: Petit renard malin.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143015
    m_Localized: "Ils attendent des m\xE9dicaments de la ville. Sont-ils malades
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143016
    m_Localized: "Ouais.<pause:0.75> Ces \xE9tourdis ont attrap\xE9 une sorte de
      maladie, et maintenant la moiti\xE9 du village est touch\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143017
    m_Localized: "Voil\xE0 pourquoi ils ont si peur."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143018
    m_Localized: "Ils pensent qu'il s'agit d'un esprit mal\xE9fique, ou que les habitants
      de Clifford en sont responsables."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143019
    m_Localized: Ou les deux.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143020
    m_Localized: En fait, nous pourrions vous aider.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143021
    m_Localized: "Rouge,<pause:0.5> tu as beaucoup de talents,<pause:0.5> mais tu
      n'es pas m\xE9decin."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143022
    m_Localized: Et puis, nous ne sommes pas vraiment les bienvenus ici.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143023
    m_Localized: Non, non, le gris.<pause:0.5> Laissez-le finir.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143024
    m_Localized: Alors, que proposes-tu exactement, toi, l'orange ?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143025
    m_Localized: Tu as toutes sortes d'herbes ici,<pause:0.5> et j'ai tout un tas
      d'ustensiles de cuisine avec moi !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143026
    m_Localized: "Et je connais la recette d'une bonne sant\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143027
    m_Localized: "Nous pouvons pr\xE9parer la soupe au poulet la plus savoureuse
      et la plus bienfaisante que ce village ait jamais connue !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143028
    m_Localized: "C'est...<pause:1> en fait une plut\xF4t bonne id\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143029
    m_Localized: "Un bon bol de soupe devrait vraiment les aider \xE0 se sentir mieux."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143030
    m_Localized: Je vais voir si je peux convaincre les habitants de vous supporter
      encore un peu.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143031
    m_Localized: "Eh bien, puisque nous sommes d\xE9j\xE0 impliqu\xE9s, je peux aider
      avec les herbes."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143032
    m_Localized: Connaissez-vous quelque chose aux herbes aromatiques ?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143033
    m_Localized: "Notre m\xE8re est passionn\xE9e par l'art floral, alors elle m'a
      appris deux ou trois choses."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143034
    m_Localized: "Je ne sais pas \xE0 quoi elles servent en m\xE9decine, mais je
      sais comment les r\xE9colter."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143035
    m_Localized: "Et je peux suivre les instructions sans g\xEAner."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143036
    m_Localized: "\xC7a suffira."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143037
    m_Localized: "Et puisque nous travaillons ensemble maintenant, et que je ne pourrai
      plus vous ignorer, nous devrions nous pr\xE9senter."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143038
    m_Localized: "Ad\xE8le."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143039
    m_Localized: Argent.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143040
    m_Localized: Rouge.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143041
    m_Localized: "Quelle originalit\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143042
    m_Localized: "Oh,<pause:0.5> croyez-moi,<pause:0.5> \xE7a aurait pu \xEAtre bien
      pire."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143043
    m_Localized: "Ca c'\xE9tait quoi?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143044
    m_Localized: Ne t'en fais pas.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143045
    m_Localized: "Allez, Rouge et Argent,<pause:0.5>, nous avons encore beaucoup
      de travail \xE0 faire."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143046
    m_Localized: "Tr\xE8s bien, tous nos ingr\xE9dients et herbes sont \xE0 votre
      disposition."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143047
    m_Localized: "Ne me fais pas regretter \xE7a, l'orange."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143048
    m_Localized: "Je g\xE8re."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143049
    m_Localized: "Pr\xE9parer une soupe m\xE9dicinale ne doit pas \xEAtre beaucoup
      plus difficile que de cuisiner des plats ordinaires."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143050
    m_Localized: "J'esp\xE8re sinc\xE8rement que vous avez raison."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143051
    m_Localized: "Je vais leur donner une telle racl\xE9e \xE0 ces microbes,<pause:0.5>
      ils ne sauront pas ce qui leur est arriv\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143052
    m_Localized: "H\xE9, ce n'est pas si difficile."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143053
    m_Localized: "Ne te r\xE9jouis pas trop vite, toi, l'orange."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143054
    m_Localized: "Tous ceux qui sont venus vous voir jusqu'\xE0 pr\xE9sent ne sont
      pas encore vraiment malades."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143055
    m_Localized: "Ils ne se sentent pas tr\xE8s bien."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143056
    m_Localized: "Je vous ai amen\xE9 votre premier vrai patient."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143057
    m_Localized: Envoyez-les.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143058
    m_Localized: Je ne mangerai pas le poison de Leshy !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143059
    m_Localized: Je ne suis pas Leshy.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143060
    m_Localized: "Et je ne l'\xE9coute pas non plus !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143061
    m_Localized: '*soupir*<pause:0.75> Tu le feras si tu veux aller mieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143062
    m_Localized: Alors je choisis de rester malade !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143063
    m_Localized: "Non,<pause:0.5> tu choisis de t'am\xE9liorer, esp\xE8ce d'ingrat<pause:0.5>."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143064
    m_Localized: Et ce n'est pas une demande.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143065
    m_Localized: Bien. Alors ferme-la.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143066
    m_Localized: "N'accordez aucune importance aux inepties que raconte cet imb\xE9cile."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143067
    m_Localized: "Il a une forte fi\xE8vre depuis hier."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143068
    m_Localized: "Et sa maladie g\xE2che la vie de tous ceux qui l'entourent."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143069
    m_Localized: "Quiconque est assis \xE0 c\xF4t\xE9 de lui sera plus difficile
      \xE0 gu\xE9rir."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143070
    m_Localized: Montre-moi ce que tu sais faire, toi l'orange.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143071
    m_Localized: Waouh !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143072
    m_Localized: "Les clients malades sont vraiment p\xE9nibles \xE0 g\xE9rer."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143073
    m_Localized: "Mince alors,<pause:0.5> ce n'\xE9tait pas facile."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143074
    m_Localized: Je te l'avais dit.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143075
    m_Localized: "Mais la fi\xE8vre est l'une des maladies les plus faciles \xE0
      traiter."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143076
    m_Localized: "Le m\xE9lange de champignons contient des baies de sorbier. Elles
      devraient l'aider \xE0 se sentir mieux."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143077
    m_Localized: Essayez.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143078
    m_Localized: "Bon,<pause:0.5> je crois<pause:0.5> que je commence \xE0 comprendre."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143079
    m_Localized: "Bien, <pause:0.5>, car je n'ai pas l'intention de te materner toute
      la journ\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143080
    m_Localized: Appelle-moi si quelque chose ne va pas.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143081
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Non, c'est
      tout simplement ridicule !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143082
    m_Localized: Je ne peux pas travailler dans ces conditions.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143083
    m_Localized: "Ce patient est la mule la plus t\xEAtue du monde !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143084
    m_Localized: C'est tout simplement impossible !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143085
    m_Localized: "Parfois, je me dis qu'il demande tout sauf ce dont il a r\xE9ellement
      besoin, juste pour faire des difficult\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143086
    m_Localized: "Ad\xE8le,<pause:0.5> J'ai besoin que tu lui cries dessus."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143087
    m_Localized: "Ad\xE8le,<pause:0.5> J'ai besoin que tu lui cries dessus."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143088
    m_Localized: Je veux que tu le frappes.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143089
    m_Localized: "\xC9coute-moi bien, toi, l'orange."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143090
    m_Localized: Vasya est un adversaire coriace,<pause:0.5> il n'est pas facile.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143091
    m_Localized: "Mais ton fr\xE8re et moi avons d\xE9j\xE0 fort \xE0 faire."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143092
    m_Localized: Nous n'irons pas bien loin si je dois vous aider avec chaque patient
      difficile.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143093
    m_Localized: "J'ai mon propre travail,<pause:0.5> et vous avez le v\xF4tre."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143094
    m_Localized: Alors allez-y et occupez-vous-en.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143095
    m_Localized: "H\xE9,<pause:0.5>, c'est moi qui sauve ton village d'une \xE9pid\xE9mie
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143096
    m_Localized: J'aurais pu faire exactement ce que vous m'avez dit !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143097
    m_Localized: "Restez tranquillement assis dans un coin,<pause:0.5> pendant que
      les habitants attendent des m\xE9dicaments de la ville et ne cessent de tomber
      malades !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143098
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> D'accord,
      d'accord,<pause:0.5> tu as raison,<pause:0.5> Je suis d\xE9sol\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143099
    m_Localized: Mais je ne peux vraiment pas laisser tomber mon travail et faire
      des allers-retours incessants.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020246143100
    m_Localized: "Alors dites-moi comment je suis cens\xE9e le contacter autrement."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337280
    m_Localized: "Qu'est-ce que cette vieille \xE9pave ?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337281
    m_Localized: Ceci est un four.<pause:0.5> Vous savez comment utiliser un de ces
      appareils, n'est-ce pas ?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337282
    m_Localized: "Oui, je le fais,<pause:0.5> mais en quoi cela est-il cens\xE9 aider
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337283
    m_Localized: "Elle poss\xE8de le don de persuasion."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337284
    m_Localized: "Si quelqu'un go\xFBte ses p\xE2tisseries, il changera imm\xE9diatement
      d'avis, quel que soit le sujet de la dispute."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337285
    m_Localized: Quoi?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337286
    m_Localized: "Si tu voulais juste te d\xE9barrasser de moi, tu aurais pu le dire."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337287
    m_Localized: "Je vous promets que \xE7a marchera.<pause:0.5> Maintenant, allez-y,<pause:0.5>
      vos patients vous attendent."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337288
    m_Localized: "J'esp\xE8re que ce n'est pas une mauvaise blague."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337289
    m_Localized: Il recommence.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337290
    m_Localized: "Tr\xE8s bien, cette fois-ci je vais lui donner un bretzel."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337291
    m_Localized: Et comme par magie, il changera d'avis.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337292
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> \xC7a
      sonnait tellement idiot."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337293
    m_Localized: "Eh bien, je suis damn\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337294
    m_Localized: "\xC7a marche vraiment !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337295
    m_Localized: Waouh.<pause:0.5> Ce cochon est vraiment impatient.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337296
    m_Localized: "Pour le servir \xE0 temps, il va falloir que j'allume le four."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337297
    m_Localized: Oui,<pause:0.5> cela devrait fonctionner.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337298
    m_Localized: Avec ce four, je n'ai peur de personne !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337299
    m_Localized: "Je suis inarr\xEAtable !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337300
    m_Localized: "Mais qu'est-ce que c'est que \xE7a ?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337301
    m_Localized: "Bon, peu importe tout ce bruit, ce n'est pas mon probl\xE8me."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337302
    m_Localized: Surtout pendant mes pauses.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337303
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Maintenant.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337304
    m_Localized: "Pensez-vous que cela puisse constituer un rem\xE8de ?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337305
    m_Localized: Probablement pas.<pause:0.5> C'est juste une soupe aux herbes.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337306
    m_Localized: "Oui, <pause:0.5> mais alors, qu'est-ce qui peut bien \xEAtre consid\xE9r\xE9
      comme un rem\xE8de si ce n'est une soupe aux herbes ?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337307
    m_Localized: "Hmm,<pause:0.5> c'est<pause:0.75> une observation tr\xE8s int\xE9ressante."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337308
    m_Localized: "L'apprenti pr\xE9parateur de potions a surpass\xE9 son ma\xEEtre
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337309
    m_Localized: Se concentrer!
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337310
    m_Localized: "Oh, allez,<pause:0.5> c'\xE9tait dr\xF4le !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337311
    m_Localized: La cuisine n'est pas un endroit pour plaisanter !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337312
    m_Localized: "Voici notre atelier, et nous y cr\xE9ons de belles choses !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337313
    m_Localized: "<volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> C'\xE9tait
      quand m\xEAme dr\xF4le."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337314
    m_Localized: "Tr\xE8s bien,<pause:0.5> c'\xE9tait un peu dr\xF4le."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337315
    m_Localized: Une petite victoire !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337316
    m_Localized: Quel vaurien !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337317
    m_Localized: "Vous avez entendu \xE7a ?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337318
    m_Localized: "Ce n'est pas un m\xE9dicament contre les maladies,<pause:0.5> c'est
      juste une soupe ordinaire !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337319
    m_Localized: "Eh bien, je ne sais pas, Vasya.<pause:0.5> Je me sens en fait mieux
      apr\xE8s avoir bu sa boisson."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337320
    m_Localized: "Et c'est la soupe la plus savoureuse que j'aie jamais mang\xE9e
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337321
    m_Localized: Profitez-en tant que vous le pouvez.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337322
    m_Localized: "Il est \xE9vident qu'il nous engraisse pour que nous ayons meilleur
      go\xFBt nous-m\xEAmes."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337323
    m_Localized: "Avez-vous compl\xE8tement perdu la t\xEAte ?"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337324
    m_Localized: Vous allez vraiment accuser Leshy de quelque chose maintenant ?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337325
    m_Localized: "On aurait vir\xE9 ce Leshy nous-m\xEAmes si ce n'\xE9tait pas pour
      cette satan\xE9e sorci\xE8re !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337326
    m_Localized: Je ne suis pas Le...
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337327
    m_Localized: Attendez, ai-je bien entendu quelqu'un manquer de respect au grand
      Leshy ?
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337328
    m_Localized: "Ce n'\xE9tait pas moi !<pause:0.5> C'\xE9tait enti\xE8rement lui
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337329
    m_Localized: Moi ?!<pause:0.5> Je n'ai rien fait !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337330
    m_Localized: "H\xE9h\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337331
    m_Localized: '*soupir*'
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337332
    m_Localized: "Il s'est lib\xE9r\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337333
    m_Localized: Sauvez-vous tous !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337334
    m_Localized: Sauvez-vous !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337335
    m_Localized: "Oh, c'est merveilleux ! Nous avons des invit\xE9s, et vous avez
      tous organis\xE9 un si joli petit pique-nique !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337336
    m_Localized: "Et personne ne m'a invit\xE9. Bande de coquins !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337337
    m_Localized: Boris, rentre chez toi maintenant !
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337338
    m_Localized: Nous vous apporterons votre repas.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337339
    m_Localized: "Retourner \xE0 l'int\xE9rieur ?<pause:0.5> Oh, pas question !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337340
    m_Localized: "Je ne raterai pas tous les bons moments pass\xE9s avec nos nouveaux
      amis \xE0 quatre pattes !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337341
    m_Localized: "Boris,<pause:0.5> Je t'en supplie,<pause:0.5> tu vas tout d\xE9molir
      ici."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337342
    m_Localized: "Ne sois pas si dramatique, Adele.<pause:0.5> Je n'\xE9ternue pas
      aussi fort."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337343
    m_Localized: "Je vais juste rester assis ici avec vous.<pause:0.5> Je ne d\xE9rangerai
      personne !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337344
    m_Localized: "Nous recevons si rarement des visiteurs !<pause:0.5> Je ne peux
      absolument pas rater \xE7a !"
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337345
    m_Localized: "\xC9coute bien, Rouge."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337346
    m_Localized: "Faites tout ce qu'il faut,<pause:0.5> mais ne le laissez pas \xE9ternuer."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337347
    m_Localized: "S'il en fait trop, nous devrons reconstruire cet endroit \xE0 partir
      de ruines."
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337348
    m_Localized: Je ne te laisserai pas tomber.
    m_Metadata:
      m_Items: []
  - m_Id: 95020020250337349
    m_Localized: Le serment de l'hippopotame.
    m_Metadata:
      m_Items: []
  - m_Id: 95027885946068992
    m_Localized: "H\xE9, o\xF9 vas-tu ?"
    m_Metadata:
      m_Items: []
  - m_Id: 95028971859763200
    m_Localized: "Je veux dire, o\xF9 allez-vous ?<pause:0.75> Vous venez de passer
      juste devant un panneau."
    m_Metadata:
      m_Items: []
  - m_Id: 95032048352387072
    m_Localized: Nous n'avons pas fait tout ce chemin pour abandonner maintenant
      !
    m_Metadata:
      m_Items: []
  - m_Id: 95060151254540288
    m_Localized: Non, ce n'est pas Clifford. Ici, c'est Riverside. Vous voyez ?
    m_Metadata:
      m_Items: []
  - m_Id: 95060151283900416
    m_Localized: "Ce satan\xE9 Clifforder a amen\xE9 Leshy dans notre village !"
    m_Metadata:
      m_Items: []
  - m_Id: 95060151283900417
    m_Localized: Moi ? Leshy ?
    m_Metadata:
      m_Items: []
  - m_Id: 95060151283900418
    m_Localized: "Et maintenant, vous avez d\xE9cid\xE9 de l\xE2cher Leshy sur nous
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 95336547382091776
    m_Localized: "Surtout apr\xE8s avoir involontairement froiss\xE9 les habitants."
    m_Metadata:
      m_Items: []
  - m_Id: 95336547411451904
    m_Localized: "Exactement.<pause:0.5> \xC0 moins que le mal\xE9fique Leshy et
      l'immonde Clifforder ne veuillent pousser encore plus loin la patience des
      habitants."
    m_Metadata:
      m_Items: []
  - m_Id: 95703245004103680
    m_Localized: "Ohhh,<pause:0.5> merci \xE0 tous."
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463808
    m_Localized: "Je ne me suis pas autant amus\xE9 depuis longtemps !"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463809
    m_Localized: "Ces derniers jours, tout le monde \xE9tait tellement occup\xE9
      et inquiet que j'avais presque oubli\xE9 ce que \xE7a faisait."
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463810
    m_Localized: "Et maintenant, nous sommes tous de nouveau assis \xE0 la m\xEAme
      table !"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463811
    m_Localized: "Partager de d\xE9licieux plats et des histoires !"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463812
    m_Localized: "Et regardez-moi !<pause:0.5> Je sens d\xE9j\xE0 que je vais beaucoup
      mieux !"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463813
    m_Localized: Nous tous !
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463814
    m_Localized: "Tout cela, c'est gr\xE2ce \xE0 vous !"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463816
    m_Localized: Hourra pour Leshy le docteur !
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463817
    m_Localized: "Allez, Vasya,<pause:0.5> tu sais ce que tu es cens\xE9e dire !"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463819
    m_Localized: "Et maintenant, venez ici, je vais vous faire un c\xE2lin !"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463820
    m_Localized: Boris, que fais-tu ?!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463821
    m_Localized: "M\xEAme si Leshy a \xE9t\xE9 tr\xE8s gentil aujourd'hui, il reste
      un monstre de la for\xEAt !"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463822
    m_Localized: Il va te manger !
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463824
    m_Localized: "Il a aid\xE9 mes amis, et je vais le serrer dans mes bras quoi
      qu'il arrive !"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463825
    m_Localized: Boris,<pause:0.5> soyez raisonnable,<pause:0.5> ne le faites pas.
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463826
    m_Localized: "Se sentir mieux ne signifie pas que vous \xEAtes compl\xE8tement
      r\xE9tabli."
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463827
    m_Localized: "Oh, arr\xEAte de faire ton cin\xE9ma, esp\xE8ce de peureux !"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463828
    m_Localized: Je viens!
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463829
    m_Localized: Attendez une seconde !<pause:0.5> Donc il n'est pas Leshy du tout
      !
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463830
    m_Localized: C'est juste un petit renard grognon !
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463831
    m_Localized: Oh mon Dieu !
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463832
    m_Localized: "Pourquoi ne m'as-tu pas dit que tu n'\xE9tais pas Leshy ?"
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463834
    m_Localized: "J'esp\xE8re que tu es fier de toi."
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463835
    m_Localized: "Bien s\xFBr."
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463836
    m_Localized: Assez de chamailleries, petits renards.
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463837
    m_Localized: Allez, discutons de ce que nous allons faire avec vous ensuite.
    m_Metadata:
      m_Items: []
  - m_Id: 95703245033463838
    m_Localized: Oh...
    m_Metadata:
      m_Items: []
  - m_Id: 95707377475674112
    m_Localized: <volume:1> Hourra.
    m_Metadata:
      m_Items: []
  - m_Id: 95708385291427840
    m_Localized: Hourra pour tante Adele,<pause:0.5> le Clifforder et le Leshy !
    m_Metadata:
      m_Items: []
  - m_Id: 95711446944604160
    m_Localized: "Je m'en fiche, m\xEAme s'il \xE9tait le diable en personne !"
    m_Metadata:
      m_Items: []
  - m_Id: 95711446944604161
    m_Localized: <volume:0>.<pause:0.5>.<pause:0.5>.<pause:0.5><volume:1> Je vais
      exploser d'indignation.
    m_Metadata:
      m_Items: []
  - m_Id: 95712882495479808
    m_Localized: Clifford
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
